{
  "@context": {
    "@version": 1.1,

    "hector": "https://w3id.org/hector/ontology#",
    "hectorid": "https://w3id.org/hector/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "aat": "http://vocab.getty.edu/aat/",
    "wd": "http://www.wikidata.org/entity/",
    "geonames": "https://sws.geonames.org/",
    "qudtunit": "http://qudt.org/vocab/unit/",
    "quantitykind": "http://qudt.org/vocab/quantitykind/",

    "exactMatch": { "@id": "skos:exactMatch", "@type": "@id", "@container": "@set" },
    "closeMatch": { "@id": "skos:closeMatch", "@type": "@id", "@container": "@set" },

    "illustrative": { "@id": "hector:illustrative", "@type": "xsd:boolean" },
    "phoneticKey": { "@id": "hector:phoneticKey", "@container": "@set" },
    "historicalTerm": { "@id": "hector:historicalTerm", "@container": "@set" },
    "originPlace": { "@id": "hector:originPlace", "@type": "@id", "@container": "@set" },
    "compoundOf": { "@id": "hector:compoundOf", "@type": "@id", "@container": "@set" },

    "quantityKind": { "@id": "hector:quantityKind", "@type": "@id" },
    "conversionToGram": { "@id": "hector:conversionToGram", "@type": "xsd:decimal" },

    "Rate": "hector:Rate",
    "taxation": { "@id": "hector:taxation", "@type": "@id", "@container": "@set" },
    "amount": { "@id": "hector:amount", "@type": "@id" },
    "perQuantity": { "@id": "hector:perQuantity", "@type": "@id" },
    "valueInPence": { "@id": "hector:valueInPence", "@type": "xsd:decimal" },
    "lsd": { "@id": "hector:lsd" },
    "validFrom": { "@id": "hector:validFrom", "@type": "xsd:gYear" },
    "validThrough": { "@id": "hector:validThrough", "@type": "xsd:gYear" },
    "source": { "@id": "hector:source", "@type": "@id", "@container": "@set" },
    "sourceText": { "@id": "hector:sourceText" }
  }
}
