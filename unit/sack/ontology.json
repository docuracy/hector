  "_label": "sack",
  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "sack (Latin saccus): a sack used as a packing unit and measure. The standard sack of English wool weighed 364 lb.; also used as a measure of flax and other dry goods. See also sackette (a small sack), poke, pack, bale."
    },
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300418049",
          "type": "Type",
          "_label": "brief texts"
        }
      ],
      "content": "conversionToGram follows the definitions given under definedAs down to the pound avoirdupois at its 1959 international value (453.59237 g). It is a modern reference value, not a measured historical standard."
    }
  ],
