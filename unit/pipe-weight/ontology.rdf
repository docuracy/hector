  <rdf:Description rdf:nodeID="unit_pipe_weight_cb5d2a0dafc90191274aa7fd71b265c75776ca58c095643fb85e6eaacccdd7b49c">
    <crm:P190_has_symbolic_content>a pipe as a unit of weight, equivalent to half a dolium ponderis (10 cwt, i.e. ½ tun), here used especially for iron (Zupko 416-9).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
