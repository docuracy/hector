  "id": "https://w3id.org/hector/unit/pipe-weight",
  "type": "MeasurementUnit",
  "_label": "pipe (weight)",
  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "a pipe as a unit of weight, equivalent to half a dolium ponderis (10 cwt, i.e. ½ tun), here used especially for iron (Zupko 416-9)."
    },
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300418049",
          "type": "Type",
          "_label": "brief texts"
        }
      ],
      "content": "conversionToGram follows the definitions given under definedAs down to the pound avoirdupois at its 1959 international value (453.59237 g). It is a modern reference value, not a measured historical standard."
    }
  ],
