  <rdf:Description rdf:nodeID="unit_puncheon_cb7ae23bf6855ca7e38ce0974fac3f2680870ae19bf650237113104add47dcbe2f">
    <crm:P190_has_symbolic_content>a large cask for liquids, fish etc., specifically one of a definite capacity (wine = 1 hogshead or 1/4 tun), here used as a packing unit for dry or liquid goods (OED s.v. puncheon2; MED s.v. punchoun n.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
