<https://w3id.org/hector/unit/fathom> a crm:E58_Measurement_Unit ;
    rdfs:label "fathom" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "fathome" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "faθomə" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "fathom" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "faθom" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "fathom, the length covered by the outstreched arms (6 ft.); of wood: a 6 ft. by 6 ft. stack; but used here as a measure of furs (OED s.v. fathom 3b)" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/fathom>,
        <https://w3id.org/mlca/glossary/fathom> ;
    skos:broader aat:300386648 ;
    hector:attestationCount 1 ;
    hector:definedAs [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (fathom: '6 ft.')" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 6 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/foot> ] ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/length> .

