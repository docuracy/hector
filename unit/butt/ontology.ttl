    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "but, a cask for wine, liquid measure (equivalent to 2 hogsheads) | but as a measure of thread (filum) | but, a cask for wine, liquid measure (equivalent to 2 hogsheads), especially for alien sweet wine, here of Malmsey | a cask for wine, liquid measure (equivalent to 2 hogsheads), especially for alien sweet wine | but, a cask for wine, liquid measure (equivalent to 2 hogsheads), especially for alien sweet wine | but, a cask for wine, liquid measure (equivalent to 2 hogsheads), especially for alien sweet wine, here of malmsey | a cask for wine, liquid measure (equivalent to 2 hogsheads), especially for alien sweet wine, here of Malmsey | half butt as a packing unit for liquid goods (not wine) | but, a cask for wine (equivalent to 2 hogsheads), also for raisins | but, cask as a measure of sweet wine, equivalent to ½ dolium | but, a cask for wine (equivalent to 2 hogsheads), esp. for alien sweet wine, but also for raisins, alum, iron, coprose | but, a cask for wine, liquid measure (equivalent to 2 hogsheads), esp. for alien sweet wine | but, as a packing unit for dry goods of no particular size | a packing unit for liquid goods, not wine | (but, -es) but, as a packing unit for dry goods of no particular size | as a unit of capacity for Romney, a sweet Mediterranean wine | but, a cask for wine, liquid measure (equivalent to 2 hogsheads), especially for alien sweet wine, here of Malvesey | but, a cask for wine, liquid measure (equivalent to 2 hogsheads), especially for alien sweet wine, here of Romney | a packing unit for liquid goods, here wine | as a packing unit for dry goods | as a packing unit for liquid goods, here oil | as a packing unit for dry goods, here dates, lemons, raisins | as a packing unit for dry goods of no particular size | as a measure of thread (filum) | of galles | of woad de insula de Surr’ (q.v.) | a packing unit for letwis, containing 5 timber (of 40 furs/timber) | but, cask, as a packing unit for dry goods of no particular size | but, cask, as a measure of wine | a packing unit for dry goods of no particular size | a packing unit (measure?) of alum | but as an article of commerce, but meaning of cassis in this context is unknown | as a packing unit for liquid goods, not wine | as a packing unit (measure?) of thread | but, a packing unit for dry goods of no particular size | but as a packing unit for dry goods, here of raisins | as a packing unit for liquid goods | a cask for wine (OED s.v. butt n.3 1a) (equivalent to 2 hogsheads or ½ tun) | but, a cask, as a packing unit for dry goods of no particular size | as a packing unit of currants" ;
            crm:P2_has_type aat:300435416 ] ;
