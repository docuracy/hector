  <rdf:Description rdf:nodeID="unit_quartellus_2_cb5191e9d35ee55090f11fef19800489d48e6b0c64be53d63cfc7cdb32699e0aad">
    <crm:P190_has_symbolic_content>a small tun (Day 978), a measuring-vessel that contains a quarter of standard measure. The quotes indicate that a quartellus is equivalent to a fourth of a sester or two fifths of a butte (Latham, Dictionary, s.v. quartellus, sextarius)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
