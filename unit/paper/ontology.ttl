    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a paper: a quire or packet of paper used as a unit of measure or packing for small wares — buckram, silk (raw, caul, Cologne, Messina), points, pins, laces, thread, corses, combs, laune, sarcenet, and gold thread (OED s.v. paper n. 6b)." ;
            crm:P2_has_type aat:300435416 ] ;
