<https://w3id.org/hector/unit/glass> a crm:E58_Measurement_Unit ;
    rdfs:label "glass" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "glass" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "glas" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "glacys" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "glasis" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "glas" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "glas" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A glass used as a packing unit / measure, especially for rose-water (also reckoned by the dozen, gross or thousand)." ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/glass-measure>,
        <https://w3id.org/mlca/glossary/glass%20%28measure%29> ;
    skos:broader aat:300386648 ;
    hector:attestationCount 3 ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/package> .

