  <rdf:Description rdf:nodeID="unit_quarter_cbefeaa32752ec7d8e1ed75bec12ac566b26f5440fb5203a8ce547151ec0c68d17">
    <crm:P190_has_symbolic_content>Source: LCA glossary (quarter: '8 bushels')</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300418049"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="unit_quarter_cb0">
    <crm:P190_has_symbolic_content>quarter, a measure of capacity (8 bushels) for grain, flax, almonds (Zupko 337-40); also a generic packing unit, usually shorthand for a quarter of something (25 lb., 25 pieces etc.), used for wax, figs, lynges, fish, ginger, hemp seed, mustard seed, raisins, apples, nuts, garlic, walnuts, oranges, fructus.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
