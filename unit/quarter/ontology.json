      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "quarter, a measure of capacity (8 bushels) for grain, flax, almonds (Zupko 337-40); also a generic packing unit, usually shorthand for a quarter of something (25 lb., 25 pieces etc.), used for wax, figs, lynges, fish, ginger, hemp seed, mustard seed, raisins, apples, nuts, garlic, walnuts, oranges, fructus."
    }
  ],
