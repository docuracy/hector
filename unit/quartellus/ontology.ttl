<https://w3id.org/hector/unit/quartellus> a crm:E58_Measurement_Unit ;
    rdfs:label "quartellus" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "quartellus" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "kwartelus" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "quartelli" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kwarteli" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a measure of sweet wine (equivalent to ½ bota or 1/6 tun)" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/quartellus>,
        <https://w3id.org/mlca/glossary/quartellus> ;
    la:equivalent aat:300386648 ;
    hector:attestationCount 2 ;
    hector:definedAs [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (quartellus: '½ bota or 1/6 tun'). Note: of sweet wine" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 1.666667e-01 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/tun> ] ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/volume> .

