  <rdf:Description rdf:nodeID="unit_mark_2_cb459c9246e04ca73371ff397afe826f680de8663f0b2762fed1232fc7d0a60041">
    <crm:P190_has_symbolic_content>conversionToGram follows the definitions given under definedAs down to the pound avoirdupois at its 1959 international value (453.59237 g). It is a modern reference value, not a measured historical standard.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300418049"/>
