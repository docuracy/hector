<https://w3id.org/hector/unit/mark-2> a crm:E58_Measurement_Unit ;
    rdfs:label "mark" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mark" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "mark" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "marc" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "mark" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "conversionToGram follows the definitions given under definedAs down to the pound avoirdupois at its 1959 international value (453.59237 g). It is a modern reference value, not a measured historical standard." ;
            crm:P2_has_type aat:300418049 ],
        [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a unit of weight equivalent to two-thirds of a pound, used for gold and silver thread and iron wire (OED mark n.2)" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/mark-2>,
        <https://w3id.org/mlca/glossary/mark_2> ;
    skos:broader aat:300386648 ;
    hector:attestationCount 12 ;
    hector:conversionToGram 302.3949133485 ;
    hector:definedAs [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (mark: 'two-thirds of a pound'). Note: which pound is not stated" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 6.666667e-01 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/pound> ] ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/mass> .

