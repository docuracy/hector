<https://w3id.org/hector/unit/lucepond> a crm:E58_Measurement_Unit ;
    rdfs:label "lucepond" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lyslb" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "lislb" ;
            hector:validFrom "1428"^^xsd:gYear ;
            hector:validThrough "1430"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lucepond" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "lusepond" ;
            hector:validFrom "1380"^^xsd:gYear ;
            hector:validThrough "1385"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Liespfund, a Baltic-Hanseatic unit of weight (6.846 kg or 15 lb.), equivalent to 1/20 of a schippond (Wolf 43), here as a measure of wax | . Liespfund, a Baltic-Hanseatic unit of weight, approximately 6.8 kg, one twentieth of a shipplb." ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/lucepond>,
        <https://w3id.org/mlca/glossary/lucepond> ;
    skos:broader aat:300386648 ;
    hector:attestationCount 2 ;
    hector:definedAs [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (lucepond: '1/20 of a schippond', Wolf 43). One of 2 readings the sources give for this unit; none is preferred" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 5e-02 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/schippond> ],
        [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (lucepond: '6.846 kg or 15 lb.'). Not exact: approximate, or one of several readings. One of 2 readings the sources give for this unit; none is preferred" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 15 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/pound> ] ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/mass> .

