  <rdf:Description rdf:nodeID="unit_lucepond_cb40aa5fa8df50244b846fc53d27853d31960979bde43030b898b913ede3ec759b">
    <crm:P190_has_symbolic_content>Liespfund, a Baltic-Hanseatic unit of weight (6.846 kg or 15 lb.), equivalent to 1/20 of a schippond (Wolf 43), here as a measure of wax | . Liespfund, a Baltic-Hanseatic unit of weight, approximately 6.8 kg, one twentieth of a shipplb.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
