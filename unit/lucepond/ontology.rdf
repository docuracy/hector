  <rdf:Description rdf:nodeID="unit_lucepond_cb0">
    <crm:P190_has_symbolic_content>Source: LCA glossary (lucepond: '6.846 kg or 15 lb.'). Not exact: approximate, or one of several readings. One of 2 readings the sources give for this unit; none is preferred</crm:P190_has_symbolic_content>
