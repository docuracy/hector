            hector:validFrom "1472"^^xsd:gYear ;
            hector:validThrough "1477"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a definite quantity of thread, yarn, etc., varying with the commodity, being a certain number of coils tied by a knot, here a measure for napery (OED s.v. knot n.1 4) | a definite quantity of thread, yarn, etc., varying with the commodity, being a certain number of coils tied by a knot, here a measure for napery damask (OED s.v. knot n.1 4) | a definite quantity of thread, yarn, etc., varying with the commodity, being a certain number of coils tied by a knot, here a measure for napery damask (OED s.v. knot n.1 4) as a measure of napery | as a measure of Dinant napery" ;
            crm:P2_has_type aat:300435416 ] ;
