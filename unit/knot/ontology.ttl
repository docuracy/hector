            hector:phoneticKey "knotəs" ;
            hector:validFrom "1428"^^xsd:gYear ;
            hector:validThrough "1430"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "knotte" ;
