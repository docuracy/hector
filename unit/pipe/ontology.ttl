    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a pipe, a cask used as a liquid measure of capacity containing 126 old gallons, equivalent to 2 hogsheads and ½ of a tun (½ dolium) (Zupko 302-4); used as a measure and packing unit for wine and for other liquids (oil, beer, vinegar) and for dry goods. Also traded empty as an article of commerce; also used as a measure or packet for gilt-metal thread (aurum Colonie)." ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/pipe>,
        <https://w3id.org/mlca/glossary/pipe> ;
    skos:broader aat:300386648 ;
    la:equivalent aat:300194515 ;
    hector:attestationCount 5485 ;
    hector:definedAs [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (pipe: '2 hogsheads'; butt/bote: '2 hogsheads or ½ tun'). One of 2 readings the sources give for this unit; none is preferred" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 5e-01 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/tun> ],
        [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (pipe: '126 old gallons, equivalent to 2 hogsheads'). Note: old (wine) gallons. One of 2 readings the sources give for this unit; none is preferred" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 126 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/gallon> ] ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/package>,
