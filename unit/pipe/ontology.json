  "_label": "pipe",
  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "a pipe, a cask used as a liquid measure of capacity containing 126 old gallons, equivalent to 2 hogsheads and ½ of a tun (½ dolium) (Zupko 302-4); used as a measure and packing unit for wine and for other liquids (oil, beer, vinegar) and for dry goods. Also traded empty as an article of commerce; also used as a measure or packet for gilt-metal thread (aurum Colonie)."
    }
  ],
