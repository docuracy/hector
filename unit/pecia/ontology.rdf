  <rdf:Description rdf:nodeID="unit_pecia_cb27ff3c8a02db81672f7c1113ed7a4b97075f972e29872bf1dfb91474725d5ea1">
    <crm:P190_has_symbolic_content>pecia / pece (Latin, a piece): a piece used as a measure or packing unit, of definite size varying by commodity — figs (60 lb.), raisins and other fruit/citrus (a third of a sorte), Cornish tin (250 lb.) and tin foil, rosin, battery (650 lb.) and kettles, brazil, iron of Lucca, buckram, lawn, Dornix thread, saunders, hops and marmalade.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
