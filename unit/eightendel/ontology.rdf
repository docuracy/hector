  <rdf:Description rdf:nodeID="unit_eightendel_cb0">
    <crm:P190_has_symbolic_content>measure of capacity, especially for eels (⅛ of a barrel) (MED s.v. eightendel) | one eighth of a barrel, here as a measure of sturgeon | measure of capacity, esp. for eels (⅛ of a barrel) (MED s.v. eightendel) | measure of capacity, esp. for eels (⅛ of a barrel), also potash (MED s.v. eightendel) | one eighth of a barrel, here as a measure of salted sturgeon, eels | one eighth of a barrel, here as a measure of eels | one eighth of a barrel, here as a measure of fish, eels | a measure of capacity, especially for eels (⅛ of a barrel) (MED s.v. eightendel) | measure of capacity, especially for eels (⅛ of a barrel) (MED s.v. eightendel), here for russhe oile</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
