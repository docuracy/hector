  <rdf:Description rdf:nodeID="unit_nest_cbee9b2a09aa51f48464ea3def90cc8195f9cf1a966f8a820cae247310b612ee6c">
    <crm:P190_has_symbolic_content>nestes</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="https://w3id.org/hector/ontology#AttestedVariant"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_E41_Linguistic_Appellation"/>
    <hector:phoneticKey>nestəs</hector:phoneticKey>
    <hector:validFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1490</hector:validFrom>
    <hector:validThrough rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1492</hector:validThrough>
