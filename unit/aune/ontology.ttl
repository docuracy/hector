            hector:phoneticKey "aunəs" ;
            hector:validFrom "1536"^^xsd:gYear ;
            hector:validThrough "1540"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Units of length, now obsolete, used in several European countries. In England, one ell corresponded to approximately 45 inches. In Scotland, 37.2 inches. The Flemish ell corresponded to 27 inches.  [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/aune-2>,
