  <rdf:Description rdf:nodeID="unit_aune_cb809b4010c764cb7c585f552fe03c5b30460d3408268f9ffbd6bee954c151c674">
    <crm:P190_has_symbolic_content>Units of length, now obsolete, used in several European countries. In England, one ell corresponded to approximately 45 inches. In Scotland, 37.2 inches. The Flemish ell corresponded to 27 inches.  [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
