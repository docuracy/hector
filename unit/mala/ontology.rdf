  <rdf:Description rdf:nodeID="unit_mala_cb157961a908f1324cd38376899dd821ce8e160409e0c08b52eaa74784d48c7c79">
    <crm:P190_has_symbolic_content>mala (also 'male', 'mail'), a packing unit — a leather pack, bag or trunk used to bundle goods (chiefly cloths) for carriage; of no particular fixed size. Cf. French 'malle'.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
