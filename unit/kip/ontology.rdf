  <rdf:Description rdf:nodeID="unit_kip_cb44cfb37a594bd2afcf7b13aa819502406785f786e81faf07682120913f7df78d">
    <crm:P190_has_symbolic_content>kip, a bundle or set of hides, skins or furs, used as a measure of quantity (OED s.v. kip n.1); e.g. a kip of lambfells reckoned at 150 lambskins. Frequently confused orthographically with kipe (a basket) — see kyppe.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
