    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a measure of Rhine wine, equivalent to ⅓ of a dolium | a measure of Rhine wine equivalent to ⅓ of a dolium | a measure of Rhine wine (OED s.v. aam), equivalent to 1/5 of a dolium | a measure of Rhein wine equivalent to ⅓ of a dolium | a measure of Rhine wine (OED s.v. aam) | a measure of Rhine wine (5 aumes = 1 dolium) | as a measure of wine, equivalent to ⅓ tun | aume, a measure of Rhine wine equivalent to ⅓ of a dolium | clearly some kind of iron, but exact meaning unknown" ;
