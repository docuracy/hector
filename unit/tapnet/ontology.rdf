  <rdf:Description rdf:nodeID="unit_tapnet_cbea216bf6d67f0b3fb42767a1c9abf9df291d663d240289e32912fd2caa910621">
    <crm:P190_has_symbolic_content>a basket made of rushes, in which figs (formerly also raisins, etc.) are imported; also a conventional measure of quantity (OED s.v. tapnet; top n.3; toppet2), here of figs or raisins; also used as a packing unit for nails</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
