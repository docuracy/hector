  "id": "https://w3id.org/hector/unit/roll",
  "type": "MeasurementUnit",
  "_label": "roll",
  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "roll (rouleau; Latin rotulus, rolla): a packing unit and measure for cloth — both a physical unit of transport of no particular size and, for cloth, a standard length and breadth, sometimes of a definite size (Osnabrück linen: 1500 ells; Hasord cloth: 15 hundred ells at 6 score). See also pack, bale."
    }
  ],
