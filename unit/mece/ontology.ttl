<https://w3id.org/hector/unit/mece> a crm:E58_Measurement_Unit ;
    rdfs:label "mece" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mecis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "mesis" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "meces" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "mesəs" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mece" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "mesə" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "mece: a measure of weight, chiefly of copper (300 lb.)" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/mece>,
        <https://w3id.org/mlca/glossary/mece> ;
    skos:broader aat:300386648 ;
    hector:attestationCount 28 ;
    hector:definedAs [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (mece: '300 lb.'). Note: stated, but a customary weight. Not exact: approximate, or one of several readings" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 300 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/pound> ] ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/mass> .

