    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "wey, a measure of weight, usually equal to twelve stone or c. 300 lb. (OED s.v. waw, n.2, wey1; Zupko 434-8), used for dry goods including salt, cheese, glass, tallow, sheep tallow (cepum moltonis), butter, thrumes, and battery; as a packing unit for glass containing 60 bunches (also 60 bunches for Renishe window glass), and for salt containing 40 bushels; note 7 centene = 80 vagas | clearly some kind of measure of salt, but exact meaning unknown" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/wey>,
        <https://w3id.org/mlca/glossary/wey> ;
    la:equivalent aat:300386648 ;
    hector:attestationCount 1891 ;
    hector:definedAs [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (wey: 'usually equal to twelve stone or c. 300 lb.'). Note: self-inconsistent: 12 stone is 168 lb, not c. 300 lb; varies by commodity. Not exact: approximate, or one of several readings. One of 2 readings the sources give for this unit; none is preferred" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 12 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/stone> ],
        [ a crm:E54_Dimension ;
            crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
                    crm:P190_has_symbolic_content "Source: LCA glossary (wey: 'usually equal to twelve stone or c. 300 lb.'). Note: the same description's other reading; 300 lb is not twelve stone (168 lb). Not exact: approximate, or one of several readings. One of 2 readings the sources give for this unit; none is preferred" ;
                    crm:P2_has_type aat:300418049 ] ;
            crm:P90_has_value 300 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/pound> ] ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/mass> .

