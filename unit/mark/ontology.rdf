  <rdf:Description rdf:nodeID="unit_mark_cb2418555100be84ed944d94900a947b549960d849a212cc9850507e4bbc741c19">
    <crm:P190_has_symbolic_content>Source: LCA glossary (mark: '20 pieces, or 2 dozen'). Note: the glossary's other reading; the Books of Rates give 2 dozen. Not exact: approximate, or one of several readings. One of 2 readings the sources give for this unit; none is preferred</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300418049"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="unit_mark_cb9d1ecb0c725e3ffbba29cd0ac875a6028a9289c0e56902c2d5f63ea728bf2e47">
    <crm:P190_has_symbolic_content>Source: units.tsv ('marke sheres for semesters 2 dozen pieces'); Books of Rates ('the marke conteyninge two dossyn'). Note: CONFLICT: the glossary says '20 pieces, or 2 dozen'. One of 2 readings the sources give for this unit; none is preferred</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300418049"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
