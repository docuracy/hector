<https://w3id.org/hector/unit/face> a crm:E58_Measurement_Unit ;
    rdfs:label "face" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "face" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "fasə" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "facez" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "fasez" ;
            hector:validFrom "1483"^^xsd:gYear ;
            hector:validThrough "1485"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "as a measure for drinking glasses (Cobb 179 '?fasculum, a small vessel')" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/face>,
        <https://w3id.org/mlca/glossary/face> ;
    skos:broader aat:300386648 ;
    hector:attestationCount 1 ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/package> .

