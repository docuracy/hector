  <rdf:Description rdf:nodeID="unit_dicker_cbaecafdd9c11fb696a954fb9a0a647c9ca3d6a772862c0aa6e787a90f5c18e10c">
    <crm:P190_has_symbolic_content>a numerical unit of ten (Zupko 107-9), here of razors (see also dacra) | numerical unit of ten (knives, woolfells, hides) (Zupko 107-9) | a numerical unit of ten (hides) (Zupko 107-9) | numerical unit of ten (hides) (Zupko 107-9) | numerical unit of ten hides (Zupko 107-9) | numerical unit of ten (Zupko 107-9) | dicker, a measure of quantity (10 pieces) (Zupko 107-9) | a numerical unit of ten (Zupko 107-9) | numerical unit of ten (Zupko 107-9), here relating to imports of rasors (see also dacra) | a numerical unit of ten (knives, woolfells, hides) (Zupko 107-9) | dicker, numerical unit of ten (hides) (Zupko 107-9) | dicker, a measure of quantity (10 pieces), here of hides (Zupko 107-9) 7, 10, 51, 52, 61, 62, 63, | as a counting unit of ten (hides, knives) (Zupko 107-9) | a counting unit of ten (hides, knives) (Zupko 107-9) | a unit of counting, 10 pieces | a numerical unit of ten (Zupko 107-9), here relating to imports of rasors, elk horns, furs, hides) (see also dacra) | a counting unit for hides (10 pieces) | dicker, a measure of quantity (10 pieces), here of hides (Zupko 107-9) | a numerical unit of ten (here of hides) (Zupko 107-9) of leather | numerical unit of ten (Zupko 107-9), here not of hides (see also dacra) | numerical unit of ten (Zupko 107-9), here relating to exported hides (see also dyker) | numerical unit of ten (Zupko 107-9), here relating to exported hides | numerical unit of ten (Zupko 107-9), here relating to exported hides (see also deker) | of hides, 10 pieces | measure of quantity for hides, 10 pieces | a counting unit (10)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
