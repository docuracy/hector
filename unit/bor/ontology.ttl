<https://w3id.org/hector/unit/bor> a crm:E58_Measurement_Unit ;
    rdfs:label "bor" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bor" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "bor" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "borys" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "boris" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "some sort of measure of flax (Cobb 56 n. 1 ‘? bunches, cf. bos = bunch (Dutch)’ but MNW records no such definition)" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/bor>,
        <https://w3id.org/mlca/glossary/bor> ;
    skos:broader aat:300386648 ;
    hector:attestationCount 8 ;
    hector:quantityKind <https://w3id.org/hector/unit/dimension/package> .

