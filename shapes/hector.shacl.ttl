# SHACL shapes for HECTOR documents, applied by tools/validate.py to the expanded RDF of each
# ontology.json. Structural rules that are about the graph, not the file path; path-dependent
# rules (what a commodity or a unit must be) are in tools/validate.py (check_kind).

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix hector: <https://w3id.org/hector/ontology#> .
@prefix hs:     <https://w3id.org/hector/shapes#> .

# A Name (Linked Art: crm:E33_E41_Linguistic_Appellation) has exactly one text. Its language,
# when known, is an entity (an AAT language concept), never a string. Language is optional:
# the LCA glossary does not record the language of a form, and HECTOR does not guess it.
hs:NameShape
    a sh:NodeShape ;
    sh:targetClass crm:E33_E41_Linguistic_Appellation ;
    sh:property [
        sh:path crm:P190_has_symbolic_content ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype <http://www.w3.org/1999/02/22-rdf-syntax-ns#langString> ] ) ;
        sh:message "a Name needs exactly one text (content)" ;
    ] ;
    sh:property [
        sh:path crm:P72_has_language ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://vocab\\.getty\\.edu/aat/3[0-9]{8}$" ;
        sh:message "a Name's language must be an AAT language concept" ;
    ] ;
    sh:property [
        sh:path hector:phoneticKey ;
        sh:datatype xsd:string ;
        sh:message "phonetic keys are plain strings" ;
    ] .

# A monetary amount: a currency entity and an exact value in pence.
hs:MonetaryAmountShape
    a sh:NodeShape ;
    sh:targetClass crm:E97_Monetary_Amount ;
    sh:property [
        sh:path crm:P180_has_currency ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "a monetary amount needs exactly one currency entity" ;
    ] ;
    sh:property [
        sh:path hector:valueInPence ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "a monetary amount needs exactly one non-negative xsd:decimal valueInPence" ;
    ] .

# A rate: an amount, a quantity it is charged on, and a validity period.
hs:RateShape
    a sh:NodeShape ;
    sh:targetClass hector:Rate ;
    sh:property [
        sh:path hector:amount ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class crm:E97_Monetary_Amount ;
        sh:message "a rate needs exactly one MonetaryAmount (hector:amount)" ;
    ] ;
    sh:property [
        sh:path hector:perQuantity ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class crm:E54_Dimension ;
        sh:message "a rate needs exactly one Dimension it is charged per (hector:perQuantity)" ;
    ] ;
    sh:property [
        sh:path hector:validFrom ; sh:maxCount 1 ; sh:datatype xsd:gYear ;
        sh:message "validFrom is a single xsd:gYear" ;
    ] ;
    sh:property [
        sh:path hector:validThrough ; sh:maxCount 1 ; sh:datatype xsd:gYear ;
        sh:message "validThrough is a single xsd:gYear" ;
    ] .

# A quantity (Linked Art Dimension): a numeric value and a unit.
hs:DimensionShape
    a sh:NodeShape ;
    sh:targetClass crm:E54_Dimension ;
    sh:property [
        sh:path crm:P90_has_value ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "a Dimension needs exactly one value" ;
    ] ;
    sh:property [
        sh:path crm:P91_has_unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "a Dimension needs exactly one unit, given by IRI" ;
    ] .

# A measurement unit carries a label and, where known, an exact conversion to grams.
hs:MeasurementUnitShape
    a sh:NodeShape ;
    sh:targetClass crm:E58_Measurement_Unit ;
    sh:property [
        sh:path hector:conversionToGram ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:message "conversionToGram is a single positive xsd:decimal" ;
    ] .
