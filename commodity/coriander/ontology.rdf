  <rdf:Description rdf:nodeID="commodity_coriander_cb0">
    <crm:P190_has_symbolic_content>coriander, an annual plant, Coriandrum sativum, family Umbelliferæ, with compound leaves and globose fruit; a native of Southern Europe, the Levant, etc., naturalized in some parts of England. The fruit is carminative and aromatic, and used for flavouring purposes (OED s.v. coliander)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
