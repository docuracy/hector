  <rdf:Description rdf:nodeID="commodity_doublet_cb2cad5d4c2437e9f41af2218e7ad3d9355fb09bacace92562c7e3e726b2186e95">
    <crm:P190_has_symbolic_content>Close-fitting waist-length or hip-length garments with or without sleeves worn by men from the 15th to the 17th century and for similar garments reinforced by mail and worn under armor. Also refers to sleeved, hip-length garments worn as part of military uniforms by the Scottish units of the British army after 1855. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
