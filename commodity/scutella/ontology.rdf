  <rdf:Description rdf:nodeID="commodity_scutella_cb1e2935bfccef6c5efafb95d3bab85922855a4cf393312e70ac0c1cac921ab88f">
    <crm:P190_has_symbolic_content>Circular or rectangular flat dishes, generally made of wood, pottery or metal, on which meat or other food is carved or served. Early wooden examples often have a depressed area for food and a second smaller cavity for salt. Use "chargers" for large platters, usually circular or oval and often made of earthenware or metal, used for serving meat. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
