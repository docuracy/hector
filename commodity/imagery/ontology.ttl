<https://w3id.org/hector/commodity/imagery> a crm:E55_Type ;
    rdfs:label "imagery" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "imagry" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "imagri" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "imagery" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "imadʒeri" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ymagery" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "imadʒeri" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "imagere" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "imadʒerə" ;
            hector:validFrom "1545"^^xsd:gYear ;
            hector:validThrough "1547"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "figured work on a textile fabric, as in tapestry (OED II, s.v. imagery)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300205002 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/imagery> ;
    hector:attestationCount 7 .

aat:300205002 a crm:E55_Type ;
    rdfs:label "tapestries" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/imagery> a crm:E55_Type ;
