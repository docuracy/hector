  <rdf:Description rdf:nodeID="commodity_woad_cb1e7d95ef139416d1abd724bfb67691ac89a1f336717eee7d87fe75b256110d5ff">
    <crm:P190_has_symbolic_content>Woad: a blue dyestuff prepared from the leaves of Isatis tinctoria, powdered and fermented (OED s.v. woad n.1). Latin gualda/gualdum. Not to be confused with the timber 'wood' (homonym, see wood) nor with weld, the yellow dye of Reseda luteola (see welde).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
