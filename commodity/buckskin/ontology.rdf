  <rdf:Description rdf:nodeID="commodity_buckskin_cbaa2edef082250809d4a8d288a2a615b45437531e0726a1a10cfcaa2b63977f8d">
    <crm:P190_has_symbolic_content>Leather made from skin from deer or deer family animals from which the grain has been removed. Generally treated with animal oils, formaldehyde, or a combination of both. For unprocessed skin, use "deerskin."  [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
