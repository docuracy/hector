    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Half-sleeved or sleeveless tunics worn as ecclesiastical vestments before the 4th century.  Also, similar garments worn by monks and by kings as coronation robes. [Source: Getty AAT]" ;
