<https://w3id.org/hector/commodity/foot> a crm:E55_Type ;
    rdfs:label "foot" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pes" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "fotte" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "fotə" ;
            hector:validFrom "1465"^^xsd:gYear ;
            hector:validThrough "1472"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pedis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pedis" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "foot" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "foːt" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a measure of length (12 in.)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300386648 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/foot> ;
    hector:attestationCount 7 .

