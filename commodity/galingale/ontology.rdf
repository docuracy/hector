  <rdf:Description rdf:nodeID="commodity_galingale_cb1b11d1947a7a8f574d9124f0b19e26e9482ea329232b6418c424ac5b72d35ecc8">
    <crm:P190_has_symbolic_content>galingale, the aromatic root of certain East Indian plants of the genera Alpinia and Kæmpferia, used in medicine and cookery (OED s.v. galingale); the rhizoma of Alpinia Galanga, a plant of Java, constitutes the drug known as Radix Galangae majoris or Greater Galangal (Flückiger 582) | the aromatic root of certain East Indian plants, used in medicine and cookery (OED s.v. galigale) | the aromatic root of certain East Indian plants (used in medicine and cookery) (OED s.v. galingale) | the aromatic root of certain East Indian plants (used in medicine and cookery) (OED s.v. galingale) 48, 158, | the aromatic root of certain East Indian plants, used in medicine and cookery (Heyd 591-3)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
