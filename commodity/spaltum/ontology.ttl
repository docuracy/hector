<https://w3id.org/hector/commodity/spaltum> a crm:E55_Type ;
    rdfs:label "spaltum" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "spaltum" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "spaltum" ;
            hector:validFrom "1442"^^xsd:gYear ;
            hector:validThrough "1445"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "spalti" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "spalti" ;
            hector:validFrom "1442"^^xsd:gYear ;
            hector:validThrough "1445"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "probably asphalt or bitumen used as a varnish (OED s.v. spaltam), but cf. MED s.v. asp(h)alt n." ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300014974 ;
    skos:closeMatch aat:300012966,
        aat:300012976 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/spaltum> ;
    hector:attestationCount 1 .

