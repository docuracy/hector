            crm:P190_has_symbolic_content "popping" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "popiŋ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poppyng" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "popiŋ" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "cosmetics (MED s.v. popping)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/popping> ;
    la:equivalent aat:300236306 ;
