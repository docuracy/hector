  <rdf:Description rdf:nodeID="commodity_powderbox_cba019aaf2d929d7bc55c1926d2733e4f7b3798111d5b137c7774cb7d3ae6b37c6">
    <crm:P190_has_symbolic_content>a box for holding powder, especially toilet-powder (talcum-powder), usually also containing a powder-puff; also for holding powdered spice or salt, for carrying gunpowder, or (with small holes in the lid) for sprinkling powder or sand upon writing to prevent blotting (OED s.v. powder-box)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
