  <rdf:Description rdf:nodeID="commodity_salette_cb1abb030cdbe5ccf609f5bc1185522569f09665ad2b7ca7a54421afffe27c92cf">
    <crm:P190_has_symbolic_content>salette, in medieval armour, a light globular head-piece, either with or without a vizor, and without a crest, the lower part curving outwards behind (OED s.v. sallet, salade; MED s.v. salette)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
