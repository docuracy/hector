  <rdf:Description rdf:nodeID="commodity_card_nails_cb0">
    <crm:P190_has_symbolic_content>nail for use in making cards | Specialized combs, typically made of wood, comprising a flat surface covered by iron nails, wire teeth, or other sharp objects designed to manually disentangible the fibres from textile materials prior to spinning. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
