<https://w3id.org/hector/commodity/fillet> a crm:E55_Type ;
    rdfs:label "fillet" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "filet" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "filet" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "felette" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "feletə" ;
            hector:validFrom "1465"^^xsd:gYear ;
            hector:validThrough "1472"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "felettes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "feletəs" ;
            hector:validFrom "1465"^^xsd:gYear ;
            hector:validThrough "1472"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "fillet" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "filet" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Ribbons, strings, or narrow bands of any material used for binding the hair, or worn round the head to keep the headdress in position, or simply for ornament. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/fillet> ;
    la:equivalent aat:300400886 ;
    hector:attestationCount 1 .

aat:300400886 a crm:E55_Type ;
    rdfs:label "fillets (headgear)" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/fillet> a crm:E55_Type ;
