            hector:validThrough "1520"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a narrow woven strip of stout linen, cotton or other textile, used as a string for tying (OED s.v. tape) | a narrow woven strip of stout linen, cotton or other textile, used as a string for tying (OED s.v. tape), here white in color" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/tape> ;
    la:equivalent aat:300014685 ;
