  <rdf:Description rdf:nodeID="commodity_skabard_cbae27693adbb46fa19e206671c9043240858c5f5d7e3cd480f0e23c4cd57e5513">
    <crm:P190_has_symbolic_content>scabbard, the case or sheath which serves to protect the blade of a sword, dagger, or bayonet when not in use (OED s.v. scabbard n.1), here sometimes made with velvet | a thin board used in making splints, the scabbards of swords, veneer, etc. (OED s.v. scabbard n.3)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
