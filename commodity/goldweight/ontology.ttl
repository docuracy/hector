<https://w3id.org/hector/commodity/goldweight> a crm:E55_Type ;
    rdfs:label "goldweight" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "goldweyghtes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "goldweixtəs" ;
            hector:validFrom "1461"^^xsd:gYear ;
            hector:validThrough "1465"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "goldweyght" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "goldweixt" ;
            hector:validFrom "1461"^^xsd:gYear ;
            hector:validThrough "1465"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "goldweight" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "goldweixt" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "goldweightes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "goldweixtəs" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "scales for weighing gold (OED s.v. gold-weight)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300195708 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/goldweight> ;
    hector:attestationCount 2 .

