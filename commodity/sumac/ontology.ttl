            hector:phoneticKey "sumak" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "somack" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "somak" ;
            hector:validFrom "1550"^^xsd:gYear ;
            hector:validThrough "1553"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
