        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "shumake" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "ʃumakə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "smacis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "smasis" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A part or parts of the shrub sumac (Rhus coriaria), usually used as an ingredient in medicaments (MED s.v. sumac n.); a preparation of the dried and chopped leaves and shoots of plants of the genus Rhus, especially R. Coriaria, much used in tanning, also for dyeing and staining leather black and medicinally as an astringent (OED s.v. sumach, sumac n.); in view of the reading of the Cologne translation of the Book of Rates (smacis) and the definition of smacke as 'sumach, rhus coriaria' (Lübben-Walter s.v. smacke), identified as sumach" ;
            crm:P2_has_type aat:300435416 ] ;
