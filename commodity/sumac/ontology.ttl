            hector:phoneticKey "ʃomakə" ;
            hector:validFrom "1556"^^xsd:gYear ;
            hector:validThrough "1559"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "smake" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "smakə" ;
            hector:validFrom "1550"^^xsd:gYear ;
