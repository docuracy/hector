    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a protective covering for the breast and flanks of a war-horse, made of metal plates, or of leather set with metal spikes or bosses, but sometimes (e.g. in tournaments) merely ornamental, and made of velvet or other rich stuff (OED s.v. bard n.2) | Complete sets of horse armor. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
