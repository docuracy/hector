<https://w3id.org/hector/commodity/clavichord-string> a crm:E55_Type ;
    rdfs:label "clavichord string" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "claricord wyer" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "klarikord wier" ;
            hector:validFrom "1550"^^xsd:gYear ;
            hector:validThrough "1553"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "clavichord string" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "klavitʃord striŋ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
