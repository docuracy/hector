            hector:phoneticKey "klarikordə red" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "strings for a clavichord, a musical instrument with strings and keys; in its developed form resembling a square pianoforte, the tones being produced by the action on the strings of ‘tangents’ or small brass wedges attached in upright position to the back of the keys (OED s.v. clavichord, clarichord)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300191094 ;
