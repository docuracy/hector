  <rdf:Description rdf:nodeID="commodity_clavichord_string_cb0">
    <crm:P190_has_symbolic_content>strings for a clavichord, a musical instrument with strings and keys; in its developed form resembling a square pianoforte, the tones being produced by the action on the strings of ‘tangents’ or small brass wedges attached in upright position to the back of the keys (OED s.v. clavichord, clarichord)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
