<https://w3id.org/hector/commodity/bush> a crm:E55_Type ;
    rdfs:label "bush" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bussh" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "buʃ" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bush" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "buʃ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "busshis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "buʃis" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "anything resembling a bush; a bushy mass of foliage, feathers, etc.; a bunch (OED s.v. bush n.1 6a), here as a packing unit for ostrich feathers" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300386648 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/bush> ;
    hector:attestationCount 1 .

