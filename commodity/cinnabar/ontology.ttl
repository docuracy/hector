<https://w3id.org/hector/commodity/cinnabar> a crm:E55_Type ;
    rdfs:label "cinnabar" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cinnabar" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "sinabar" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "scynaper" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sinaper" ;
            hector:validFrom "1513"^^xsd:gYear ;
            hector:validThrough "1514"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "synaper" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sinaper" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "synopre" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sinoprə" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Pigment made from the mineral cinnabar, composed of mercuric sulfide. Cinnabar was finely ground for use as an artist pigment since antiquity. Red mercuric sulfide has been made synthetically since at least the 8th century in Europe and possibly earlier in China. Synthetic mercuric sulfide is called vermilion, favored over ground cinnabar as a red pigment because cinnabar, when exposed to ultraviolet light, darkens from its normal red crystalline form to a black isomorph, resulting in splotchy discolorations. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/cinnabar> ;
    la:equivalent aat:300400883 ;
    hector:attestationCount 4 .

