            hector:phoneticKey "presis" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a cabinet, chest etc. for books, clothes etc. (MED s.v. presse (n) 7) | here small | of Cyprus manufacture | here as a packing unit for cloth" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300039235 ;
