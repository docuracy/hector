            hector:phoneticKey "pres" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pres" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pres" ;
            hector:validFrom "1531"^^xsd:gYear ;
            hector:validThrough "1533"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "presses" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "presəs" ;
            hector:validFrom "1472"^^xsd:gYear ;
            hector:validThrough "1477"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
