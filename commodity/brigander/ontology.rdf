  <rdf:Description rdf:nodeID="commodity_brigander_cb6408877d00eda72e907051e9de063e7488056aca2fab1191386565cf7b4dc9ab">
    <crm:P190_has_symbolic_content>body-armor for foot-soldiers made of iron rings or small thin iron plates sewn onto canvas, linen or leather and covered with a similar material. Originally in pairs (front and back), ergo often in the plural (OED s.v. brigandine) | body-armor for foot soldiers (OED s.v. brigander1)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
