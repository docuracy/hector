  <rdf:Description rdf:nodeID="commodity_thrum_cb4e2d830f3d4a782f05b87fd9ddeae07a893d3352d3884baf96992d82ef070be3">
    <crm:P190_has_symbolic_content>thrum, the ends of the warp-threads left unwoven and attached to the loom when the web is cut off; waste threads of yarn; tuft, tassel or fringe of threads at the edge of a piece of cloth (OED s.v. thrum n.2); sometimes of silk</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
