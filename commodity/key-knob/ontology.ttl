<https://w3id.org/hector/commodity/key-knob> a crm:E55_Type ;
    rdfs:label "key knob" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "keyknob" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "keiknob" ;
            hector:validFrom "1541"^^xsd:gYear ;
            hector:validThrough "1545"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "knaps pro claviculis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "knaps pro klavikulis" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "key knopp" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kei knop" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "keyknobes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "keiknobəs" ;
            hector:validFrom "1541"^^xsd:gYear ;
            hector:validThrough "1545"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "knap pro claviculis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "knap pro klavikulis" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "key knoppe" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kei knopə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "key knob" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "kei knob" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "key knoppes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kei knopəs" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "exact meaning unknown. MED defines knoppe as an ornamental knob (MED s.v. knop(pe n. (1)), but does not attest, much less define key knoppe. The Cologne translations are ‘a hook for keys’ (schlüssel hacken) and ‘a knob for keys’ (schlüssel knoüff), but that is also unattested | exact meaning unknown. MED defines knoppe as an ornamental knob (MED s.v. knop(pe n. (1)), but does not attest, much less define key knob. The Cologne translations of the Books of Rates describe this as ‘a hook for keys’ (schlüssel hacken) and ‘a knob for keys’ (schlüssel knoüff), but that is also unattested (Jenks 2024, p. 283)) | key knopp(e), a term whose exact meaning is unknown. MED defines knoppe as an ornamental knob (MED s.v. knop(pe n. (1)), but does not attest, much less define key knoppe. The Cologne translations (in the Book of Rates) are ‘a hook for keys’ (schlüssel hacken) and ‘a knob for keys’ (schlüssel knoüff), but that is also unattested)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300251631 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/key%20knob> ;
    skos:related <https://w3id.org/hector/commodity/keyring> ;
    hector:attestationCount 2 ;
    hector:taxation <https://w3id.org/hector/commodity/key-knob#rate-1558-inward-641> .

