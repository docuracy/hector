  <rdf:Description rdf:nodeID="commodity_nubs_of_silk_cb77a1c2990723d4f8765614fb2817667612b01afa69e052c6f114821afa22316f">
    <crm:P190_has_symbolic_content>of silk nobbes is attested in OED s.v. nub. n.1 1, but not defined. In view of the entry in the Book of Rates (Jenks 111), which equates nobbs with huskes of silke, this must be a husk of silk, the shell or case of a chrysalis, a cocoon, especially of silkworms (OED s.v. husk 2b)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
