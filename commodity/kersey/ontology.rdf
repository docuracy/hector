  <rdf:Description rdf:nodeID="commodity_kersey_cb5fb949f7413efced49be25ec529403b70d045c5830fbb3ec479b96c5bb81dd2f">
    <crm:P190_has_symbolic_content>kersey, a kind of coarse narrow cloth, woven from long-staple wool and usually ribbed, originally produced in Kersey in Suffolk; reckoned at three to a shortcloth of assize (equivalent to one third of a pannus curtus) (OED s.v. kersey). See also pannus strictus.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
