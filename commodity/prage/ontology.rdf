  <rdf:Description rdf:nodeID="commodity_prage_cb1eec4212aaa3aa78da13f649d26dac14d07909ce96df6e98094c3393645082b5f">
    <crm:P190_has_symbolic_content>probably a kind of knife (note E122/194/24 Prage cultelli; despite the definitions offered by the OED, this must be some sort of knife); possibly prag, a pin, nail or spike (OED s.v. prage); or prog, a piercing instrument or weapon, a spike, skewer (OED s.v. prog); or brog, a pricking or boring instrument (OED s.v. brog)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
