<https://w3id.org/hector/commodity/hasborough-stone> a crm:E55_Type ;
    rdfs:label "hasborough stone" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hasborough stones" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "hasboruːx stonəs" ;
            hector:validFrom "1550"^^xsd:gYear ;
            hector:validThrough "1553"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hasborough stone" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "hasboruːx stonə" ;
            hector:validFrom "1550"^^xsd:gYear ;
            hector:validThrough "1553"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A stone (probably building or paving stone) named for Hasborough — the same toponym (Hazebrouck, Flanders) that gives the cloth its name (cf. Willan 35). Distinct from the Hazebrouck cloth, whose spellings are now folded into the `cloth` entry as a locational qualifier. Compare `caen stone`. Precise identification uncertain." ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300011176 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/hasborough%20stone> .

