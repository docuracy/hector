  <rdf:Description rdf:nodeID="commodity_hasborough_stone_cbd06275acc024b9ef97755aec1610ed26f4aad8209c9346eecf6756e2d61a26bd">
    <crm:P190_has_symbolic_content>A stone (probably building or paving stone) named for Hasborough — the same toponym (Hazebrouck, Flanders) that gives the cloth its name (cf. Willan 35). Distinct from the Hazebrouck cloth, whose spellings are now folded into the `cloth` entry as a locational qualifier. Compare `caen stone`. Precise identification uncertain.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
