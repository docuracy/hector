<https://w3id.org/hector/commodity/panel> a crm:E55_Type ;
    rdfs:label "panel" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "panel" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "panel" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pannyles" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "paniləs" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pannyle" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "panilə" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a distinct, typically rectangular section or compartment of a wainscot, door, shutter, etc., usually of wood or glass and generally thinner than the surround (OED s.v. panel n.1 II.i.5.a)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/panel> ;
