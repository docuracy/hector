  <rdf:Description rdf:nodeID="commodity_cuisse_cb8b60dc92d4bb3575bee8b8f51a9f4679dd55f838c097a09771514fda2dbc226f">
    <crm:P190_has_symbolic_content>Plate armor for the thighs, usually attached to the poleyns at their lower end. Introduced during the 14th century, they evolved from a single plate covering the front of the thigh to articulated lames encircling the entire thigh. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
