<https://w3id.org/hector/commodity/cuisse> a crm:E55_Type ;
    rdfs:label "cuisse" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cussh" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kuʃ" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cuisse" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "kuisə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cusshis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kuʃis" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Plate armor for the thighs, usually attached to the poleyns at their lower end. Introduced during the 14th century, they evolved from a single plate covering the front of the thigh to articulated lames encircling the entire thigh. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/cuisse> ;
    la:equivalent aat:300036760 ;
    hector:attestationCount 2 .

