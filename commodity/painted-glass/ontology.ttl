@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/painted-glass> a crm:E55_Type ;
    rdfs:label "painted glass" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "painted glass" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "painted glas" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "payntid glasses" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "paintid glasəs" ;
            hector:validFrom "1536"^^xsd:gYear ;
            hector:validThrough "1540"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "payntid glass" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "paintid glas" ;
            hector:validFrom "1536"^^xsd:gYear ;
            hector:validThrough "1540"^^xsd:gYear ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/painted%20glass> ;
    la:equivalent aat:300343822 ;
    hector:attestationCount 1 .

aat:300343822 a crm:E55_Type ;
    rdfs:label "painted glass (visual works)" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

<https://w3id.org/mlca/glossary/painted%20glass> a crm:E55_Type ;
