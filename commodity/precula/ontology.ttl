<https://w3id.org/hector/commodity/precula> a crm:E55_Type ;
    rdfs:label "precula" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "precularum" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "prekularum" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "precula" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "prekula" ;
            hector:validFrom "1446"^^xsd:gYear ;
            hector:validThrough "1450"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "preculae" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "prekule" ;
            hector:validFrom "1446"^^xsd:gYear ;
            hector:validThrough "1450"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "bead (see also bedes, bedys)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/precula> ;
    skos:related <https://w3id.org/hector/commodity/bead>,
        <https://w3id.org/hector/commodity/paternoster>,
        <https://w3id.org/hector/commodity/trebedes> ;
    la:equivalent aat:300234006 ;
    hector:attestationCount 5 .

