  <rdf:Description rdf:nodeID="commodity_pipe_cb796c1d71c1d1da9f68bcd47fb54b5b0396c6731cdbe83723b4fed64b22f7012d">
    <crm:P190_has_symbolic_content>a pipe, a cask used as a liquid measure of capacity containing 126 old gallons, equivalent to 2 hogsheads and ½ of a tun (½ dolium) (Zupko 302-4); used as a measure and packing unit for wine and for other liquids (oil, beer, vinegar) and for dry goods. Also traded empty as an article of commerce; also used as a measure or packet for gilt-metal thread (aurum Colonie).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
