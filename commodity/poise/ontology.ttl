<https://w3id.org/hector/commodity/poise> a crm:E55_Type ;
    rdfs:label "poise" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poyz" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "poiz" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pois" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pois" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poyse" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "poisə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poise" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "poisə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poys" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pois" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Weight; a declared weight of goods (Anglo-Norman poids/peis), e.g. \"ropys poys 6000 lb.\"." ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300056240 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/poise> ;
    hector:attestationCount 11 .

