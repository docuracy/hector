  <rdf:Description rdf:nodeID="commodity_writing_tablet_cbb1ff2dfb07cee115911ae35d8bc344e8d20368c080cec59c782f5d0a241e3049">
    <crm:P190_has_symbolic_content>a small portable tablet for writing upon, especially for notes or memoranda; a writing-tablet (OED s.v. table n. 2b); also with wax let in for writing notes or memoranda on (OED s.v. table n. 4b); or a book composed of tablets for memoranda; a pocket note-book or memorandum-book (OED s.v. table-book) (see also table)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
