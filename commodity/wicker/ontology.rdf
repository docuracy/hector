  <rdf:Description rdf:nodeID="commodity_wicker_cb918487896ffc66f62ba4cc80cf6d5e994a5332fe5424fce25d752907a2b9d963">
    <crm:P190_has_symbolic_content>a pliant twig or small rod, usually of willow, especially as used for making baskets, chiefly used in plural to designate wickerwork, a basket, cradle, chair etc. made of wicker (OED s.v. wicker n.); also bottles covered (protected) with wicker</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
