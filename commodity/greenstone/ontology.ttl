@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/greenstone> a crm:E55_Type ;
    rdfs:label "greenstone" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "grenstone" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "grenstonə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "greenstone" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "greːnstonə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "grene stones" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "grenə stonəs" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Any of various rocks that are green in color, including altered igneous rocks colored green by feldspar, hornblende, augite, nephrite, or other minerals, or low-grade metamorphic rock containing actinolite, epidote, or albite. Greenstone has been used for carving and construction.  [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300386691 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/greenstone> ;
    hector:attestationCount 1 .

aat:300386691 a crm:E55_Type ;
    rdfs:label "greenstone (rock)" .

