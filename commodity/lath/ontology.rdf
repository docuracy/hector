  <rdf:Description rdf:nodeID="commodity_lath_cb26bc6e71c076bd04c43bd7ba11ef20e055a5f11156fe56e116bc01ef2ecf82d8">
    <crm:P190_has_symbolic_content>Thin, narrow, flat pieces of wood used for many purposes, such as in constructing lattices of trellis work, Venetian blinds, or to form a groundwork upon which to fasten the slates or tiles of a roof or the plaster of a wall or ceiling. For groundwork of any material upon which plaster or another such material is applied, use "lath (grounding surface)." [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
