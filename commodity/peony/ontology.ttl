<https://w3id.org/hector/commodity/peony> a crm:E55_Type ;
    rdfs:label "peony" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pyones" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pionəs" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pyone" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pionə" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "peony" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "peoni" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "peony, the root, flowers and seeds of which were formely used in medicine, the seeds also as a spice (OED s.v. peony)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300386730,
        aat:300404880 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/peony> ;
    hector:attestationCount 1 .

