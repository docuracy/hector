<https://w3id.org/hector/commodity/pyx> a crm:E55_Type ;
    rdfs:label "pyx" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pixes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "piksəs" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pix" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "piks" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pyx" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "piks" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pixis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "piksis" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the vessel in which the host of the sacrament is reserved (OED s.v. pyx 2)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/pyx> ;
    la:equivalent aat:300198333 ;
