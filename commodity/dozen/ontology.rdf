  <rdf:Description rdf:nodeID="commodity_dozen_cb0">
    <crm:P190_has_symbolic_content>twelve; a dozen. As a cloth measure, a dozen yards — a unit of narrowcloth (e.g. Northern, Western and Welsh dozens, Sarum motley, cottons); also used as a measure of cork, rosin and thread</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
