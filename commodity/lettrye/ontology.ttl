<https://w3id.org/hector/commodity/lettrye> a crm:E55_Type ;
    rdfs:label "lettrye" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lettrye" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "letrie" ;
            hector:validFrom "1472"^^xsd:gYear ;
            hector:validThrough "1477"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Historically, a collection of type consisting of all letters, numerals, punctuation marks, and other symbols belonging to a single design and point size, and not including other sets of characters such as the bold type of the same design family. In photocomposition and desktop publishing, a font is the set of characters and other symbols of one style available as a unit, such as through a strip of film or a program module. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/lettrye> ;
    la:equivalent aat:300208335 ;
    hector:attestationCount 1 .

