    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a lamb's skin with the fur dressed outward (OED s.v. budge sb.1) | a lamb's skin with the fur dressed outward (OED s.v. budge sb.1) (see also pellis bogee) | budge, a lamb's skin with the fur dressed outward (OED s.v. budge sb.1) | a lamb's skin with the fur dressed outward (OED s.v. budge sb.1) (see also pellis) | a lamb’s skin with the fur dressed outward (OED s.v. budge sb.1) | some kind of small fur used for lining garments (OED s.v. Romany^2); in the early 16^th century fine Spanish and Lombard lambskins (Veale 217) | a kind of fur, consisting of lamb’s skin with the wool dressed outwards (OED budge, n.^1), here white in color, tawed | a lamb's skin with the fur dressed outward (OED s.v. budge n.1) | a lamb’s skin with the fur dressed outward (OED s.v. budge n.1) | a kind of fur, consisting of lamb’s skin with the wool dressed outwards (OED budge, n.1) | (bodge) black in color, tawed | (bodgye pols) fur from the head and shoulders of budge (Veale 221) | a lamb's skin with the fur dressed outward (OED s.v. budge sb.1) (see also pellis bodge) | budge, a kind of fur, namely a lamb's skin with the fur dressed outward (OED budge n1) | meaning unknown | small pieces of budge | a lamb's skin with the fur dressed outward (OED s.v. budge sb.1) (see also pellis boge) | budge, a kind of fur, namely a lamb's skin with the fur dressed outward (OED budge n1), here made of the skins from the legs of the animal (Veale 217) | by characteristic | by color | by place of origin" ;
            crm:P2_has_type aat:300435416 ] ;
