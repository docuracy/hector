<https://w3id.org/hector/commodity/ruse> a crm:E55_Type ;
    rdfs:label "ruse" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ruses" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "rusəs" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ruse" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "rusə" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a small metal plate or ring through which a nail is passed and clinched to form a rivet, especially in clinker boatbuilding (OED s.v. ruse, MED s.v. rove n.(2))" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300036363 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/ruse> ;
    hector:attestationCount 2 .

