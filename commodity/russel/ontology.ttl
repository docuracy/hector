    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a kind of woollen fabric (a worsted, among other things) formerly used for articles of attire, especially in the 16th century (OED s.v. russel²); of obscure origin, possibly from Rijssel, the Flemish name of Lille" ;
            crm:P2_has_type aat:300435416 ] ;
