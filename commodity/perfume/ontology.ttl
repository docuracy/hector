<https://w3id.org/hector/commodity/perfume> a crm:E55_Type ;
    rdfs:label "perfume" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "perfumes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "perfuməs" ;
            hector:validFrom "1547"^^xsd:gYear ;
            hector:validThrough "1548"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "perfume" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "perfumə" ;
            hector:validFrom "1547"^^xsd:gYear ;
            hector:validThrough "1548"^^xsd:gYear ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/perfume> ;
    la:equivalent aat:300015166 ;
    hector:attestationCount 2 .

