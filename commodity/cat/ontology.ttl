<https://w3id.org/hector/commodity/cat> a crm:E55_Type ;
    rdfs:label "cat" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "katte" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "katə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cat" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "kat" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Genus of six Old World species, including the wildcat and domestic cat. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300395532 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/cat> ;
    la:equivalent aat:300265717 ;
    hector:attestationCount 1 .

