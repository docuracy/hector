  <rdf:Description rdf:nodeID="commodity_aloeswood_cbf95516d0ec39f6a6fc81a1fae7f877999bf7833393c6d3482ce5a6f8ddaa5326">
    <crm:P190_has_symbolic_content>Lignum aloes / aloeswood / agalloch: the fragrant wood of the agalloch, from East Indian Aloexylon and Aquilaria species (OED s.v. aloe; Heyd 557-8, Pegolotti 412, Stieda 95), used medicinally and as incense. Distinct from the purgative drug aloes (see aloes) and from lignum vitae.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
