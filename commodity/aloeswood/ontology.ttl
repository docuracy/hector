    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Lignum aloes / aloeswood / agalloch: the fragrant wood of the agalloch, from East Indian Aloexylon and Aquilaria species (OED s.v. aloe; Heyd 557-8, Pegolotti 412, Stieda 95), used medicinally and as incense. Distinct from the purgative drug aloes (see aloes) and from lignum vitae." ;
            crm:P2_has_type aat:300435416 ] ;
