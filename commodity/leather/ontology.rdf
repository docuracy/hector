  <rdf:Description rdf:nodeID="commodity_leather_cbee0ce36ff4023a533844e4fc53a9420a47b8edf596c42ed664ff585ba149df3d">
    <crm:P190_has_symbolic_content>The skin or hide of an animal that has been tanned to render it resistant to putrefication and relatively soft and flexible when dry. For composite material made from scrap leather pieces, use "maril." [Source: Getty AAT]</crm:P190_has_symbolic_content>
