@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/petraria> a crm:E55_Type ;
    rdfs:label "petraria" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petrarie" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petrariː" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petraria" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "petraria" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petrariae" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petrarie" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "denotes precious stones or gems collectively (Latham Word-List s.v. petra)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/petraria> ;
    la:equivalent aat:300133732 ;
    hector:attestationCount 1 .

aat:300133732 a crm:E55_Type ;
    rdfs:label "precious stone (material)" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/petraria> a crm:E55_Type ;
    rdfs:label "petraria (London Customs Accounts glossary)" .

hector:AttestedVariant a crm:E55_Type ;
    rdfs:label "attested variant" .

