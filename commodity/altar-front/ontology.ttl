<https://w3id.org/hector/commodity/altar-front> a crm:E55_Type ;
    rdfs:label "altar front" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "altar front" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "altar front" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "frontelle pro altare" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "frontelə pro altarə" ;
            hector:validFrom "1446"^^xsd:gYear ;
            hector:validThrough "1450"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Panels or hangings for the front of a Christian altar, pulpit, or lectern; may be carved, painted, embroidered, or otherwise decorated. Antependia are of various materials including wood, ivory, precious metals, and embroidered textiles. The exposed position of precious antependia meant that they were sometimes moved on top of the altar for safety, thus becoming retables. If the coverings are continued around the sides and back they are called \"paraments\" or paliotti. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/altar%20front> ;
    la:equivalent aat:300265255 ;
    hector:attestationCount 1 .

