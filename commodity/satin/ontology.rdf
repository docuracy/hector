  <rdf:Description rdf:nodeID="commodity_satin_cba8893d733a5b4d76e20b56d33ac97d1614b6adeb069143a93de6e79babf3eefd">
    <crm:P190_has_symbolic_content>satin, a silk fabric with a glossy surface on one side (OED s.v. satin n.); Bruges satin made with a warp of silk and a woof of thread (OED s.v. silk 1b); measured in lb; dyed or not dyed with kermes (q.v.); also made in Cyprus</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
