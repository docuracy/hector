  <rdf:Description rdf:nodeID="commodity_panier_cb3dfd3a406fbdda9f66f74d50b901502e92e0bacce2bdf72595a1bf3ef5dc795c">
    <crm:P190_has_symbolic_content>a large basket, for carrying provisions, fish, or other commodities; in later use mostly restricted to those carried by a beast of burden (usually in pairs, one on each side, slung across the back), of no particular size (OED s.v. pannier n.1; MED s.v. panier(e, n.); here as a packing unit for glass candles, dry goods, furs, cheese, glass, mirrors, haberdashery, and fish</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
