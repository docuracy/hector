            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Board game, held to be one of the oldest and most popular, played by two opponents on a checkered board with specially designed pieces of contrasting colors, commonly white and black. Players alternate turns in accordance with fixed rules, each player attempting to force the opponent's principal piece, the King, into checkmate, which is a position where it is unable to avoid capture. It first appeared in India in the 6th century CE; by the 10th century, it had spread from Asia to the Middle East and Europe. It remains popular and the focus of popular amateur and professional competitions. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/chess> ;
