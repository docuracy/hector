  <rdf:Description rdf:nodeID="commodity_garbelle_cb0">
    <crm:P190_has_symbolic_content>‘garbled’ cloves, i.e. the refuse of cloves, extraneous matter (OED s.v. garble n.) | probably 'garbled' cloves, i.e. refuse, with extraneous matter (OED s.v. garble n.) | 'garbled' spices, i.e. the refuse of spices, extraneous matter (followed by genetive of spice name) (OED s.v. garble) see alum debilis; grani paradisi, maces, spyknard | refuse spices, such with extraneous matter (OED s.v. garble n.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
