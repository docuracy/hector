  <rdf:Description rdf:nodeID="commodity_pilchard_cb2329c40d0bb5ccff0430be8add47f8f839e8fd0b3cd1342825fa5b9d98b8c9ea">
    <crm:P190_has_symbolic_content>a small sea fish, Clupea pilchardus, closely allied to the herring, but smaller, and rounder in form; it is taken in large numbers on the coasts of Cornwall and Devon, and forms a considerable article of trade (OED s.v. pilchard)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
