  <rdf:Description rdf:nodeID="commodity_grey_cb0">
    <crm:P190_has_symbolic_content>winter squirrel skins, with the grey back (Veale, 224) | reddish-brown squirrel skins from Central Europe (Veale 225) | winter squirrel skins, with the grey back (Veale, 224) (see also peltrie de gray) | winter squirrel skins, with the grey back (Veale 224) | co(u)rse (course graye) of low quality | skins of the civet cat, the grey skins being less valuable than the black (Veale 219) | the back of the skin of the winter squirrel, grey in color (Veale 224, 222) | winter squirrel skins, with the grey back (Veale 224), here dressed</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
