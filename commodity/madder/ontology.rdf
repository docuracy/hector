  <rdf:Description rdf:nodeID="commodity_madder_cb1528414f14fa719a77d4560077650461788ece9fab7f153080dffe1b8c66cee6b">
    <crm:P190_has_symbolic_content>A natural organic colorant extracted from the roots of any of several species of the genus Rubia, having a reddish color. Madder has been used as a colorant for dyeing textiles since ancient times in India, Persia, and Egypt. It has been largely replaced as a dye and a pigment by synthetic alizarin. Used for dye and lake pigment preparation. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
