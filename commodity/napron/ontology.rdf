  <rdf:Description rdf:nodeID="commodity_napron_cb957153a1b4bd31051ed9e8749192d7e1672d22bb982bcaf83cb024afb6955037">
    <crm:P190_has_symbolic_content>apron [of mail] | clearly some sort of armor made of mail, worn in front of the body, but exact meaning unknown (Cobb 174 does not define, but does cross-references to 'faulds', which he defines as 'skirts of metal hoops')</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
