  <rdf:Description rdf:nodeID="commodity_sponge_cb13223d6f27a0bf9512086682e2d320d008538954dff6f9299a23234fa53e40df4">
    <crm:P190_has_symbolic_content>Material comprising a porous structure composed of siliceous cells bound in a spongin (fibrous protein) matrix of certain animals or the absorbent cellulose fibers from several types of fruits or gourds. The term may also be applied to similar artificial materials. Natural sponges have been used for their absorbent characteristics since ancient times, for example, for applying paint, cleaning, and for drinking. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
