<https://w3id.org/hector/commodity/book-of-gold> a crm:E55_Type ;
    rdfs:label "book of gold" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "book of gold" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "boːk of gold" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bokes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "bokəs" ;
            hector:validFrom "1513"^^xsd:gYear ;
            hector:validThrough "1514"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "boke" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "bokə" ;
            hector:validFrom "1513"^^xsd:gYear ;
            hector:validThrough "1514"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a packet of gold leaf or gold foil, put up between leaves of soft paper (OED s.v. book n. 13; note that while the OED says a book consists of 25 leaves, but p. 354 states that 8 dozen bettyn auri contain 2 bokes)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/book%20of%20gold> ;
    skos:related <https://w3id.org/hector/commodity/gold-leaf> ;
