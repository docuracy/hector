            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "plumbum" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1559"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "plumby" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "plumbi" ;
            hector:validFrom "1412"^^xsd:gYear ;
            hector:validThrough "1427"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
