  <rdf:Description rdf:nodeID="commodity_knot_cb6ca3f2e32dd028eb1be6e9fc9a485c24a51cdeda48399948365efd5a5ca5cf88">
    <crm:P190_has_symbolic_content>a definite quantity of thread, yarn, etc., varying with the commodity, being a certain number of coils tied by a knot, here a measure for napery (OED s.v. knot n.1 4) | a definite quantity of thread, yarn, etc., varying with the commodity, being a certain number of coils tied by a knot, here a measure for napery damask (OED s.v. knot n.1 4) | a definite quantity of thread, yarn, etc., varying with the commodity, being a certain number of coils tied by a knot, here a measure for napery damask (OED s.v. knot n.1 4) as a measure of napery | as a measure of Dinant napery</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
