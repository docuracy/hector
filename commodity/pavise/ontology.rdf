  <rdf:Description rdf:nodeID="commodity_pavise_cb40659b4f8bc9df3193fb0f03aed0396d919eadcb62066e8587c9a801e1d6ef47">
    <crm:P190_has_symbolic_content>a convex shield, large enough to cover the whole body, used in medieval times as a defence against archery, and especially in sieges (OED s.v. pavis, pavise n.)</crm:P190_has_symbolic_content>
