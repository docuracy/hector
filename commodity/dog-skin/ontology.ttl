    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the skin of a dog, or the leather made from it; also applied to a kind of leather made from sheep-skin (OED s.v. dog-skin) (see also pellis)" ;
