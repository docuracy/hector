        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dog skynn" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dog skin" ;
            hector:validFrom "1446"^^xsd:gYear ;
            hector:validThrough "1450"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "caninis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kaninis" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "canum" ;
