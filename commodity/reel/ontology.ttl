            hector:validThrough "1430"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Devices designed to support a skein of yarn while it is being unwound during use and/or wound into a ball for future use. These devices traditionally comprised a circular board nailed to a piece of oak to be handled manually, but are now electric and equipped with automated pre-selection counters for setting the desired yarn length.  [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
