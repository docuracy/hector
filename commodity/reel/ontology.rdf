  <rdf:Description rdf:nodeID="commodity_reel_cbd3c74145e40075fa14daf647961cffc83da2cbe792b43014c8249892d4bfbb8a">
    <crm:P190_has_symbolic_content>Devices designed to support a skein of yarn while it is being unwound during use and/or wound into a ball for future use. These devices traditionally comprised a circular board nailed to a piece of oak to be handled manually, but are now electric and equipped with automated pre-selection counters for setting the desired yarn length.  [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
