<https://w3id.org/hector/commodity/packing> a crm:E55_Type ;
    rdfs:label "packing" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pakkyng" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pakiŋ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "packyng" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pakiŋ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "packing" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "pakiŋ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pakking" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pakiŋ" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Any material used to protect, cushion, or brace objects for safe shipment or storage. For packing material that carries information or otherwise conveys a message about the product, use \"packaging.\" [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/packing> ;
    la:equivalent aat:300254740 ;
    hector:attestationCount 15 .

