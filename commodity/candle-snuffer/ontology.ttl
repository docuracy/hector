    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Devices for trimming the wicks of candles and lamps to keep the end of the wick even and clean; usually in the form of scissors with one blade bearing a boxlike receptacle to catch the cut-off ends of the charred wick. For scissorlike devices with flat disc-shaped ends used for pinching out a candle flame, use \"douters.\" For cone-shaped devices used to extinguish flames, use \"extinguishers.\" [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
