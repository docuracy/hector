  <rdf:Description rdf:nodeID="commodity_candle_snuffer_cbc2dd7e93c912b31dd4a9d7e9a80da3922af631ef65111291e7c12aba718aef10">
    <crm:P190_has_symbolic_content>Devices for trimming the wicks of candles and lamps to keep the end of the wick even and clean; usually in the form of scissors with one blade bearing a boxlike receptacle to catch the cut-off ends of the charred wick. For scissorlike devices with flat disc-shaped ends used for pinching out a candle flame, use "douters." For cone-shaped devices used to extinguish flames, use "extinguishers." [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
