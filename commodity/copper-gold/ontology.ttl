<https://w3id.org/hector/commodity/copper-gold> a crm:E55_Type ;
    rdfs:label "copper gold" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cowper gold" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kuːper gold" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "copper auri" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "koper auri" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "copper gold" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "koper gold" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "gold alloyed with copper (OED s.v. gold1 5)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300010902,
        aat:300010963 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/copper%20gold> ;
    hector:attestationCount 14 .

aat:300010902 a crm:E55_Type ;
