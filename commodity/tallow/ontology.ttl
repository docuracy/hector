    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A hard fat obtained from animals, especially sheep, goats, and cattle, containing the fatty acids oleic acid, palmitic acid, stearic acid, linoleic acid, and myristic acid. Tallow is used in leather dressing and in the manufacture of soaps, lubricants, candles, and food.  [Source: Getty AAT]" ;
