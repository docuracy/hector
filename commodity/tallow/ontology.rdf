  <rdf:Description rdf:nodeID="commodity_tallow_cb1b327097910bb35b4709796caee15702d9ebb5de705e15318bc90a3e60d44e0e5">
    <crm:P190_has_symbolic_content>A hard fat obtained from animals, especially sheep, goats, and cattle, containing the fatty acids oleic acid, palmitic acid, stearic acid, linoleic acid, and myristic acid. Tallow is used in leather dressing and in the manufacture of soaps, lubricants, candles, and food.  [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
