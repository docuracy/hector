  <rdf:Description rdf:nodeID="commodity_coal_cbf708cf385702de755840276826292f551f740f1d749160225731ecd1561e08cb">
    <crm:P190_has_symbolic_content>Carbon-rich material that most often occurs in stratified sedimentary deposits. It is one of the most important of the primary fossil fuels. It is characterized by being solid, hard, opaque, black, or blackish, found in seams or strata in the earth, and largely used as fuel; it consists of carbonized vegetable matter deposited in former epochs of the world's history. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
