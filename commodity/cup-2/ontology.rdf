  <rdf:Description rdf:nodeID="commodity_cup_2_cb7e978d3bd046da28cffca5bb86dd58235c685d0c270abcceff2343bbed054f83">
    <crm:P190_has_symbolic_content>Open bowl-shaped vessels, used chiefly for drinking, often having one handle, but sometimes two handles or none, generally on a low foot-ring; also includes similar bowl-shaped vessels, generally without handles, resting on a stem and supported by a spreading foot. Occasionally made with a lid. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
