<https://w3id.org/hector/commodity/cradle-band> a crm:E55_Type ;
    rdfs:label "cradle band" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cradle band" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "kradlə band" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cradel bondes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kradel bondəs" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cradel bond" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kradel bond" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Term for clothes worn by infants that restrict movement to some extent, including either clothing consisting of narrow strips of cloth used to swaddle an infant or an infant's long clothes. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/cradle%20band> ;
