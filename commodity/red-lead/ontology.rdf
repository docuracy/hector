  <rdf:Description rdf:nodeID="commodity_red_lead_cb6827347773a240bb9ea59448df49a6849cff92ab84f55f0af92aa5dbd491c99c">
    <crm:P190_has_symbolic_content>red lead</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300404670"/>
    <crm:P2_has_type rdf:resource="https://w3id.org/hector/ontology#AttestedVariant"/>
