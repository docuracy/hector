  <rdf:Description rdf:nodeID="commodity_emery_cb18c44c7bd48fb679fb7b338781d4e6be1364273c34977ac051a78bf5b67267442">
    <crm:P190_has_symbolic_content>A gray-to-black impure variety of corundum which contains magnetite and hematite and is used as an abrasive. The stone is crushed and graded and used to make emery paper, emery cloth, and emery wheels. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
