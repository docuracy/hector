  <rdf:Description rdf:nodeID="commodity_pumice_cb0">
    <crm:P190_has_symbolic_content>pumice, a light kind of lava (obsidian made spongy or porous by escape of steam or gas during cooling); as a material used for smoothing or polishing (parchment etc.), as an absorbent of ink, moisture etc. (OED s.v. pumice n.) | pumice, a light kind of lava, used for smoothing or polishing (parchment etc.), or removing stains; as an absorbent of ink, moisture etc. (OED s.v. pumice n.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
