    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Equipment comprising pieces of openwork fabric made of twine, synthetic fibres, strong cord, or another material that forms meshes of a suitable size; they are placed in the water and used for catching fish. Fishing nets are among the oldest known human technologies. [Source: Getty AAT]" ;
