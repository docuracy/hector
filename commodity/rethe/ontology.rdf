  <rdf:Description rdf:nodeID="commodity_rethe_cba764a68b66233bfb318ba8a36b8a4d0a6cdaa9c0844a693be3c56e6a7986532e">
    <crm:P190_has_symbolic_content>Equipment comprising pieces of openwork fabric made of twine, synthetic fibres, strong cord, or another material that forms meshes of a suitable size; they are placed in the water and used for catching fish. Fishing nets are among the oldest known human technologies. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
