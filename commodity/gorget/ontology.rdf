  <rdf:Description rdf:nodeID="commodity_gorget_cbcfc48bc2014aee7b54ebdde3349f88a6b24acdaf7764e5fb643f587c773dde5a">
    <crm:P190_has_symbolic_content>Components of some close helmets and closed burgonets, protecting the neck, consisting of two or three articulated metal lames riveted at the front to the bevor and at the rear to the skull. They also form the lower part of the falling buffe for a burgonet. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
