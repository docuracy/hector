  <rdf:Description rdf:nodeID="commodity_ling_cb1b17a2b39eb477e178dac8ba78c9cd63e71de378e4cfcbb547e717afdbd0699f7">
    <crm:P190_has_symbolic_content>a long slender gadoid fish, Molva vulgaris or Lota molva, inhabiting the seas of northern Europe (OED s.v. ling^1 1) | a long slender gadoid fish, Molva vulgaris or Lota molva, inhabiting the seas of northern Europe (OED s.v. ling1 1) | a long slender gadoid fish, Molva vulgaris or Lota molva, inhabiting the seas of northern Europe, largely used for food (OED ling n.1) | a long slender gadoid fish, Molva vulgaris or Lota molva, inhabiting the seas of northern Europe, largely used for food (OED ling n.1) (see also piscis) | a long slender gadoid fish, Molva vulgaris or Lota molva, inhabiting the seas of northern Europe, largely used for food (OED ling n.1). Note that Latham, Word-List and Latham, Dictionary, record only the (feminine) form linga | a long slender gadoid fish, Molva vulgaris or Lota molva, inhabiting the seas of northern Europe, largely used for food (OED ling n.1), salted | a long slender gadoid fish, Molva vulgaris or Lota molva, inhabiting the seas of northern Europe (OED s.v. ling1 1), here dried</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
