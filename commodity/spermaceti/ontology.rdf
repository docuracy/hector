  <rdf:Description rdf:nodeID="commodity_spermaceti_cb65399e483d20e7301a06788b052cd33394475d74463bd956763b7a8eaa3cb02f">
    <crm:P190_has_symbolic_content>meaning unknown | (parmacet(e)) spermaceti, a fatty substance, which in a purified state has the form of a soft white scaly mass, found in the head of the sperm whale, used in medicinal preparations and in the manufacture of candles (OED spermaceti) | a fatty substance, which in a purified state has the form of a soft white scaly mass, found in the head of the sperm whale, used in medicinal preparations and in the manufacture of candles (OED s.v. spermaceti) | a fatty substance, which in a purified state has the form of a soft white scaly mass, found in the head of the sperm whale, used in medicinal preparations and in the manufacture of candles (OED spermaceti)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
