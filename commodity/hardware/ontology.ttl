<https://w3id.org/hector/commodity/hardware> a crm:E55_Type ;
    rdfs:label "hardware" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hardeware" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "hardeuarə" ;
            hector:validFrom "1442"^^xsd:gYear ;
            hector:validThrough "1445"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hardware" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "hardwarə" ;
            hector:validFrom "1461"^^xsd:gYear ;
            hector:validThrough "1465"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hardwar" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "hardwar" ;
            hector:validFrom "1465"^^xsd:gYear ;
            hector:validThrough "1472"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Large and small items that are necessary to attach, anchor, hold, or join materials and components of structures, furniture, and other objects. Also, items used in the finishing of buildings and objects, such as hinges and knobs. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/hardware> ;
    la:equivalent aat:300033260 ;
    hector:attestationCount 24 .

