<https://w3id.org/hector/commodity/sail-yard> a crm:E55_Type ;
    rdfs:label "sail yard" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "sail yard" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "sail jard" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "sayle yerde" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sailə jerdə" ;
            hector:validFrom "1536"^^xsd:gYear ;
            hector:validThrough "1540"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "one of the yards or spars on which the sails are spread (OED s.v. sailyard)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/sail%20yard> ;
    la:equivalent aat:300213068 ;
    hector:attestationCount 1 .

aat:300213068 a crm:E55_Type ;
    rdfs:label "spars (watercraft components)" .

