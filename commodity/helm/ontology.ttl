            hector:phoneticKey "helmet" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "helmes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "helməs" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1398"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
