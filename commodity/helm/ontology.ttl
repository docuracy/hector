            hector:validThrough "1398"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Heavy helmets completely enclosing the head and face, originally flat-topped, later having a conical or rounded top; used in warfare from the late 12th to the mid-14th century, and continued in use in tournaments until the mid-16th century. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
