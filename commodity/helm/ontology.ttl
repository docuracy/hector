<https://w3id.org/hector/commodity/helm> a crm:E55_Type ;
    rdfs:label "helm" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "helmet" ;
