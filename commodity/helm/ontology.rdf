  <rdf:Description rdf:nodeID="commodity_helm_cb55bcba66810097bc1857139ce5bf49bb78f39276560dc92248f6d18a5a680681">
    <crm:P190_has_symbolic_content>Heavy helmets completely enclosing the head and face, originally flat-topped, later having a conical or rounded top; used in warfare from the late 12th to the mid-14th century, and continued in use in tournaments until the mid-16th century. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
