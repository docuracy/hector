<https://w3id.org/hector/commodity/bird-bolt> a crm:E55_Type ;
    rdfs:label "bird-bolt" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petilium" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petilium" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petilii" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petili" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bird-bolt" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "bird bolt" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "bird-bolt, a kind of blunt-headed arrow used for shooting birds (OED s.v. bird-bolt)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/bird-bolt> ;
