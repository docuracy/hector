    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Filum (Latin): thread or yarn. Traded in many materials (linen, cotton, wool, silk, worsted/crewel, and metal threads of gold, silver, copper and latten), colours, qualities, forms (skeins, bottoms, ribbon, wire) and uses (sewing, binding, piecing, packthread, sail-, net- and crossbow-thread), and from many places of manufacture (Cologne, Bruges, Oudenarde, Doornik, Burgundy, Prussia, Paris, Lyons, etc.)." ;
            crm:P2_has_type aat:300435416 ] ;
