  <rdf:Description rdf:nodeID="commodity_verjuice_cb0">
    <crm:P190_has_symbolic_content>verjuice, the acid juice of green or unripe grapes, crab-apples, or other sour fruit, expressed and formed into a liquor; formerly much used in cooking, as a condiment, or for medicinal purposes (OED s.v. verjuice n.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
