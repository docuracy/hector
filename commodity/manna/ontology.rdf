  <rdf:Description rdf:nodeID="commodity_manna_cb0">
    <crm:P190_has_symbolic_content>a sweet pale yellow or whitish concrete juice obtained from incisions in the bark of the Manna-ash, Fraxinus Ornus, formerly in the Near East, now chiefly in Calabria and Sicily; used in medicine as a gentle laxative (OED s.v. manna n.^1 4a; Heyd 615-6) | a sweet pale yellow or whitish concrete juice obtained from incisions in the bark of the Manna-ash, Fraxinus Ornus, formerly in the Near East, now chiefly in Calabria and Sicily; used in medicine as a gentle laxative (OED s.v. manna n.1 4a; Heyd 615-6)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
