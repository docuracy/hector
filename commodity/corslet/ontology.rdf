  <rdf:Description rdf:nodeID="commodity_corslet_cbf65b7850afa514b7458c235fa24b756b7c1c655b08bc5f677f77b1ca34bb6926">
    <crm:P190_has_symbolic_content>Light half armor worn by heavy infantry from the early 16th to the mid-17th century in Europe, at first comprised of a gorget, spaudlers, breastplate, backplate, tassets, vambraces, gauntlets, and an open helmet, but no legharness. In the 17th century, arm defenses were usually omitted. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
