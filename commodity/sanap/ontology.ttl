            hector:phoneticKey "sanape" ;
            hector:validFrom "1400"^^xsd:gYear ;
            hector:validThrough "1421"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "sanapa" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sanapa" ;
            hector:validFrom "1400"^^xsd:gYear ;
            hector:validThrough "1421"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a strip of cloth placed over the outer part of the tablecloth to preserve it from being spoiled (OED s.v. sanap), here made of serge (q.v.)" ;
