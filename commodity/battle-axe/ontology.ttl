    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Axes used in combat and warfare since prehistoric times, made in various forms and sizes from one geographic region and culture to another, but typically having a broad blade with a convex cutting edge and a handle, and wielded with one or two hands to strike cutting blows or to throw. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
