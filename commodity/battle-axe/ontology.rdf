  <rdf:Description rdf:nodeID="commodity_battle_axe_cb4878ac2d16bf224c91fa90583072e70530ab82289637a2543769225e48bf901c">
    <crm:P190_has_symbolic_content>Axes used in combat and warfare since prehistoric times, made in various forms and sizes from one geographic region and culture to another, but typically having a broad blade with a convex cutting edge and a handle, and wielded with one or two hands to strike cutting blows or to throw. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
