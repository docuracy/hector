<https://w3id.org/hector/commodity/terlyson> a crm:E55_Type ;
    rdfs:label "terlyson" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "terlyson" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "terlison" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "probably some kind of cloth (since 19 pieces are imported together with fustian from Ulm and Augsburg), but Cobb's definition (187) 'treillis, a stout or coarse kind of cloth similar to buckram' seems unlikely since both accounts record terlyson and not trelyson (with no abbreviations) and no variant of treillis recorded by OED s.v. treille, treillis reverses the 'r' and the 'e'" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/terlyson> ;
    la:equivalent aat:300162391 ;
    hector:attestationCount 1 .

