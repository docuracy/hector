    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Refers to panels of oak or other wood that is used to line the walls of a room. It often refers specifically to the decorative or protective facings applied to the lower portion of an interior partition or wall, whether of wood or another material. The term originally referred to a superior quality of oak from Russia, Germany, and Holland, that was used primarily for fine panel-work. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/wainscot> ;
