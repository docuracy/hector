  <rdf:Description rdf:nodeID="commodity_wainscot_cb17c452309b0859a560f193d15f3ecc6ea00481e28d45a44448f908c19cade8fa2">
    <crm:P190_has_symbolic_content>Refers to panels of oak or other wood that is used to line the walls of a room. It often refers specifically to the decorative or protective facings applied to the lower portion of an interior partition or wall, whether of wood or another material. The term originally referred to a superior quality of oak from Russia, Germany, and Holland, that was used primarily for fine panel-work. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
