<https://w3id.org/hector/commodity/water-cloth> a crm:E55_Type ;
    rdfs:label "water cloth" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "water laken" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "water laken" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "water cloth" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "water kloθ" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "waterlagen" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "waterladʒen" ;
            hector:validFrom "1520"^^xsd:gYear ;
            hector:validThrough "1524"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "clearly some kind of cloth, but exact meaning unknown (OED s.v. water n. 4c 'towel' seems very unlikely)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/water%20cloth> ;
    la:equivalent aat:300162391 ;
    hector:attestationCount 8 .

