<https://w3id.org/hector/commodity/serpentine> a crm:E55_Type ;
    rdfs:label "serpentine" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "serpentyne" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "serpentinə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "serpentyns" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "serpentins" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "serpentine" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "serpentinə" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Cannons in use from the 15th to the 17th century, produced in various sizes and calibers but typically long in relation to their caliber and longer and lighter than bombards. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/serpentine> ;
    skos:related <https://w3id.org/hector/commodity/bombard>,
        <https://w3id.org/hector/commodity/gun> ;
    la:equivalent aat:300036939 ;
    hector:attestationCount 1 .

