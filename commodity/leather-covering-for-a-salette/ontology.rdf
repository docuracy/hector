  <rdf:Description rdf:nodeID="commodity_leather_covering_for_a_salette_cb0">
    <crm:P190_has_symbolic_content>leather covering for a salette, in medieval armor, a light globular head-piece, either with or without a vizor, and without a crest, the lower part curving outwards behind (OED s.v. sallet; MED s.v. salette)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
