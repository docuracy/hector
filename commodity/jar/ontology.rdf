  <rdf:Description rdf:nodeID="commodity_jar_cb3d57d5a7f756f9b7d749eef7ee96f74429a1299ad4b4a49e1a7b61c90bf2f106">
    <crm:P190_has_symbolic_content>Deep, wide-mouthed vessels used for holding a variety of substances, usually without handles and generally cylindrical, although sometimes made in other shapes. For narrower-necked vessels, use "bottles." [Source: Getty AAT]</crm:P190_has_symbolic_content>
