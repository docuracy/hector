  <rdf:Description rdf:nodeID="commodity_finger_ring_cb1ca9ef538d3a2378349532e307b0169558e69ed56c09d81963f1a896c95f25f3">
    <crm:P190_has_symbolic_content>finger ring: a ring worn on the finger (Latin anulus), of gold, silver or base metal, often gilded and set with precious stones — rubies, balas rubies, sapphires, emeralds, turquoises, pearls, garnets or diamonds — or with glass paste; quality ranges from coarse to fine. The English forms ring/ringes are shared with the generic ring concept.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
