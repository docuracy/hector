  <rdf:Description rdf:nodeID="commodity_block_cbbd44946fbcaf98bdf83549ba9ec972fe7e1e2deb08e6901b0a4173ab0ae29ab2">
    <crm:P190_has_symbolic_content>a measure of tin (worth £2 10s) | raw Cornish tin in large rectangular blocks weighing roughly 200-300 lb. (see also stannum) | tin of second quality cast into blocks; solid tin as distinct from tin plate (OED s.v. tin n. 1b) | a packing unit for box wood of no particular size</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
