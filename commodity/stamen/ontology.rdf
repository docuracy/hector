  <rdf:Description rdf:nodeID="commodity_stamen_cb86fbd0f1dcf33c5eb53fb1278bafbbbdf3f27346104f1e23e41e49b75fa196df">
    <crm:P190_has_symbolic_content>a coarse, unlined cloth of worsted; in later use (from 1440) a kind of woollen or worsted cloth for outer garments, curtains etc. (OED s.v. stamin), with examples manufactured in St Omer (OED s.v. saint a. and n. 4c) | a coarse woollen cloth (OED s.v. stammel)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
