  <rdf:Description rdf:nodeID="commodity_trendel_cb60ca9b4cb428bb6c7a0ff4cd8a2d378fcacffa7090c90ca7574ea2ccf5bfa6ba">
    <crm:P190_has_symbolic_content>a rounded bowl or platter (MED s.v. trendel n.); a vessel of flat rounded form, a round or oval tub used for various purposes, here as a packing unit for wax (OED s.v. trendle n. 4; Gras 763); also used as a packing unit for splintes pro hattes, but exact meaning in that context unknown</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
