  <rdf:Description rdf:nodeID="commodity_claw_cba4811b8430eb536570183672768817be6236e154b263b4021fd12418188fe672">
    <crm:P190_has_symbolic_content>Sharp, horny, narrow, arched structures on the digits of birds, reptiles, many mammals, and some amphibians. Claws are composed of hardened (keratinized) modifications of the epidermis. Claws may be adapted for scratching, clutching, digging, or climbing. The term is also used for similar structures on the feet of insects, crustacea, and other lower animals. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
