<https://w3id.org/hector/commodity/claw> a crm:E55_Type ;
    rdfs:label "claw" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cles" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kles" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cle" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kle" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "claw" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "klau" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Sharp, horny, narrow, arched structures on the digits of birds, reptiles, many mammals, and some amphibians. Claws are composed of hardened (keratinized) modifications of the epidermis. Claws may be adapted for scratching, clutching, digging, or climbing. The term is also used for similar structures on the feet of insects, crustacea, and other lower animals. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/claw> ;
    la:equivalent aat:300379351 ;
    hector:attestationCount 1 .

