  <rdf:Description rdf:nodeID="commodity_skrene_cb2c2b25cbede5bb264d59bf066331032be9e2510c7cf558640d9d4296d33cf0fe">
    <crm:P190_has_symbolic_content>Refers to furniture or built-in features in the form of an upright partition that can be used to embellish, partition, shelter, and provide privacy. Screens are often highly decorated. [Source: Getty AAT] | some sort of mirror, but exact meaning unknown | clearly some sort of mirror, since 1 barrel of mirrors containing 806 skrenys was imported, but exact meaning unknown</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
