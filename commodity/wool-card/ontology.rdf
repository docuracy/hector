  <rdf:Description rdf:nodeID="commodity_wool_card_cbafdd8ba499d6ac8ef21826d7b2db8d7819ebebb17536ac910453b7d420595144">
    <crm:P190_has_symbolic_content>an implement for raising a nap on cloth, consisting of teasel-heads set in a frame; an instrument with iron teeth, used in pairs to part, comb out, and set in order the fibres of wool, hemp, etc., one of the cards being held in the hand, and the other fastened to a 'stock' or support (OED s.v. card n.1 1 &amp; 2); also lambfell (OED s.v. lambfell); meaning of some forms unknown</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
