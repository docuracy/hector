  <rdf:Description rdf:nodeID="commodity_wood_cbf77771791ebff45c5eccd9e873acabd1aae5b668d677ea69f9d2598c1285f078">
    <crm:P190_has_symbolic_content>Wood / timber (Latin lignum, boscus): unworked or roughly-worked wood, and small wooden wares. The homonymous dyestuff is the separate concept woad; the exotic medicinal woods are lignum aloes and lignum vitae.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
