  <rdf:Description rdf:nodeID="commodity_earthenware_cbd6671e3cfe04b46222dd2527315364b6e46dca60964bcd85428618feb46b03fe">
    <crm:P190_has_symbolic_content>Pottery with a porous body, fired below 1200 degrees Centigrade. It is not vitrified, and must be glazed to render it nonporous. [Source: Getty AAT]</crm:P190_has_symbolic_content>
