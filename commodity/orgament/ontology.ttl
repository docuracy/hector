            hector:validFrom "1507"^^xsd:gYear ;
            hector:validThrough "1508"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "marjoram, a spice (OED s.v. orgament, origan)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300386730 ;
