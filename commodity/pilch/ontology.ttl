    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Infants' garments worn over a diaper, usually triangular wrappers made of flannel, boiled wool, or tightly knitted wool, used in Western nations until the 1890s when more waterproof materials such as rubberized cloth were available. In modern usage, the term is sometimes used to refer to colorful pants lined with plastic or other waterproof material and used to cover infants' diapers. The term also refers to earlier outer garments for adults, made of animal skin with the fur turned inside and used as a lining.  [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
