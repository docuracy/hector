    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Members of a species of the weasel family with reddish brown that in winter in northern regions turns wholly white, except the tip of the tail, which is always black. The whiteness of ermine is often a symbol of purity in art and poetry. [Source: Getty AAT]" ;
