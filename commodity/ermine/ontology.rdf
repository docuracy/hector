  <rdf:Description rdf:nodeID="commodity_ermine_cb16b2ec167b4059a0949387376da474b650b389081c4b59ca87cd8a7a9b14e07e8">
    <crm:P190_has_symbolic_content>Members of a species of the weasel family with reddish brown that in winter in northern regions turns wholly white, except the tip of the tail, which is always black. The whiteness of ermine is often a symbol of purity in art and poetry. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
