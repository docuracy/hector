  <rdf:Description rdf:nodeID="commodity_basnet_cb89efb3421a2fbfcd0ac8cd5c9728794c679fb0a6adf3895facfc150338fefc43">
    <crm:P190_has_symbolic_content>Helmets, generally ogival or egg-shaped with a pointed apex, and often fitted with an aventail and a hinged or pivoted visor, usually a pig-faced visor; used from the 13th to the 15th century. In the 15th century they became more globular and the aventail was replaced by gorget plates. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
