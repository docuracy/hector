    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a painted or stained cloth: a decorative hanging for a room, painted or worked with figures, mottoes or texts (OED s.v. painted 5; cloth, painted); also an awning (pentice / penthouse cloth; Carlin 246). Attested as Latin pannus depictus (panno depicto, pannis depictis, pannorum depictorum, etc.), French drapz depictus, and English paynted/payntid cloth(es) and cloth(es) pictorum (painters' cloth)." ;
            crm:P2_has_type aat:300435416 ] ;
