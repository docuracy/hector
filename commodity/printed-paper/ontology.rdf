  <rdf:Description rdf:nodeID="commodity_printed_paper_cb0">
    <crm:P190_has_symbolic_content>printed paper: printed sheets, probably woodcuts — e.g. indulgence images showing the five wounds of Christ and the crown of thorns, with a caption promising remission of time in purgatory for devout contemplation (P. Blayley) (OED).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
