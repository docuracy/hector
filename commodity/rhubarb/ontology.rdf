  <rdf:Description rdf:nodeID="commodity_rhubarb_cb1590223c5256543f36a3ba637ab9eefcdd685d2aa1f80a97544e80ef6db6e9f13">
    <crm:P190_has_symbolic_content>rhubarb, the medicinal rootstock (purgative and subsequently astringent) of one or more species of Rheum grown in China and Tibet and imported (until 1860) through Russia and the Levant, used medicinally as a purgative (OED s.v. rhubarb n. 1a); also recorded as reobarbe; Latham, Word-List s.v. reu; probably a corrupted form of reu Ponticum</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
