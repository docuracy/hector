    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "rhubarb, the medicinal rootstock (purgative and subsequently astringent) of one or more species of Rheum grown in China and Tibet and imported (until 1860) through Russia and the Levant, used medicinally as a purgative (OED s.v. rhubarb n. 1a); also recorded as reobarbe; Latham, Word-List s.v. reu; probably a corrupted form of reu Ponticum" ;
            crm:P2_has_type aat:300435416 ] ;
