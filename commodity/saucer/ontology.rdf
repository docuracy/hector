  <rdf:Description rdf:nodeID="commodity_saucer_cb93dde39eace11469fd6132f0f36c3c44a54f8677f337e70fa6301f1bfb45747">
    <crm:P190_has_symbolic_content>a receptacle for holding the condiments of a meal; a dish or deep plate in which salt or sauces were placed upon the table (OED s.v. saucer n.); usually of metal, but also of tin or earthenware</crm:P190_has_symbolic_content>
