<https://w3id.org/hector/commodity/stone> a crm:E55_Type ;
    rdfs:label "stone" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petris" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petris" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "peterae" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petere" ;
            hector:validFrom "1442"^^xsd:gYear ;
            hector:validThrough "1445"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petera" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petera" ;
            hector:validFrom "1442"^^xsd:gYear ;
            hector:validThrough "1445"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petrae" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petre" ;
            hector:validFrom "1380"^^xsd:gYear ;
            hector:validThrough "1385"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "stone" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "stonə" ;
            hector:validFrom "1431"^^xsd:gYear ;
            hector:validThrough "1472"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "stones" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "stonəs" ;
            hector:validFrom "1477"^^xsd:gYear ;
            hector:validThrough "1479"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "petra" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petra" ;
            hector:validFrom "1380"^^xsd:gYear ;
            hector:validThrough "1477"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a unit of weight (14 lb.) (see also petra)" ;
            crm:P2_has_type aat:300435416 ] ;
    rdfs:seeAlso <https://w3id.org/hector/commodity/petra> ;
    skos:exactMatch <https://w3id.org/mlca/glossary/stone> ;
    skos:related <https://w3id.org/hector/commodity/cruse>,
        <https://w3id.org/hector/commodity/petra> ;
    la:equivalent aat:300386648 ;
    hector:attestationCount 877 .

aat:300386648 a crm:E55_Type ;
    rdfs:label "weights and measures (general, standards)" .

