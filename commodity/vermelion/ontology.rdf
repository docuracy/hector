  <rdf:Description rdf:nodeID="commodity_vermelion_cb5f527cc6ac49b12b4103d5f70cf8acd86c39011bea422eae3a7aa452d41c2b90">
    <crm:P190_has_symbolic_content>vermilion, cinnabar or red crystalline mercuric sulphide, esp. in later use that obtained artificially, much valued on account of its brilliant scarlet colour, and largely used as a pigment or in the manufacture of red sealing-wax (OED s.v. vermilion n. and a.) | a fabric dyed with vermilion</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
