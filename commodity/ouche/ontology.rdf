  <rdf:Description rdf:nodeID="commodity_ouche_cb903f49f6ba1f5a19c1c52d8859a145e1bc22476763ecb196f6921e33ec288c52">
    <crm:P190_has_symbolic_content>a clasp, buckle, fibula or brooch for holding together the two sides of a garment; also a buckle or brooch worn as an ornament, often set with precious stones (OED s.v. ouch n.1).</crm:P190_has_symbolic_content>
