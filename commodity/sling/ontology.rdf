  <rdf:Description rdf:nodeID="commodity_sling_cb7a6238fe2d17bf91d0611ae73b58398efa9dcfedb2f182aff443e4993719cb2f">
    <crm:P190_has_symbolic_content>Throwing weapons consisting basically of a strap of leather, fabric, or similar flexible material, widening into a pouch at the center to hold the projectile. They are held by the two ends and swung round rapidly, then one end is released to hurl the projectile. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
