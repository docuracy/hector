<https://w3id.org/hector/commodity/poppy-seed> a crm:E55_Type ;
    rdfs:label "poppy seed" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "popesedes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "popesedəs" ;
            hector:validFrom "1545"^^xsd:gYear ;
            hector:validThrough "1547"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poppis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "popis" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poppi" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "popi" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poppy seed" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "popi seːd" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the seeds of the poppy used as a spice (MED s.v. popi(e n. 1))" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300386730 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/poppy%20seed> ;
    la:equivalent aat:300011902 ;
    hector:attestationCount 2 .

aat:300011902 a crm:E55_Type ;
