<https://w3id.org/hector/commodity/pyd-fish> a crm:E55_Type ;
    rdfs:label "pyd fish" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pydfish" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pidfiʃ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pydefish" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pidefiʃ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pyd fish" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "pid fiʃ" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "pyd fish: a kind of salt fish, precise meaning unknown (Jenks)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300389825 ;
