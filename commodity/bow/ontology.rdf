  <rdf:Description rdf:nodeID="commodity_bow_cb990238195f168abbd1dabc4787d2bec97c0c3af154022a18a3ff8a08fe6cff5c">
    <crm:P190_has_symbolic_content>Stringed projectile weapons designed to propel arrows, generally consisting of a long stave of wood, metal, fiberglass, or other flexible material, with a length of strong string fastened to the tips of the stave which is bent in a curve, either permanently or from the tension of the string. The string is drawn back, holding the arrow by means of a notch in its rear tip, and propels the arrow upon release. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
