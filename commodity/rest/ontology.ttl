<https://w3id.org/hector/commodity/rest> a crm:E55_Type ;
    rdfs:label "rest" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "restes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "restəs" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "rest" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "rest" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "in medieval armor, a contrivance fixed to the right side of the cuirass to receive the butt-end of the lance when couched for the charge, and to prevent it from being driven back upon impact (OED s.v. rest n.3 2)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/rest> ;
    la:equivalent aat:300036863 ;
    hector:attestationCount 3 .

aat:300036863 a crm:E55_Type ;
    rdfs:label "lance rests" .

