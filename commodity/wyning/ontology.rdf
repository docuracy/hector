  <rdf:Description rdf:nodeID="commodity_wyning_cbe0cb31f86b38291773592cabcb814d2a35ec44da51615fc5fb996c860868c812">
    <crm:P190_has_symbolic_content>a flexible rod, esp the rods used in making or repairing walls (OED winding vbl. n.1 10) | possibly a flexible rod, esp the rods used in making or repairing walls (OED s.v. winding vbl. sb. 10), note however wyndyng pro velis (TNA: PRO, E122/73/25 f. 7v) from wind (to hoist the sail of a ship), therefore possibly rigging | a small strong rope for tying a sail (OED s.v. wyning)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
