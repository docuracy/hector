    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a measure of capacity and weight used in some of the countries bordering on the Mediterranean, varying greatly according to the locality; in Genoese use equivalent to 100 lb. (OED s.v. cantar, Day 973) | kantar, Genoese hundredweight or quintal, as a measure of cumin (Day 973: cantarium) | kantar, Genoese hundredweight or quintal, as a measure of saffron (Day 973: cantarium)" ;
