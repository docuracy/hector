  <rdf:Description rdf:nodeID="commodity_cantar_cbfea005de27b176d2a1624953f52e04a5a52dfa2febff2ff09a84c50cf293cfac">
    <crm:P190_has_symbolic_content>a measure of capacity and weight used in some of the countries bordering on the Mediterranean, varying greatly according to the locality; in Genoese use equivalent to 100 lb. (OED s.v. cantar, Day 973) | kantar, Genoese hundredweight or quintal, as a measure of cumin (Day 973: cantarium) | kantar, Genoese hundredweight or quintal, as a measure of saffron (Day 973: cantarium)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
