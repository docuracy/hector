  <rdf:Description rdf:nodeID="commodity_almanacs_cb6c5b1e3ad86b56c92dd2b370be51689ffafef156746bbf125e6eb8bdb95191dd">
    <crm:P190_has_symbolic_content>an annual table, or (more usually) a book of tables, containing a calendar of months and days, with astronomical data and calculations, ecclesiastical and other anniversaries, besides other useful information, and astrological and astrometeorological forecasts (OED s.v. almanac)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
