    <rdfs:label>Naples</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="commodity_anaparte_cb0">
    <crm:P190_has_symbolic_content>Possibly fustian from Naples: Strong cloth woven in a variety of patterns, in common use for bedding and lining for clothing from the 17th to the 19th century. Prior to the 17th century it was made of worsted, then pure cotton or mixes of cotton and linen became common; today generally a cotton twill with a short nap. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
