  <rdf:Description rdf:nodeID="commodity_ceruse_cb0">
    <crm:P190_has_symbolic_content>white lead, especially as a cosmetic (OED s.v. ceruse) | white lead, a mixture or compound of carbonate and hydrate of lead (usually 2 PbCO3+ PbH2O2); largely used as a white paint, formerly also in medicine for ointments, etc. (OED s.v. ceruse)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
