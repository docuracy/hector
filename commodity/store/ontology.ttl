<https://w3id.org/hector/commodity/store> a crm:E55_Type ;
    rdfs:label "store" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "store" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "storə" ;
            hector:validFrom "1513"^^xsd:gYear ;
            hector:validThrough "1514"^^xsd:gYear ] ;
    crm:P2_has_type aat:300386154 ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "this (300 lb. store) is surely an error, since the parallel entry in the tunnage and poundage account (p. 442) records 3 cwt vas electri)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/store> ;
    hector:attestationCount 2 .

aat:300386154 a crm:E55_Type ;
    rdfs:label "unidentified (information indicator)" .

