  <rdf:Description rdf:nodeID="commodity_jerkin_cb2cd02d3021039bf84c1c03c142b89b19bde606032d70ca6f8d9f2f885e8ee599">
    <crm:P190_has_symbolic_content>Close-fitting, hip-length jackets without sleeves, usually collarless and secured with a belt, especially those worn over a doublet during the 16th and 17th centuries. Use also for similar garments with closures made of woven or knitted cloth or leather and worn during the 20th century as protective outerwear or to carry equipment by military personnel. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
