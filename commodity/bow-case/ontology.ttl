<https://w3id.org/hector/commodity/bow-case> a crm:E55_Type ;
    rdfs:label "bow case" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bowcasis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "buːkasis" ;
            hector:validFrom "1428"^^xsd:gYear ;
            hector:validThrough "1430"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bowcas" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "buːkas" ;
            hector:validFrom "1428"^^xsd:gYear ;
            hector:validThrough "1430"^^xsd:gYear ],
