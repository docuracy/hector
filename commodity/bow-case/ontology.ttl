            crm:P190_has_symbolic_content "bow case" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "buː kasə" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a case in which a bow is kept (OED s.v. bow-case)" ;
            crm:P2_has_type aat:300435416 ] ;
