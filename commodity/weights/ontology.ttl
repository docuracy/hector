<https://w3id.org/hector/commodity/weights> a crm:E55_Type ;
    rdfs:label "weights" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "weights" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "weixts" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "poysis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "poisis" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a set of Troy weights (Willan 62 s.v. Troy weights)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300197555 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/weights> ;
    skos:related <https://w3id.org/hector/commodity/weight> ;
