<https://w3id.org/hector/commodity/calico> a crm:E55_Type ;
    rdfs:label "calico" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "calico" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "kaliko" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "callicoo clothe" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kalikoː kloθə" ;
            hector:validFrom "1550"^^xsd:gYear ;
            hector:validThrough "1553"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "calecowe cloth" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kalekuːə kloθ" ;
            hector:validFrom "1548"^^xsd:gYear ;
