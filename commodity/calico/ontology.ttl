            hector:phoneticKey "kaliko kloθə" ;
            hector:validFrom "1550"^^xsd:gYear ;
            hector:validThrough "1553"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Cotton textile, heavier than muslin, plain, dyed, or with patterns printed in one or more colors. In the 18th and 19th centuries, the term referred to printed, colored or plain cloth from India; now it refers generally to cotton prints with small, stylized patterns. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/calico> ;
