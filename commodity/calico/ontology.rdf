  <rdf:Description rdf:nodeID="commodity_calico_cb5d4cd83986f55421ad09d4bd33bdb3e32f36ac78766378fc2792ff2096acbb16">
    <crm:P190_has_symbolic_content>Cotton textile, heavier than muslin, plain, dyed, or with patterns printed in one or more colors. In the 18th and 19th centuries, the term referred to printed, colored or plain cloth from India; now it refers generally to cotton prints with small, stylized patterns. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
