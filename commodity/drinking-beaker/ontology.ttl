    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Refers to many varieties of relatively large drinking vessels without handles, cylindrical or conical in shape, with a flat base in the form of an open cup or goblet. Specifically, in archaeology refers to the tall wide-mouthed vessels produced by the Bell Beaker culture and found in certain early Bronze Age graves. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
