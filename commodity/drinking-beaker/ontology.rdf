  <rdf:Description rdf:nodeID="commodity_drinking_beaker_cb9da08a40bae96fd6cde9c7201f852bcba8025df900ff946e6fd02883a36a3b4e">
    <crm:P190_has_symbolic_content>Refers to many varieties of relatively large drinking vessels without handles, cylindrical or conical in shape, with a flat base in the form of an open cup or goblet. Specifically, in archaeology refers to the tall wide-mouthed vessels produced by the Bell Beaker culture and found in certain early Bronze Age graves. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
