<https://w3id.org/hector/commodity/horse-mill> a crm:E55_Type ;
    rdfs:label "horse-mill" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "horse-mill" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "horsə mil" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "horsmylle" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "horsmilə" ;
            hector:validFrom "1438"^^xsd:gYear ;
            hector:validThrough "1439"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a mill driven by a horse, usually one walking in a circle (OED s.v. horse-mill)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300264628 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/horse-mill> ;
    hector:attestationCount 1 .

