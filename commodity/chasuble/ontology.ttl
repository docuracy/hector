    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Sleeveless outer vestments in the form of a wide cloak or mantle that slips over the wearer's head and remains open at the sides. Chasubles are worn over the alb and stole by the celebrant at Mass. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/chasuble> ;
