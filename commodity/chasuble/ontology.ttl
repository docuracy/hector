<https://w3id.org/hector/commodity/chasuble> a crm:E55_Type ;
    rdfs:label "chasuble" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "chesepilles" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "tʃesepiləs" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1398"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "chesepal" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "tʃesepal" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1398"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "chesepille" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "tʃesepilə" ;
            hector:validFrom "1390"^^xsd:gYear ;
