  <rdf:Description rdf:nodeID="commodity_chasuble_cbe33d4ebc207773846330c3a124d599807bd8ee8d8b74779134c184a209fe30ac">
    <crm:P190_has_symbolic_content>Sleeveless outer vestments in the form of a wide cloak or mantle that slips over the wearer's head and remains open at the sides. Chasubles are worn over the alb and stole by the celebrant at Mass. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
