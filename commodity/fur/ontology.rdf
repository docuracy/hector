  <rdf:Description rdf:nodeID="commodity_fur_cbe614064e307c2be4f77e462e88e99854749b00aac0859b9f06ec270084343e38">
    <crm:P190_has_symbolic_content>a number of skins sewn together to make a fur lining (Veale 219) | a number of skins sewn together to make a fur lining (Veale 219) (see also pellis) | clearly some kind of fur, but exact meaning unknown | fur | a fur trimming or lining for a garment; a garment trimmed or lined with fur; the hairy skin or pelt of an animal; esp., when prepared for use in clothing (MED s.v. furre n.), here made of foyne wombs (q.v.) | a number of fox skins sewn together to make a fur lining (Veale 219)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
