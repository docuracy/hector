            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "vest" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Close-fitting main garments extending to the waist or just below. Sleeveless and usually collarless, and often having buttons or pockets. For close-fitting main garments extending below the waistline that are usually front-buttoning and may have sleeves, that are worn over a shirt and under a coat or jacket, use \"waistcoats.\" [Source: Getty AAT] | cpossibly a (sleeveless) garment made of linen cloth (OED s.v. vest n., but first citations are 17th century) or some sort of measure of linen cloth, but exact meaning unknown" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/vest> ;
    la:equivalent aat:300209904 ;
    hector:attestationCount 1 .

