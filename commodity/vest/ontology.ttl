<https://w3id.org/hector/commodity/vest> a crm:E55_Type ;
    rdfs:label "vest" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "vestes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "vestəs" ;
            hector:validFrom "1477"^^xsd:gYear ;
            hector:validThrough "1479"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "veste" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "vestə" ;
            hector:validFrom "1477"^^xsd:gYear ;
            hector:validThrough "1479"^^xsd:gYear ],
