    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Tapestry: a figured textile used as a wall-hanging, carpet, bench-covering (banker) or bedspread (OED s.v. tapestry). Worked in wool, silk, caddis (crewel), hair, gold thread or verdure (foliage) designs; of fine or coarse quality; from France and Flanders." ;
