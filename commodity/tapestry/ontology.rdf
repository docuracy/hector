  <rdf:Description rdf:nodeID="commodity_tapestry_cb348e321d9ef328e3656df39011159310947fb310a081e6b20e595011601f881b">
    <crm:P190_has_symbolic_content>Tapestry: a figured textile used as a wall-hanging, carpet, bench-covering (banker) or bedspread (OED s.v. tapestry). Worked in wool, silk, caddis (crewel), hair, gold thread or verdure (foliage) designs; of fine or coarse quality; from France and Flanders.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
