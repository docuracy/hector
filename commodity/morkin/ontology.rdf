  <rdf:Description rdf:nodeID="commodity_morkin_cb0">
    <crm:P190_has_symbolic_content>the skin (or fur) of a beast that dies by disease or accident (OED s.v. morkin1), here most probably the skin of a sheep; may be undressed</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
