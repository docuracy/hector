  <rdf:Description rdf:nodeID="commodity_laudanum_cb18a3e0db7df64a9a5f6adc1e19e9292419bb39f2d097baa72894d474e6a69452b">
    <crm:P190_has_symbolic_content>a gum resin which exudes from plants of the genus cistus, especially C. ladaniferus and C. Creticus, much used in perfumery and for fumigation (OED s.v. ladanum) | a name for various preparations in which opium was the main ingredient (Latham, Word-List, s.v. ladanum, laudanum; OED s.v. laudanum) | a name for various preparations in which opium was the main ingredient (Latham, Word-List s.v. ladanum, laudanum; OED s.v. laudanum)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
