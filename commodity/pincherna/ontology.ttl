<https://w3id.org/hector/commodity/pincherna> a crm:E55_Type ;
    rdfs:label "pincherna" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pinchernae" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pintʃerne" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pincherna" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "pintʃerna" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "some kind of measure for wine, but exact meaning unknown (Latham, Word-List, Dictionary s.v. pincherna defines the term as ‘butler’)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/pincherna> ;
    la:equivalent aat:300386648 ;
    hector:attestationCount 1 .

