  <rdf:Description rdf:nodeID="commodity_garnet_cb9a943ac461a630e74dd109ba706c3c8d5e14a7b7b485d5dbfd2f926135befb7">
    <crm:P190_has_symbolic_content>A general name for a type of mineral varying in color and hardness, including trisilicates of aluminum, magnesium, calcium, iron, manganese, vanadium, chromium, and sometimes sodium and titanium. Used for coating abrasive paper and cloth, for bearing pivots in watches, for electronics, and the finer specimens as gemstone. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
