  <rdf:Description rdf:nodeID="commodity_roll_cb5a851d5962d551df0d65b90cd3cff9d40128f46c0a3370889d759e95bc9d50e7">
    <crm:P190_has_symbolic_content>roll (rouleau; Latin rotulus, rolla): a packing unit and measure for cloth — both a physical unit of transport of no particular size and, for cloth, a standard length and breadth, sometimes of a definite size (Osnabrück linen: 1500 ells; Hasord cloth: 15 hundred ells at 6 score). See also pack, bale.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
