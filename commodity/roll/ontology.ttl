    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "roll (rouleau; Latin rotulus, rolla): a packing unit and measure for cloth — both a physical unit of transport of no particular size and, for cloth, a standard length and breadth, sometimes of a definite size (Osnabrück linen: 1500 ells; Hasord cloth: 15 hundred ells at 6 score). See also pack, bale." ;
            crm:P2_has_type aat:300435416 ] ;
