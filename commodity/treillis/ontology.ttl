            crm:P190_has_symbolic_content "treillis" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "treilis" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "treillis, a stout or coarse kind of cloth; in later use buckram, sacking (Cobb 187)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300235660 ;
