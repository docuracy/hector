  <rdf:Description rdf:nodeID="commodity_shaffrons_cb258e120fefa3a159a6af71366a2de09782c2e66e0e0a1ae1d3285a00521f9941">
    <crm:P190_has_symbolic_content>Armor pieces for the front of a horse's or camel's head, often with side plates to protect the cheeks and often decorated to match the armor of the rider. Known in classical Greece and from the 12th century on throughout Europe, the Middle East, Turkey, North Africa, and Japan, they were commonly made of either steel or leather, though the Japanese also used papier-maché and wood, the Ottoman Turks copper, and the Sudanese mainly brass. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
