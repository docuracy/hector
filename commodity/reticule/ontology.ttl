<https://w3id.org/hector/commodity/reticule> a crm:E55_Type ;
    rdfs:label "reticule" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "reticules" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "retikuləs" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "reticule" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "retikulə" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ] ;
    crm:P2_has_type aat:300386154 ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "meaning unknown (the OED definition ‘a small handbag, typically made of a soft fabric, tied with a drawstring and decorated with embroidery or beading’ (OED s.v. reticule n.), can be rejected because the first occurence of the term was 1802)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/reticule> ;
    hector:attestationCount 1 .

