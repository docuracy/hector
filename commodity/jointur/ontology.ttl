    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "something which fastens or connects, a fastener, tie, buckle, link etc. (MEd s.v. jointur n. 1c), here of latten | the meaning is not altogether clear. A joyntour is something which fastens or connects, a fastener, tie, buckle, link etc. (MEd s.v. jointur n. 1c), but what pro femina ('for women') might mean in this context is unclear" ;
            crm:P2_has_type aat:300435416 ] ;
