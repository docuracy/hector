<https://w3id.org/hector/commodity/jointur> a crm:E55_Type ;
    rdfs:label "jointur" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "jountour" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dʒuːntuːr" ;
            hector:validFrom "1434"^^xsd:gYear ;
            hector:validThrough "1438"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "joyntour" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dʒointuːr" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "joyntours" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dʒointuːrs" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "jointur" ;
            crm:P2_has_type aat:300404670,
