<https://w3id.org/hector/commodity/tew> a crm:E55_Type ;
    rdfs:label "tew" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "tew" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "teu" ;
            hector:validFrom "1533"^^xsd:gYear ;
            hector:validThrough "1535"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "tews" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "teus" ;
            hector:validFrom "1533"^^xsd:gYear ;
            hector:validThrough "1535"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "fishing-tackle; nets, fishing-lines, etc. (OED tew n.2)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/tew> ;
    la:equivalent aat:300024416 ;
    hector:attestationCount 1 .

aat:300024416 a crm:E55_Type ;
