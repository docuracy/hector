<https://w3id.org/hector/commodity/pillar> a crm:E55_Type ;
    rdfs:label "pillar" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pillar" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "pilar" ;
            hector:validFrom "1541"^^xsd:gYear ;
            hector:validThrough "1545"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "piller" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "piler" ;
            hector:validFrom "1531"^^xsd:gYear ;
            hector:validThrough "1533"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pillers" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pilers" ;
            hector:validFrom "1531"^^xsd:gYear ;
            hector:validThrough "1533"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "one of the four posts of a bedstead (OED s.v. pillar n. 5a); a post of a bed, one of the upright supports of the framework of a bed (OED s.v. bed-post n.)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/pillar> ;
    skos:related <https://w3id.org/hector/commodity/bedstead> ;
    la:equivalent aat:300001609 ;
    hector:attestationCount 1 .

