  <rdf:Description rdf:nodeID="commodity_cope_cb3ee7abc50d68cc176d35798c95ccac024fa2696daa40f52db4d2ed40f4b7910e">
    <crm:P190_has_symbolic_content>Long, semi-circular cloaklike garments fastened at the neck with a morse; worn by ecclesiastics in processions and on other ceremonial occasions. Also, similar garments worn as coronation or processional robes by laymen. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
