    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Long, semi-circular cloaklike garments fastened at the neck with a morse; worn by ecclesiastics in processions and on other ceremonial occasions. Also, similar garments worn as coronation or processional robes by laymen. [Source: Getty AAT]" ;
