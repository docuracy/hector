    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Any relatively insoluble organic, inorganic, natural or artificial substance that imparts a color to another substance or mixture and always appears as the same specific color when viewed in white light. It is the constituent of paint or ink that provides the color. Distinguished from a dye, which is soluble in the vehicle, a pigment is insoluble in the vehicle, but instead is held in a suspension. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
