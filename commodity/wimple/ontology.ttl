<https://w3id.org/hector/commodity/wimple> a crm:E55_Type ;
    rdfs:label "wimple" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "wymble" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "wimblə" ;
            hector:validFrom "1507"^^xsd:gYear ;
            hector:validThrough "1508"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "wymbles" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "wimbləs" ;
            hector:validFrom "1507"^^xsd:gYear ;
            hector:validThrough "1508"^^xsd:gYear ],
