    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "wimple: a garment of linen or silk formerly worn by women, folded so as to cover the head, neck and sides of the face (OED s.v. wimple)." ;
