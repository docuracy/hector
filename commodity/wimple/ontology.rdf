  <rdf:Description rdf:nodeID="commodity_wimple_cb0">
    <crm:P190_has_symbolic_content>wimple: a garment of linen or silk formerly worn by women, folded so as to cover the head, neck and sides of the face (OED s.v. wimple).</crm:P190_has_symbolic_content>
