  <rdf:Description rdf:nodeID="commodity_antipera_cb4a0bae6637dc72f2a1963538968907e0512831e4a49db5a302a1d4425713add6">
    <crm:P190_has_symbolic_content>Refers to furniture or built-in features in the form of an upright partition that can be used to embellish, partition, shelter, and provide privacy. Screens are often highly decorated. [Source: Getty AAT]</crm:P190_has_symbolic_content>
