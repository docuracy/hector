<https://w3id.org/hector/commodity/hanging> a crm:E55_Type ;
    rdfs:label "hanging" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hangyng" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "hangiŋ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hanging" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "handʒiŋ" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Artifacts, usually flexible, often textiles, that are hung to cover or conceal interior spaces, surfaces, or furnishings, especially for protection, warmth, or embellishment. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/hanging> ;
    la:equivalent aat:300205010 ;
    hector:attestationCount 10 .

