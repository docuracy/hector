  <rdf:Description rdf:nodeID="commodity_image_of_pity_cb0">
    <crm:P190_has_symbolic_content>images of pity (approx. 16th cent.), printed or painted images showing the five wounds of Christ and the crown of thorns, with a caption promising that contemplation would grant time off in purgatory (Peter Blayley); on paper, parchment, cloth or tablets, also as woodcuts</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
