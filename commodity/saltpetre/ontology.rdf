  <rdf:Description rdf:nodeID="commodity_saltpetre_cb0">
    <crm:P190_has_symbolic_content>saltpetre, a white crystalline substance (potassium nitrate) having a saline taste; it is the chief constituent of gunpowder, and is used medicinally (OED s.v. saltpetre)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
