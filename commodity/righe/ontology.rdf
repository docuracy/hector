  <rdf:Description rdf:nodeID="commodity_righe_cbe9cd76fbeb2e154922c565424d4fcb64db990c387f0453c5fff99afb4677ccb2">
    <crm:P190_has_symbolic_content>a selachian fish of the family Raiidæ, having a broad flat body (sometimes of enormous size) and inferior gill-openings; esp. a skate (OED ray n.2, s.v. reigh)</crm:P190_has_symbolic_content>
