            hector:validThrough "1433"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Material comprising the fine, small, fluffy, undergrowth feathers that lie next to the body of many adult birds. Commercial down, usually obtained from ducks and waterfowl, is lightweight and resilient. When used as a filling, down provides insulation and loft. It is used in winter coats, sleeping bags, bedding, and pillows. Trade regulation rules allow a garment to be labeled 100% down when it contains a minimum of 80% down. Today, most down is imported from China, Taiwan, Poland, and eastern Europe.  [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
