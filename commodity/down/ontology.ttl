    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "downe" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "duːnə" ;
            hector:validFrom "1439"^^xsd:gYear ;
            hector:validThrough "1440"^^xsd:gYear ],
