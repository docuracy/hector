  <rdf:Description rdf:nodeID="commodity_down_cb62b9d37f98c3df78414e284c623b0ec111fb68a3e548014c9953fe386cb2d68b">
    <crm:P190_has_symbolic_content>Material comprising the fine, small, fluffy, undergrowth feathers that lie next to the body of many adult birds. Commercial down, usually obtained from ducks and waterfowl, is lightweight and resilient. When used as a filling, down provides insulation and loft. It is used in winter coats, sleeping bags, bedding, and pillows. Trade regulation rules allow a garment to be labeled 100% down when it contains a minimum of 80% down. Today, most down is imported from China, Taiwan, Poland, and eastern Europe.  [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
