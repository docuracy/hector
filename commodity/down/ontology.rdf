  <rdf:Description rdf:nodeID="commodity_down_cb16376f3efaa3c7707061a05b4268d1b8f5a3a52c0160ccc025db4be60b0f2ff42">
    <crm:P190_has_symbolic_content>doune</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="https://w3id.org/hector/ontology#AttestedVariant"/>
