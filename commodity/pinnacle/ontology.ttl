<https://w3id.org/hector/commodity/pinnacle> a crm:E55_Type ;
    rdfs:label "pinnacle" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pinnacle" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "pinaklə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pinacle" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pinaklə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pinacles" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pinakləs" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a small ornametal turret, usually terminating in a pyramid or cone, crowning a butress, here made of gold and silver (OED s.v. pinnacle n. 1a)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300002351 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/pinnacle> ;
    hector:attestationCount 2 .

