  <rdf:Description rdf:nodeID="commodity_partelette_cb983f7b51f209fc243745b91850c9e2d4bb5e67c8a777adc9ccaaa7c2eb05cc75">
    <crm:P190_has_symbolic_content>a partlet is an article of apparel worn about the neck and the upper part of the chest (OED partlet2). Here it is clearly a piece of defensive armor, presumably to protect the neck and the upper chest</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
