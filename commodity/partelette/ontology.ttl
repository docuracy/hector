<https://w3id.org/hector/commodity/partelette> a crm:E55_Type ;
    rdfs:label "partelette" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "partelettes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "parteletəs" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "partelette" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "parteletə" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a partlet is an article of apparel worn about the neck and the upper part of the chest (OED partlet2). Here it is clearly a piece of defensive armor, presumably to protect the neck and the upper chest" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/partelette> ;
    la:equivalent aat:300444098 ;
    hector:attestationCount 3 .

