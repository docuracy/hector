  <rdf:Description rdf:nodeID="commodity_clavichord_cb10a815f501092ba9e0b96d559e4a429b03f7acf0c0cbe69535ca52844b9bf56d6">
    <crm:P190_has_symbolic_content>Zitherlike instruments in the form of a rectangular box with a keyboard set in the long side. Strings, usually two per note, run from hitch pins on the left over a bridge to tuning pins at the right. Brass tangents on the rear portion of each key strike the strings from below to produce sound. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
