  <rdf:Description rdf:nodeID="commodity_ring_cb0">
    <crm:P190_has_symbolic_content>ring: a circular band of metal (latten, tin, iron, copper) — door rings and knockers, curtain rings, and rings for closing pouches and bags; also occasionally a coil of wire equivalent to 1/2 cwt. Finger rings (jewellery) are catalogued under finger ring.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
