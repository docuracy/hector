  <rdf:Description rdf:nodeID="commodity_plate_cb0">
    <crm:P190_has_symbolic_content>sheet metal / plate: metal — commonly iron, but also latten, copper, steel or silver — rolled or beaten into thin flat sheets. Often distinguished as black (untinned) or white (tinned) iron plate; used for armour (e.g. vambraces and rerebraces) and a range of other manufactures.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
