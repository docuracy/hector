<https://w3id.org/hector/commodity/dory> a crm:E55_Type ;
    rdfs:label "dory" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dorre" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dorə" ;
            hector:validFrom "1505"^^xsd:gYear ;
            hector:validThrough "1506"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dory" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "dori" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dorres" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dorəs" ;
            hector:validFrom "1505"^^xsd:gYear ;
            hector:validThrough "1506"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a fish, Zeus faber, found in European seas, and much esteemed as food (OED s.v. dory n.2)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300389825 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/dory> ;
    hector:attestationCount 3 .

