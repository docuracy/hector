<https://w3id.org/hector/commodity/carta> a crm:E55_Type ;
    rdfs:label "carta" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cartae" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "karte" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cart" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kart" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "carta" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "karta" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "clearly, some sort of measure of rosin, but exact meaning unknown (cf. Day 973 caratelus = it caratello = 'petit tonneau')" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300386648 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/carta> ;
    hector:attestationCount 4 .

aat:300386648 a crm:E55_Type ;
