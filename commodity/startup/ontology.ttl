@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/startup> a crm:E55_Type ;
    rdfs:label "startup" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "startup" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "startup" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "startoppis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "startopis" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "startopp" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "startop" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "originally, a kind of ‘high-low’ or boot, worn by rustics; in later use, a kind of gaiter or legging (OED s.v. startup n.1)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300210027 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/startup> ;
    hector:attestationCount 1 .

