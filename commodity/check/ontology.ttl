            hector:validThrough "1550"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a fabric woven or printed with a check pattern, i.e. with cross lines forming small squares (OED s.v. check, n.2 2)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300231565 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/check> ;
