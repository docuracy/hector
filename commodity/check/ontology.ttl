            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "tʃekəs" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cheke" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "tʃekə" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "checkes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "tʃekəs" ;
            hector:validFrom "1548"^^xsd:gYear ;
            hector:validThrough "1550"^^xsd:gYear ],
