  <rdf:Description rdf:nodeID="commodity_pot_measure_cb8fdb936b779988b3f180f2ef8710eb8416812d0faa3af4e3a8a81e1acb633e4d">
    <crm:P190_has_symbolic_content>a pot used as a unit of capacity — gallon, potle (two quarts), quart, pint, half-pint, usually of tin or pewter; also a pot as a measure for ginger, rose-water, conserva rosarum, confeccio, socate and similar wares, and (de virga) a yard of ale. See also pint pot, potelle.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
