    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a pot used as a unit of capacity — gallon, potle (two quarts), quart, pint, half-pint, usually of tin or pewter; also a pot as a measure for ginger, rose-water, conserva rosarum, confeccio, socate and similar wares, and (de virga) a yard of ale. See also pint pot, potelle." ;
