    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "European wire-strung plucked lutelike chordophones played with a plectrum, very popular in the 16th and 17th centuries, having a wedge-shaped body with a curved bottom and straight shoulders narrowing towards the neck, and a low flat bridge held in position only by the strings it supports. Their most characteristic feature is a long, fretted neck which is half cut away from behind the fingerboard on the bass side, making a channel along which the player's left thumb can slide to facilitate very rapid shifts to and from high positions. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
