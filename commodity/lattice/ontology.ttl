<https://w3id.org/hector/commodity/lattice> a crm:E55_Type ;
    rdfs:label "lattice" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lattice" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "latisə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "latice" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "latisə" ;
            hector:validFrom "1465"^^xsd:gYear ;
            hector:validThrough "1472"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "latyce" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "latisə" ;
            hector:validFrom "1465"^^xsd:gYear ;
            hector:validThrough "1472"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "clearly some kind of cloth (since measured in ells or pieces), but exact meaning unknown" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300162391 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/lattice> ;
    hector:attestationCount 2 .

aat:300162391 a crm:E55_Type ;
