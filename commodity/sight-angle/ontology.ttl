<https://w3id.org/hector/commodity/sight-angle> a crm:E55_Type ;
    rdfs:label "sight-angle" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "site angules" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sitə aŋguləs" ;
            hector:validFrom "1487"^^xsd:gYear ;
            hector:validThrough "1490"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "sight-angle" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "sixt aŋlə" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "sight-angle, an instrument used for making surveys (OED sight, n.1 usage of 1571)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300041572 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/sight-angle> ;
    hector:attestationCount 1 .

