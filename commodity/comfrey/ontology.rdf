  <rdf:Description rdf:nodeID="commodity_comfrey_cb0">
    <crm:P190_has_symbolic_content>comfrey, Symphytum officinale (family Boraginaceæ), a tall plant, common on the margins of streams and ditches, with rough leaves, and drooping clusters of yellowish-white or reddish-purple bell-shaped flowers; formerly esteemed as a vulnerary, useful in healing wounds (OED s.v. comfrey 1)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
