  <rdf:Description rdf:nodeID="commodity_cross_cbbae6967f21aaedf512f983fb4e7c099a0c895337b70e16639fb2b79c7fa3881b">
    <crm:P190_has_symbolic_content>Visual works in the shape of two intersecting bars, usually an upright one traversed by a horizontal one, especially those used as Christian symbols. For motifs consisting of two intersecting lines, with many variations in the shapes of the arms, use "crosses (motifs)." [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
