<https://w3id.org/hector/commodity/pal> a crm:E55_Type ;
    rdfs:label "pal" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "palys" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "palis" ;
            hector:validFrom "1472"^^xsd:gYear ;
            hector:validThrough "1477"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pal" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "pal" ;
            hector:validFrom "1472"^^xsd:gYear ;
            hector:validThrough "1477"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a fine cloth; a fine covering for an altar, a bed or a seat (MED s.v. pal n.)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300205012 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/pal> ;
    la:equivalent aat:300162391 ;
    hector:attestationCount 1 .

aat:300162391 a crm:E55_Type ;
