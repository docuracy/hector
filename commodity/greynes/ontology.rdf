  <rdf:Description rdf:nodeID="commodity_greynes_cbf6157d2912e1b2174f00ae21ffadd1a6b780dcb1ca067d97d46529b4acbe3a63">
    <crm:P190_has_symbolic_content>Grains of Paradise / Guinea grains: the capsules of Amomum meleguetta of West Africa (cf. cardamom), used as a spice and in medicine (OED s.v. grain n.1 4; Latham, Dictionary s.v. granum 4; Stieda, Venice 102). Latin granum paradisi. Not to be confused with the homonymous dyestuff kermes / scarlet grain (see granum).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
