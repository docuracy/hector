<https://w3id.org/hector/commodity/axe> a crm:E55_Type ;
    rdfs:label "axe" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "axis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "aksis" ;
            hector:validFrom "1513"^^xsd:gYear ;
            hector:validThrough "1514"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "axe" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "aksə" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "axes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "aksəs" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ax" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "aks" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Cutting weapons consisting basically of a relatively heavy, flat blade fixed to a handle, wielded by either striking or throwing. For axes used for other purposes, typically having narrower blades, use \"axes (tools).\" [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/axe> ;
    la:equivalent aat:300036982 ;
    hector:attestationCount 3 .

