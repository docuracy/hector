  <rdf:Description rdf:nodeID="commodity_axe_cb58f5c732f16b7173debd5a28114522d9ab3e23f37c531619e402192606befa61">
    <crm:P190_has_symbolic_content>Cutting weapons consisting basically of a relatively heavy, flat blade fixed to a handle, wielded by either striking or throwing. For axes used for other purposes, typically having narrower blades, use "axes (tools)." [Source: Getty AAT]</crm:P190_has_symbolic_content>
