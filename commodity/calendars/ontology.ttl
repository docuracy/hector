    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a table or chart of the year, or for a mathematical or astronomical table (MED s.v. calender n.) | case for a table or chart of the year, or for a mathematical or astronomical table (MED s.v. calender n.) | calendar, a table showing the division of a given year into its months and days, and referring the days of each month to the days of the week; often also including important astronomical data, and indicating ecclesiastical or other festivals, and other events belonging to individual days (OED s.v. calendar n. 2) | a written calender; an astronomical table (MED s.v. calender) | a table (or pamphlet) showing the division of the year into months and days, often with astronomical data and/or church festivals (notably Easter) and saints’ days (OED s.v. calendar n.)" ;
            crm:P2_has_type aat:300435416 ] ;
