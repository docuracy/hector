<https://w3id.org/hector/commodity/ballast> a crm:E55_Type ;
    rdfs:label "ballast" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lastagium" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "lastadʒium" ;
            hector:validFrom "1380"^^xsd:gYear ;
            hector:validThrough "1385"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lastagii" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "lastadʒi" ;
            hector:validFrom "1380"^^xsd:gYear ;
            hector:validThrough "1385"^^xsd:gYear ],
