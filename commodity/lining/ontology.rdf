  <rdf:Description rdf:nodeID="commodity_lining_cb0">
    <crm:P190_has_symbolic_content>the lining of a garment (MED s.v. lininge ger.) | the stuff with which garments are lined; the inner or under surface of material stitched into a coat, robe, hat, etc. for protection or warmth (OED s.v. lining vbl. n.1 1.a) | lining of a garment, purse, pouch (MED s.v. lining(e ger.)) | lining of a garment, purse or pouch (MED s.v. lining(e ger.))</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
