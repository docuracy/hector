  <rdf:Description rdf:nodeID="commodity_crespine_cb9b1d952aeccc083e103dd74d56376a2f65d4ffec9e8b73d65f21c55d2c3d7214">
    <crm:P190_has_symbolic_content>Close-fitting caps or hairnets usually of gold, silver, silk, or wool thread, often decorated with pearls or beads and made to confine hair; worn by women and sometimes by men especially during the 13th through the 16th century. For hairnets used to confine hair at the back of the neck or attached to the back edge of a hat, use "snoods." [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
