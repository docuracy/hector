  <rdf:Description rdf:nodeID="commodity_crespine_cb13e1f44c07b919ee61addd93fdc682bf0a7629070b5c5764b50a255d4293725ba">
    <crm:P190_has_symbolic_content>krepyns</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="https://w3id.org/hector/ontology#AttestedVariant"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_E41_Linguistic_Appellation"/>
