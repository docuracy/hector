    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Close-fitting caps or hairnets usually of gold, silver, silk, or wool thread, often decorated with pearls or beads and made to confine hair; worn by women and sometimes by men especially during the 13th through the 16th century. For hairnets used to confine hair at the back of the neck or attached to the back edge of a hat, use \"snoods.\" [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
