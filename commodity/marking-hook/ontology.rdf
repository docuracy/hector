  <rdf:Description rdf:nodeID="commodity_marking_hook_cb0">
    <crm:P190_has_symbolic_content>some sort of implement for fishing (the accounts record the import of 1 (or 2 L2) dozen fishing et markyng hokes), but exact meaning unknown (Cobb 182 'marking hooks')</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
