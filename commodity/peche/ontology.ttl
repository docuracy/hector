<https://w3id.org/hector/commodity/peche> a crm:E55_Type ;
    rdfs:label "peche" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "peches" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "petʃəs" ;
            hector:validFrom "1506"^^xsd:gYear ;
            hector:validThrough "1507"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "peche" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "petʃə" ;
            hector:validFrom "1506"^^xsd:gYear ;
            hector:validThrough "1507"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "peach, a fruit" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/peche> ;
    la:equivalent aat:300266272 ;
    hector:attestationCount 2 .

