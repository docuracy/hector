    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "substance taken from embalmed corpses, used medically (MED s.v. mummie n.)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300262951 ;
