            hector:phoneticKey "silver et gold" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "aurum et argentum" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "aurum et ardʒentum" ],
