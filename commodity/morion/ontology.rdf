  <rdf:Description rdf:nodeID="commodity_morion_cbd33b99fc941e7638ec434f95340a907eacc9ee8d979b65956e7e6e9170ea7f0f">
    <crm:P190_has_symbolic_content>a kind of brimmed helmet resembling a hat, without a beaver or visor, worn chiefly by foot soldiers in the 16th and 17th centuries (OED s.v. morion n.1); a variant spelling is morian (OED s.v. morian); sometimes engraved</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
