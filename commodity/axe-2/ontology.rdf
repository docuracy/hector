  <rdf:Description rdf:nodeID="commodity_axe_2_cb38a36686d73812d138cd0c6b8844a7044b66aa58fb14f784328973892248b633">
    <crm:P190_has_symbolic_content>Cutting tools that consist of a relatively heavy edged, squarish head fixed to a handle, the edge or edges being parallel to the handle so as to be suited for striking, hewing, cleaving, or chopping, trees, wood, ice, or another material. For axes used as weapons, typically having wider blades, use "axes (weapons)." For similar tools that are smaller and lighter, use "hatchets." For long-handled tools with a curved blade set perpendicular to the handle and used for dressing lumber, use "adzes."  [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
