    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Cutting tools that consist of a relatively heavy edged, squarish head fixed to a handle, the edge or edges being parallel to the handle so as to be suited for striking, hewing, cleaving, or chopping, trees, wood, ice, or another material. For axes used as weapons, typically having wider blades, use \"axes (weapons).\" For similar tools that are smaller and lighter, use \"hatchets.\" For long-handled tools with a curved blade set perpendicular to the handle and used for dressing lumber, use \"adzes.\"  [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
