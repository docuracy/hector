  <rdf:Description rdf:nodeID="commodity_muskball_cb1849bbcf3d67e35aee5cf3cf27f63c52d29369aa5d2fe883aafd3d2a4c2d3c68">
    <crm:P190_has_symbolic_content>a receptacle for musk, an odoriferous, reddish-brown substance, secreted in a gland or sack by the male musk-deer; it has a very powerful and enduring odor and is used as the basis of many perfumes, as well as in medicine (OED s.v. musk, muskball)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
