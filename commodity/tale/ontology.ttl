<https://w3id.org/hector/commodity/tale> a crm:E55_Type ;
    rdfs:label "tale" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "tale" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "talə" ;
            hector:validFrom "1442"^^xsd:gYear ;
            hector:validThrough "1445"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "tales" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "taləs" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a numerical reckoning or counting, here of dried plaice (which were large enough to be counted individually)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/tale> ;
    la:equivalent aat:300386648 ;
    hector:attestationCount 23 .

