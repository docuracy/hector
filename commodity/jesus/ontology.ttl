@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hector: <https://w3id.org/hector/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/jesus> a crm:E55_Type ;
    rdfs:label "jesus" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "jesus" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "dʒesus" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "jhesus" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dʒhesus" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a figure of Christ | probably an image (statue) of the Savior | statue of Jesus (see also ymage)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300047600,
        aat:300178241 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/jesus> ;
    hector:attestationCount 10 .

aat:300047600 a crm:E55_Type ;
    rdfs:label "statues" .

aat:300178241 a crm:E55_Type ;
    rdfs:label "devotional images (religious works)" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/jesus> a crm:E55_Type ;
    rdfs:label "jesus (London Customs Accounts glossary)" .

hector:AttestedVariant a crm:E55_Type ;
    rdfs:label "attested variant" .

