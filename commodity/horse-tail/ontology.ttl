<https://w3id.org/hector/commodity/horse-tail> a crm:E55_Type ;
    rdfs:label "horse tail" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "horsse tayel" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "horsə taiel" ;
            hector:validFrom "1533"^^xsd:gYear ;
            hector:validThrough "1535"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "horse tail" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "horsə tail" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "horse tayles" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "horsə tailəs" ],
