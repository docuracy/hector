            hector:validThrough "1535"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the tail of a horse, used in Turkey as an ornament, as a military standard and as an ensign denoting the rank of a pascha (OED s.v. horse-tail)" ;
