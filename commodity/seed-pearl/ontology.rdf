  <rdf:Description rdf:nodeID="commodity_seed_pearl_cbe796a272bd1e67c8aeb2a039d42d1aa580d2091f7c435b630d1cfe2978e3d53b">
    <crm:P190_has_symbolic_content>a seed pearl is a minute pearl having the appearance of a seed, usually drilled and fastened to some material to be worn as an ornament (OED s.v. seed-pearl), but the meaning of medean' is unknown</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
