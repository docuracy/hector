            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "seːd pɛːrl" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a seed pearl is a minute pearl having the appearance of a seed, usually drilled and fastened to some material to be worn as an ornament (OED s.v. seed-pearl), but the meaning of medean' is unknown" ;
            crm:P2_has_type aat:300435416 ] ;
