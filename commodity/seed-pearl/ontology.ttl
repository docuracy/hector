<https://w3id.org/hector/commodity/seed-pearl> a crm:E55_Type ;
    rdfs:label "seed pearl" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "seede perle" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "seːdə perlə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "sede perle pro medean'" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sedə perlə pro medɛːn" ;
            hector:validFrom "1434"^^xsd:gYear ;
