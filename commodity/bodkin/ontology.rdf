  <rdf:Description rdf:nodeID="commodity_bodkin_cb1fceeac9f59ec9a98399ed0966749f3e2bdc198b4fdebcd92b81de4636dac67b3">
    <crm:P190_has_symbolic_content>a short pointed weapon (dagger, stiletto); a small pointed instrument (of bone, steel) for poking holes in cloth; a long pin used by women to fasten up the hair (OED s.v. bodkin) | Small pointed instruments for piercing holes in cloth. [Source: Getty AAT] | Long, single-pronged accessories used to keep hair or headgear in place or for decorative purposes. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
