  <rdf:Description rdf:nodeID="commodity_clove_2_cb107122136b1e50ae94967f74b510b580f17e1c96afbd123b8273da1f080faf124">
    <crm:P190_has_symbolic_content>Small, reddish-brown flower bud of the tropical evergreen tree Syzygium aromaticum. It yields oil which is used as an antiseptic and a flavoring, and is dried and ground into an aromatic spice. The ground flower is also used as a means of organic pest control. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
