<https://w3id.org/hector/commodity/branch> a crm:E55_Type ;
    rdfs:label "branch" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "brawnchis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "brauntʃis" ;
            hector:validFrom "1472"^^xsd:gYear ;
            hector:validThrough "1477"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "branch" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "brantʃ" ;
            hector:validFrom "1483"^^xsd:gYear ;
            hector:validThrough "1485"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the arms of a candelabrum or chandelier. Hence a chandelier, especially of the kind used in churches, here made of latten (OED s.v. branch n. 2d)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:closeMatch aat:300037584,
        aat:300037622 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/branch> ;
    hector:attestationCount 4 .

