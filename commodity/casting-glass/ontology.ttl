<https://w3id.org/hector/commodity/casting-glass> a crm:E55_Type ;
    rdfs:label "casting glass" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "casting glasses" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kastiŋ glasəs" ;
            hector:validFrom "1520"^^xsd:gYear ;
            hector:validThrough "1524"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "casting glass" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "kastiŋ glas" ;
            hector:validFrom "1520"^^xsd:gYear ;
            hector:validThrough "1524"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Bottles made to allow the sprinkling of perfume, water, or another liquid that must be dispensed parsimoniously. One construction utilizes a neck resembling a washer: the constriction regulates the flow of contents to a trickle. Among other forms are nipple-like or tapering or branched tops perforated with holes. Contents were luxury items such as expensive perfumes, rose water, or in the church, holy water. Sprinkler flasks are found in ancient Egypt, China, the Middle East, the ancient Roman world, Europe, and North America. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/casting%20glass> ;
    la:equivalent aat:300264929 ;
    hector:attestationCount 1 .

