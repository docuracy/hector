  <rdf:Description rdf:nodeID="commodity_red_earth_cb7663512a60103392a627132c566c95bc8a80c42b661baba1cbbc15ecc8e3341e">
    <crm:P190_has_symbolic_content>earth or soil that is red in colour; specifically (a) red ochre, ruddle (now rare); (b) a red soil occurring in tropical and subtropical regions, typically clayey and highly leached, and coloured by iron (OED s.v. red adj. and n. 1e (e) (ii))</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
