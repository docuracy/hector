  <rdf:Description rdf:nodeID="commodity_turbot_cb6542a249bcfd8e207a874bb0a0451fd1b556e9ca66930354aaaaa8a8c608feb5">
    <crm:P190_has_symbolic_content>a large flat fish (Rhombus maximus or Psetta maxima), having a wide scaleless body covered with conical bony tubercles, with the eyes normally on the left side, found on the European coasts and much esteemed as food (OED s.v. turbot)</crm:P190_has_symbolic_content>
