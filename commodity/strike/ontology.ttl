@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hector: <https://w3id.org/hector/ontology#> .
@prefix la: <https://linked.art/ns/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/strike> a crm:E55_Type ;
    rdfs:label "strike" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "strikes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "strikəs" ;
            hector:validFrom "1400"^^xsd:gYear ;
            hector:validThrough "1421"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "strike" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "strikə" ;
            hector:validFrom "1400"^^xsd:gYear ;
            hector:validThrough "1421"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a measure of Prussian narrowcloth (800 strikes to a roll)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/strike> ;
    la:equivalent aat:300386648 ;
    hector:attestationCount 2 .

aat:300386648 a crm:E55_Type ;
    rdfs:label "weights and measures (general, standards)" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/strike> a crm:E55_Type ;
    rdfs:label "strike (London Customs Accounts glossary)" .

hector:AttestedVariant a crm:E55_Type ;
    rdfs:label "attested variant" .

