    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "meaning unknown in earliest occurrences (measured in dozens); turmeric, the aromatic and pungent root-stock of the East Indian plant (Curcuma longa), or the powder made of this, the chief ingredient in curry powder, used also in dyeing yellow, and as a chemical test, and in the East as a condiment and medicinally; also applied by English herbalists to the root of Tormentil, and to the root-stock of Sanguinaria canadensis (OED s.v. turmeric n. 1)" ;
            crm:P2_has_type aat:300435416 ] ;
