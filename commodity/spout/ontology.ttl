            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "either a pipe by which rain-water is carried off or discharged from a roof, or a pipe or similar conduit through which water or other liquid flows and is discharged; that part of a fountain, pump, etc., from which the water issues or a tubular or lip-like addition to, or projection from, a vessel to facilitate the pouring out of liquid from it (OED s.v. spout n.) | spout (MED s.v. spoute)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/spout> ;
