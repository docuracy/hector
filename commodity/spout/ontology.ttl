<https://w3id.org/hector/commodity/spout> a crm:E55_Type ;
    rdfs:label "spout" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "spowte" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "spuːtə" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "spoutes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "spuːtəs" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ],
