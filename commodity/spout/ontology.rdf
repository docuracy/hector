  <rdf:Description rdf:nodeID="commodity_spout_cb769f925bee9f820594297267c75eef97f84a3b0492976b0f4db562f42d297c83">
    <crm:P190_has_symbolic_content>either a pipe by which rain-water is carried off or discharged from a roof, or a pipe or similar conduit through which water or other liquid flows and is discharged; that part of a fountain, pump, etc., from which the water issues or a tubular or lip-like addition to, or projection from, a vessel to facilitate the pouring out of liquid from it (OED s.v. spout n.) | spout (MED s.v. spoute)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
