    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "possibly a trivet, a stand for a pot, kettle or other vessel placed over a fire for cooking or heating something, standing on 3 feet (OED s.v. trefet 1b), but cf. MED (s.v. twibit(e) n.), a two-edged ax | trivet, a stand for a pot, kettle or other vessel placed over a fire for cooking or heating something, standing on 3 feet (OED s.v. trefet 1b)" ;
            crm:P2_has_type aat:300435416 ] ;
