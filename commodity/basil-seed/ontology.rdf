  <rdf:Description rdf:nodeID="commodity_basil_seed_cb4af2269e7b91ca171020a7e2b2d8ea0f7afa880c0fed0274d132c8c125bdf1d6">
    <crm:P190_has_symbolic_content>seeds of basil, the popular name of a genus (Ocymum, family Labiatæ) of aromatic, shrubby plants, with flowers arranged in whorled racemes, widely dispersed in tropical and subtropical countries. The best-known species are the culinary herbs, Common or Sweet Basil (O. basilicum) and Bush or Lesser Basil (O. minimum), the leaves of which are used for seasoning soups and made dishes (OED s.v. basil n.1)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
