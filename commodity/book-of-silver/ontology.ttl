<https://w3id.org/hector/commodity/book-of-silver> a crm:E55_Type ;
    rdfs:label "book of silver" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "libri argenti" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "libri ardʒenti" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bokis argenti" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "bokis ardʒenti" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "book of silver" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "boːk of silver" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a packet of silver leaf, put up between leaves of soft paper (OED s.v. book n. 13)" ;
            crm:P2_has_type aat:300435416 ] ;
