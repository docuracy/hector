<https://w3id.org/hector/commodity/rafter> a crm:E55_Type ;
    rdfs:label "rafter" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "rasters" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "rasters" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "raster" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "raster" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "rafter" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "rafter" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "rafters" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "rafters" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "in error for rafter, one of the beams which give slope and form to a roof (OED s.v. rafter n.^1) as raster is attested only in compounds raster cloth (barber’s towel) raster house (barber’s shop) (OED s.v. raster n.^1). Note that the Cologne translation describes this product as a beam or spar for a house (balken oder haussparren)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/rafter> ;
    la:equivalent aat:300002424 ;
    hector:attestationCount 3 ;
    hector:taxation <https://w3id.org/hector/commodity/rafter#rate-1558-inward-902> .

