  <rdf:Description rdf:nodeID="commodity_bracer_cb5c515be7e1669523fb88fb9cab7c2e1d11a33810cf5affaf36cc67a3d1e791d9">
    <crm:P190_has_symbolic_content>Protective coverings for the wrist used in archery, fencing, and various ball games, especially those worn by archers on the bow arm as protection from the recoil of the bowstring, generally taking the form of a band, bracelet, or plate. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
