<https://w3id.org/hector/commodity/cathedra> a crm:E55_Type ;
    rdfs:label "cathedra" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cathedrarum" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kaθedrarum" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cathedrae" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kaθedre" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cathedra" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "kaθedra" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Chairs or thrones of a bishop in his cathedral church, in which he presides at solemn functions. The form is based on the ancient Roman cathedra. Originally the bishop's cathedra stood in the center of the apse, flanked at a lower level on either side by the benches where the assisting priests sat. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
