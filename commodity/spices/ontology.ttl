<https://w3id.org/hector/commodity/spices> a crm:E55_Type ;
    rdfs:label "spices" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "spices" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "spisəs" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "speciesei" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "spesiːsei" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1398"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "species" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "spesiːs" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "specierum" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "spesiːrum" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "spices | spices (in general)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/spices> ;
    la:equivalent aat:300386730 ;
