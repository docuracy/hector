  <rdf:Description rdf:nodeID="commodity_potelle_cb13ee6cd8f0eea53da532c8cf5804a91fc1b83c6016ed50aab9154c398bed931a">
    <crm:P190_has_symbolic_content>a potel: a measure of capacity of two quarts (half a gallon); part of the pot / quart / pint series (see also pot (measure)). The vessel of this size is the potel pot.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
