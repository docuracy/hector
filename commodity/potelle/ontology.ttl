<https://w3id.org/hector/commodity/potelle> a crm:E55_Type ;
    rdfs:label "potelle" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "potelles" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "poteləs" ;
            hector:validFrom "1400"^^xsd:gYear ;
            hector:validThrough "1421"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "potelle" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "potelə" ;
            hector:validFrom "1400"^^xsd:gYear ;
            hector:validThrough "1421"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "potellis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "potelis" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a potel: a measure of capacity of two quarts (half a gallon); part of the pot / quart / pint series (see also pot (measure)). The vessel of this size is the potel pot." ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/potelle> ;
    skos:related <https://w3id.org/hector/commodity/pot-measure>,
        <https://w3id.org/hector/commodity/potel-pot> ;
