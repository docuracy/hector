  <rdf:Description rdf:nodeID="commodity_roe_skin_cb0">
    <crm:P190_has_symbolic_content>the skin of the roe, a small species of deer (capreolus capraea) inhabiting various parts of Europe and Asia (OED s.v. roe n.1, roan n.2 1) (see also pellis de roo)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
</rdf:RDF>
