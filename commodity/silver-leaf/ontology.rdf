  <rdf:Description rdf:nodeID="commodity_silver_leaf_cb32e721aa78e897149728624568662229b9bd4199b5154852077d3acddf0a533d">
    <crm:P190_has_symbolic_content>Silver beaten out into thin leaf for use in gilding. Silver leaf is about three times as thick as gold leaf because silver is less malleable but the resulting leaf is easier to handle. It requires lacquering or varnishing to prevent tarnishing; for this reason it is often replaced by palladium leaf. In the commerical arts inexpensive aluminum leaf is used to achieve the effect of silver leaf. Silver leaf can also be covered with a golden yellow transparent coating as a substitute for gold. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
