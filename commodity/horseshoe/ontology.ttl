<https://w3id.org/hector/commodity/horseshoe> a crm:E55_Type ;
    rdfs:label "horseshoe" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "horseshoe" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "horseʃe" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hors shewys" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "hors ʃeuis" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "hors shew" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "hors ʃeu" ;
            hector:validFrom "1519"^^xsd:gYear ;
            hector:validThrough "1520"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "U-shaped metal plates, plain or with calks, nailed to a horse's hoof to protect it from being injured by hard or rough surfaces. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/horseshoe> ;
