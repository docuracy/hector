                hector:AttestedVariant ;
            hector:phoneticKey "nut treː woːd" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "wood of a nut tree; especially the European hazel (Corylus avellana) (OED s.v. note n.(1), nut tree n.)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/nut-tree%20wood> ;
