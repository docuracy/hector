<https://w3id.org/hector/commodity/lutum> a crm:E55_Type ;
    rdfs:label "lutum" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "luti" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "luti" ;
            hector:validFrom "1505"^^xsd:gYear ;
            hector:validThrough "1506"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lutum" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "lutum" ;
            hector:validFrom "1505"^^xsd:gYear ;
            hector:validThrough "1506"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "tenacious clay or cement composed of various ingredients, and used to stop an orifice, to render air-tight a joint between two pipes, to coat a retort, etc., and to protect a graft. Also with a and pl. a particular kind of this substance. †lute of wisdom [= med.L. lutum sapientæ], a composition for hermetical sealing, variously described by alchemists (OED s.v. lute n.2 1) | earth or soil that is red in color, specifically (a) red ochre, ruddle (now rare); (b) a red soil occurring in tropical and subtropical regions, typically clayey and highly leached, and colored by iron (OED s.v. red adj. and n. 1e (e) (ii))" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300010439 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/lutum> ;
    hector:attestationCount 2 .

