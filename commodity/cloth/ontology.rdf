  <rdf:Description rdf:nodeID="commodity_cloth_cbd80220b96bb6f46ed46c1e63019c82eaf78d7f00ca46932beb8c9d336ca02bf5">
    <crm:P190_has_symbolic_content>Generally, textile that is woven, felted, knit, pounded, or otherwise made into a flat piece. For textile in the form of continuous strands made from filaments of fiber by reeling, spinning, twisting, or throwing, see "yarn." [Source: Getty AAT]</crm:P190_has_symbolic_content>
