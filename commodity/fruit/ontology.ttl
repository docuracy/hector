            hector:phoneticKey "fruktus" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Portions of a plant consisting of the seed and its envelope, especially the latter when it is of a juicy, pulpy nature. In its strict botanical sense, the fleshy or dry ripened ovary of a plant, enclosing the seed or seeds, such as apricots, bananas, and grapes, as well as bean pods, corn grains, tomatoes, cucumbers, and (in their shells) acorns and almonds, are all technically fruits. Popularly, however, the term is restricted to the ripened ovaries that are sweet and either succulent or pulpy. The cultivation and processing of fruits are major industries worldwide. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300254496 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/fruit> ;
    la:equivalent aat:300011868 ;
    hector:attestationCount 182 .

