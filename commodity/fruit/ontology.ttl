<https://w3id.org/hector/commodity/fruit> a crm:E55_Type ;
    rdfs:label "fruit" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "frute" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "frutə" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "fruit" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "fruit" ;
            hector:validFrom "1428"^^xsd:gYear ;
            hector:validThrough "1430"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "fructusus" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "fruktusus" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
