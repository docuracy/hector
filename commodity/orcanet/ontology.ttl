<https://w3id.org/hector/commodity/orcanet> a crm:E55_Type ;
    rdfs:label "orcanet" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "orkenet" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "orkenet" ;
            hector:validFrom "1438"^^xsd:gYear ;
            hector:validThrough "1439"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "orcanet" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "orkanet" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the plant Alkanna tinctoria or the (red) dye obtained from it (OED s.v. orcanet)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/orcanet> ;
    la:equivalent aat:300013583 ;
    hector:attestationCount 1 .

