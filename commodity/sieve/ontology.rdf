  <rdf:Description rdf:nodeID="commodity_sieve_cb10fc2de04ad341c1a7a761f3c3377fc5d41d54abc493a80bc6bebdc6725fff7b">
    <crm:P190_has_symbolic_content>Meshed or perforated devices or utensils through which dry loose material (as flour) is winnowed or refined, material containing liquid is strained, or soft solids (as hard-boiled eggs) are comminuted by forcing (as with a pestle). [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
