  <rdf:Description rdf:nodeID="commodity_rerebrace_cb0">
    <crm:P190_has_symbolic_content>rerebrace, armour for the upper arm from the shoulder to the elbow (originally a plate protecting the back of the arm only, hence the name) (OED s.v. rere-brace)</crm:P190_has_symbolic_content>
