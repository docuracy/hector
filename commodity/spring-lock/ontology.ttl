            hector:validThrough "1445"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A common form of lock in which a spring presses the bolt outwards, thus rendering it self-locking except when secured by a catch (OED s.v. spring-lock)" ;
