  <rdf:Description rdf:nodeID="commodity_incense_cb228db257179808c19fc3f2266d5ff16a773c1ce9a4cbf286524a08656147e2e">
    <crm:P190_has_symbolic_content>Grains or pieces of gum and sometimes spices that are burned to produce a fragrant odor. Incense is frequently used as an oblation, or in religious ritual. The term can also refer to the smoke produced by the burning of incense. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
