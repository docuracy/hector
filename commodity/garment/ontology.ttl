<https://w3id.org/hector/commodity/garment> a crm:E55_Type ;
    rdfs:label "garment" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "garmentes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "garmentəs" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "garment" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "garment" ] ;
    skos:broader aat:300266639 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/garment> ;
    hector:attestationCount 1 .

aat:300266639 a crm:E55_Type ;
    rdfs:label "clothing" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

<https://w3id.org/mlca/glossary/garment> a crm:E55_Type ;
