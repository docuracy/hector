  <rdf:Description rdf:nodeID="commodity_colefish_cbb8ea58a3b8bfa6ae7ce3ba3e84288a72722b79c46f4503358c6e837067712c93">
    <crm:P190_has_symbolic_content>a fish (Merlangus or Pollachius carbonarius, or Gadus virens), allied to the cod, so called from the dusky pigment which tinges its skin, and soils the fingers like moist coal. Found in the Northern Seas, and caught for food (OED s.v. coal-fish)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
