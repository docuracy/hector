    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Short coats for the upper body made in various forms and lengths, but usually no lower than the waist or upper hip; worn indoors or for light warmth and protection from the weather. [Source: Getty AAT] | a short and close-fitting upper garment of men and women; a jacket; especially coat of fence, a kind of sleeveless tunic or jacket, formerly worn by foot-soldiers and others, usually of leather quilted, and in later times often plated with iron (OED s.v. jack n.2 1a-1b)" ;
            crm:P2_has_type aat:300435416 ] ;
