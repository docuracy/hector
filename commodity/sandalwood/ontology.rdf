  <rdf:Description rdf:nodeID="commodity_sandalwood_cb1723f9b99865fd6ffe253ecd85716cecb848d28458fae014aa7a7cadbfcc9d255">
    <crm:P190_has_symbolic_content>sandalwood: a scented wood obtained from several species of Santalum, also an inodorous dye-wood, used as a dye, a spice and in medicine (OED s.v. sandal n.2, sandalwood n.; MED s.v. saundre). Includes white sandalwood (Santalum album), red sandalwood / rubywood (Pterocarpus santalinus), yellow sandalwood, and the trunk or stem (stock) of the sandalwood tree.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.getty.edu/aat/300343670">
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
    <rdfs:label>Santalum album (species)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.getty.edu/aat/300404880">
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
    <rdfs:label>medicines (material)</rdfs:label>
  </rdf:Description>
</rdf:RDF>
