  <rdf:Description rdf:nodeID="commodity_anchovy_cb0">
    <crm:P190_has_symbolic_content>anchovy: a small fish of the herring family, traded preserved — salted and packed in barrels. Attested once in the corpus, as 56 small barrels (parvis barellis anchoves) landed with chests of sugar.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
