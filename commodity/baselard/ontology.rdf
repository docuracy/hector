  <rdf:Description rdf:nodeID="commodity_baselard_cb3279cd5ba1bbd71e8c570986270305bc8fd918e5f18ee671dd5ee290ec19df3c">
    <crm:P190_has_symbolic_content>Daggers having a hilt shaped like a capital H on its side (becoming more like a capital I over time), usually worn at the girdle by civilians. The form originated in southern Germany or Switzerland in the late 13th century and remained in wide use throughout Europe until the late 15th century. Some types are as long as short swords. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
