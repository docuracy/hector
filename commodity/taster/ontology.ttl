            hector:validThrough "1427"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a small shallow cup of silver, often with an embossed or corrugated bottom which reflects the light through the liquor, for tasting wines (OED s.v. taster1 3)" ;
