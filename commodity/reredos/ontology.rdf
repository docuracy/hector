  <rdf:Description rdf:nodeID="commodity_reredos_cb0">
    <crm:P190_has_symbolic_content>An ornamental facing or screen of stone or wood covering the wall at the back of an altar, frequently of ornate design, with niches, statues, and other decorations; a hanging of velvet or silk for covering the wall at the back of an altar (OED s.v. reredos 1a, 2)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
