@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/border> a crm:E55_Type ;
    rdfs:label "border" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "borders" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "borders" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "border" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "border" ;
            hector:validFrom "1512"^^xsd:gYear ;
            hector:validThrough "1513"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Ornamental areas of distinct pattern, material, color, or shape around the edge or boundary of something.  With regard specifically to tapestries, refers to the areas around the central field outside the inner guard and within the guard that edges the outer sides of the tapestry. For the narrow surfaces showing the 'thickness' or smallest dimension of thin, flat objects, as distinguished from the broad surfaces, see \"edges (object components).\" [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/border> ;
    la:equivalent aat:300010252 ;
    hector:attestationCount 29 .

aat:300010252 a crm:E55_Type ;
    rdfs:label "borders (ornament areas)" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/border> a crm:E55_Type ;
    rdfs:label "border (London Customs Accounts glossary)" .

hector:AttestedVariant a crm:E55_Type ;
    rdfs:label "attested variant" .

