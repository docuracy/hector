  <rdf:Description rdf:nodeID="commodity_petra_cb99f0845ea00f04481c5a67a91ed5cb44d33050d6ab408522bb649cc6d842e691">
    <crm:P190_has_symbolic_content>building or masonry stone (Latin petra/petrum): worked stone for building, including rectangularly dressed (squared) stone, Caen stone, and stone supplied to masons or for making moulds and templates. The weight unit "stone" (14 lb.) is a distinct sense, recorded under stone.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
