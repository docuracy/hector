  <rdf:Description rdf:nodeID="commodity_shirt_of_mail_cbc3e5be921c1a803f844adecc478e53a36d5d3bdc72a426a8686ff2d1f7a34a60">
    <crm:P190_has_symbolic_content>Protective garments often used as armor, in the form of a shirt, covering the torso and made of mail, which is metal fabric consisting of iron or steel rings riveted or pressed together. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
