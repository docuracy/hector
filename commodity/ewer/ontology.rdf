  <rdf:Description rdf:nodeID="commodity_ewer_cbb99447697223170e3a14699f06df907c6fae6d2da892ccac901bb975cb1fba8f">
    <crm:P190_has_symbolic_content>Tall, wide-mouthed vessels, generally having a pouring lip, and that have a deep bowl on a stemmed base and a single vertical handle. The bowl is usually cylindrical, baluster-shaped, or helmet-shaped. [Source: Getty AAT]</crm:P190_has_symbolic_content>
