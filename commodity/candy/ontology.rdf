  <rdf:Description rdf:nodeID="commodity_candy_cba28adb937796fbdc11f9f41e40267dbda8efda1bfbac4fb5852ff5c3fd8c555c">
    <crm:P190_has_symbolic_content>Foodstuff made from sugar or other sweet, edible substance. Includes a wide variety of forms, from hard lozenges of crystallized sugar made by repeated boiling and slow evaporation, to soft filled sweets, such as chocolate-covered bonbons. [Source: Getty AAT]</crm:P190_has_symbolic_content>
