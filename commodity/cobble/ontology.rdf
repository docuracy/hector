  <rdf:Description rdf:nodeID="commodity_cobble_cb26cb9df27c70e4f9f780b8bf4bc4ce35fd8dc116004bdf5e6bc76c1ad1fe92ff">
    <crm:P190_has_symbolic_content>A rock fragment, rounded or otherwise abraded, with a diameter between 64 and 256 mm, being larger than a pebble and smaller than a boulder. The term can also refer more specifically to a rounded stone suitable for use in paving or other construction. [Source: Getty AAT]</crm:P190_has_symbolic_content>
