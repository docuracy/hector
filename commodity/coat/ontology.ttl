<https://w3id.org/hector/commodity/coat> a crm:E55_Type ;
    rdfs:label "coat" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "coat" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "koat" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cote" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kotə" ;
            hector:validFrom "1428"^^xsd:gYear ;
            hector:validThrough "1430"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Main garments usually fitted to the upper body, extending below the hip line, open at the front or side and generally having sleeves. Also, similar outer garments worn for warmth or protection from the weather. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/coat> ;
    la:equivalent aat:300046143 ;
    hector:attestationCount 117 .

