@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hector: <https://w3id.org/hector/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/diptica> a crm:E55_Type ;
    rdfs:label "diptica" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dipticaorum" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "diptikaorum" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "diptica" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "diptika" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dipticorum" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "diptikorum" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "writing tablet of two leaves (in dozens or pairs)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300178228,
        aat:300262572 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/diptica> ;
    hector:attestationCount 3 .

aat:300178228 a crm:E55_Type ;
    rdfs:label "diptychs" .

aat:300262572 a crm:E55_Type ;
    rdfs:label "writing tablets (information artifacts)" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/diptica> a crm:E55_Type ;
    rdfs:label "diptica (London Customs Accounts glossary)" .

hector:AttestedVariant a crm:E55_Type ;
    rdfs:label "attested variant" .

