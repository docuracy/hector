  <rdf:Description rdf:nodeID="commodity_calaber_cbfbe7b342d9866e3e33fa883532e14f37c8deb54ea86a9f0f4c20c31826b1b14">
    <crm:P190_has_symbolic_content>a kind of dark grey squirrel fur (Veale 217-8) | a kind of dark grey squirrel fur (Veale 217-8), here undressed | a kind of dark grey squirrel fur (Veale 217-8), here consisting of the belly parts of the animal | squirrel skins with a white belly and a grey or black back, less valuable than Baltic skins (Veale, 218) | a kind of dark grey squirrel fur (Veale 217-8), here taken in season, i.e. killed when the animal is normally hunted (Veale 25) | taken in the summer when the animal is not normally hunted, unseasonable, raw, of low value (Veale 25, 226) | a kind of dark grey squirrel fur (Veale 217-8), undressed</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
