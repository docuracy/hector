    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "flotes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "flotəs" ;
            hector:validFrom "1428"^^xsd:gYear ;
            hector:validThrough "1430"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "flotys" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "flotis" ;
            hector:validFrom "1439"^^xsd:gYear ;
            hector:validThrough "1440"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "flot" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "flot" ;
            hector:validFrom "1439"^^xsd:gYear ;
