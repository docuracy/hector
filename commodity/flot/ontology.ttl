            hector:phoneticKey "flotis" ;
            hector:validFrom "1439"^^xsd:gYear ;
            hector:validThrough "1440"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Devices made of buoyant materials, tied onto a line or net when fishing to gauge the depth of the fishhook or net. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
