  <rdf:Description rdf:nodeID="commodity_cord_2_cb3cf4f486cd4d178966c51814d812c19d001c198f997527ff62f46604c542df7a">
    <crm:P190_has_symbolic_content>Long, slender, flexible, roughly cylindrical construction of fibrous material, usually made of several strands twisted together. Cord is typically made from a type of bast fiber such as cotton, jute, flax, ramie, hemp, sisal, olona, gravata, agel, widuri, caraguata, or others. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.getty.edu/aat/300014247">
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
    <rdfs:label>cord (fiber product)</rdfs:label>
  </rdf:Description>
