            crm:P190_has_symbolic_content "dried fish" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "driːd fiʃ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dryfysshe" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "drifiʃə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dryfish" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "drifiʃ" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "dried fish: fish preserved by drying (not indexed by Jenks)" ;
            crm:P2_has_type aat:300435416 ] ;
