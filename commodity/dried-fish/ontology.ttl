<https://w3id.org/hector/commodity/dried-fish> a crm:E55_Type ;
    rdfs:label "dried fish" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dry fish" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dri fiʃ" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "dryfysh" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "drifiʃ" ],
