  <rdf:Description rdf:nodeID="commodity_kyppe_cb6fc43a7cfd44ea13fab0e66a669520f48aa70f29519ab0d27af0447da7205a80">
    <crm:P190_has_symbolic_content>a basket; specifically one holding approximately a bushel, used as a measure of fish (MED s.v. kipe n.; OED s.v. kipe; Zupko 213). Frequently confused orthographically with kip (a bundle of furs/hides) — see kip.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
