<https://w3id.org/hector/commodity/millene-gold> a crm:E55_Type ;
    rdfs:label "millene gold" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mylene gold" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "milenə gold" ;
            hector:validFrom "1506"^^xsd:gYear ;
            hector:validThrough "1507"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "millene gold" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "milenə gold" ;
            hector:validFrom "1506"^^xsd:gYear ;
            hector:validThrough "1507"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "gold thread, manufactured in Milan (MED s.v. Milan n.)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/millene%20gold> ;
    skos:related <https://w3id.org/hector/commodity/venice-gold> ;
    la:equivalent aat:300400561 ;
    hector:attestationCount 2 .

