  <rdf:Description rdf:nodeID="commodity_antimony_cb13ab63fa40cae03d77d768aca79ad5eb2e3b75a60f6ea1af9517388944405588e">
    <crm:P190_has_symbolic_content>Pure metallic element having symbol Sb and atomic number 51; a bright, hard, silvery to bluish white metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials, particularly alloys and pigments. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
