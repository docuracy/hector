  <rdf:Description rdf:nodeID="commodity_maidenhair_cbe2eac65757643a946d28c545293a303ec7849979daace1a97e481abb78f1220d">
    <crm:P190_has_symbolic_content>a plant, also called herba capillaris, maidenhair (Latham, Dictionary s.v. capillus, MED s.v. capillus veneris n.), a fern (often cultivated) with delicate, pale green, fan-shaped pinnules, which occurs in shady humid habitats in subtropical and warm temperate parts of the world and was formerly much used in medicine (OED s.v. s.v. maidenhair n.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
