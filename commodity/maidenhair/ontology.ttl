<https://w3id.org/hector/commodity/maidenhair> a crm:E55_Type ;
    rdfs:label "maidenhair" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "maidenhair" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "maidenhair" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "capillis veneris" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kapilis veneris" ;
            hector:validFrom "1550"^^xsd:gYear ;
            hector:validThrough "1553"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a plant, also called herba capillaris, maidenhair (Latham, Dictionary s.v. capillus, MED s.v. capillus veneris n.), a fern (often cultivated) with delicate, pale green, fan-shaped pinnules, which occurs in shady humid habitats in subtropical and warm temperate parts of the world and was formerly much used in medicine (OED s.v. s.v. maidenhair n.)" ;
            crm:P2_has_type aat:300435416 ] ;
