<https://w3id.org/hector/commodity/minikin> a crm:E55_Type ;
    rdfs:label "minikin" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mynykyns" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "minikins" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "minikins" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "minikins" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "myniken" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "miniken" ;
            hector:validFrom "1548"^^xsd:gYear ;
            hector:validThrough "1550"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mynikens" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "minikens" ;
            hector:validFrom "1548"^^xsd:gYear ;
            hector:validThrough "1550"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "minikin" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "minikin" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a thin string of gut used for the treble string of the lute or viol (OED s.v. minikin 2)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/minikin> ;
