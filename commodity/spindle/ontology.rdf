  <rdf:Description rdf:nodeID="commodity_spindle_cb9bec77fc2a2848e2225e97ef12feceb8b07cc120f174fc2fc6f09a2bd7f18881">
    <crm:P190_has_symbolic_content>a simple instrument employed in spinning by hand, consisting of a slender rounded rod (usually of wood), tapering towards each end, which is made to revolve and twist into thread the fibres drawn out from a bunch of wool, flax, or other material (OED s.v. spindle n. I 1a) | a simple instrument employed in spinning by hand, consisting of a slender rounded rod (usually of wood), tapering towards each end, which is made to revolve and twist into thread the fibres drawn out from a bunch of wool, flax, or other material (OED s.v. spindle n.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
