  <rdf:Description rdf:nodeID="commodity_bice_cb2be81044d628f1ae5d204068b3d6a57899d4c3c5e0bf1fe89d808d38491e5fac">
    <crm:P190_has_symbolic_content>Unstandardized term referring to several green pigments, including pigment created by adding yellow orpiment to smalt, pigment comprising synthetic copper carbonate, pigment comprising natural copper carbonate created by grinding the mineral malachite, green earth pigment, and viridian pigment. [Source: Getty AAT] | Unstandardiized pigment name for several materials, including the synthetic copper carbonate (blue verditer), pigment produced from grinding the copper carbonate mineral azurite, smalt pigment, and others. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
