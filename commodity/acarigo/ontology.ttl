            hector:validThrough "1439"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "agaric, name given to various corky species of Polyporus, a genus of fungi growing upon trees; of which P. officinalis, chiefly found on the Larch, the ‘Female Agarick’ of old writers, was renowned as a cathartic, and with P. fomentarius, and P. igniarius, ‘Male Agarick’ used as a styptic, as tinder, and in dyeing (Pegolotti 411, OED s.v. agaric n. and a.) [Jenks] | Mushroom-forming; parenthesomes imperforate or perforate (spore caps have openings); includes subclasses Agaricomycetidae and Phallomycetidae; contains 17 orders. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
