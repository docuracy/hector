  <rdf:Description rdf:nodeID="commodity_banker_cb37fa69eafea346a716449fa65a6edfecc4adfc1bb6eee457dbc8b6b5e40958ea">
    <crm:P190_has_symbolic_content>= banker, -s of verduce | cloth for making bankers | a covering, generally of tapestry, for a bench or a chair (OED s.v. banker1) | a covering, generally of tapestry, for a bench or a chair (OED s.v. banker^1), here of low quality | very rough material for making bankers, coverings, generally of tapestry, for a bench or a chair (OED s.v. banker1)) | a covering, generally of tapestry, for a bench or a chair (OED s.v. banker1), here of low quality | a covering, generally of tapestry, for a bench or a chair (OED s.v. banker1), here made of thread</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
