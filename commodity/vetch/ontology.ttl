            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "fetʃə" ;
            hector:validFrom "1412"^^xsd:gYear ;
            hector:validThrough "1427"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "fecches" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "fetʃəs" ;
            hector:validFrom "1412"^^xsd:gYear ;
            hector:validThrough "1427"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the bean-like fruit of various species of the leguminous plant Vicia (OED s.v. vetch)" ;
