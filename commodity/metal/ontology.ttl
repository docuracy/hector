<https://w3id.org/hector/commodity/metal> a crm:E55_Type ;
    rdfs:label "metal" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mettylle" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "metilə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mettyll" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "metil" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "metal" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "metal" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Any of a large group of substances that typically show a characteristic luster, are good conductors of electricity and heat, are opaque, can be fused, and are usually malleable or ductile. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/metal> ;
    la:equivalent aat:300010900 ;
    hector:attestationCount 2 .

