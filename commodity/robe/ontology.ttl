<https://w3id.org/hector/commodity/robe> a crm:E55_Type ;
    rdfs:label "robe" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "robes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "robəs" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "robe" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "robə" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Long, loose garments that tend to be of one piece and to open down the front. Examples include ordinary wear for men and women, dating from the Middle Ages forward in the West and common yet today in Asian and African countries; and similar garments often of elegant style worn for ceremonial or official occasions or as a symbol of office or profession. For women’s dresses, use \"gowns.\" For loose-fitting garments, often wraparound and worn to the bath or informally around the house use \"bathrobes.\" [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/robe> ;
    la:equivalent aat:300209852 ;
    hector:attestationCount 2 .

