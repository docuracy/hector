            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "wipə" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a whip furnished with latten balls or pieces (by analogy with MED s.v. whip(pe n. 1a whippe of led)) | meaning unknown" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300255555 ;
