  <rdf:Description rdf:nodeID="commodity_rapier_cb99b4d0206b9268380070e020addba9685dfef4ec004fa73f427ae8abb9ee7b71">
    <crm:P190_has_symbolic_content>Light swords with a long, narrow, double-edged blade and a hilt furnished with extensive protection for the hand, such as arms of the hilt and side rings, a shell guard, or a cup guard. Originally designed for both cutting and thrusting, they developed into purely thrusting swords and became the principal fencing weapons of the 16th and 17th centuries. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
