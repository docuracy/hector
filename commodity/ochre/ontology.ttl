    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a native earth or class of earths consisting of a mixture of hydrated oxide of iron with varying proportions of clay in a state of impalpable subdivision; colour varies from light yellow to deep orange or brown and is used as pigment (OED s.v. ochre, ocher n.). The Cologne translation of the Book of Rates describes this product as 'yellow earth for painting houses' (geel erd, damit man die heuser anstreicht)" ;
            crm:P2_has_type aat:300435416 ] ;
