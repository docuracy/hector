<https://w3id.org/hector/commodity/bill> a crm:E55_Type ;
    rdfs:label "bill" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bille" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "bilə" ;
            hector:validFrom "1438"^^xsd:gYear ;
            hector:validThrough "1439"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "billes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "biləs" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bill" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "bil" ;
            hector:validFrom "1480"^^xsd:gYear ;
            hector:validThrough "1481"^^xsd:gYear ] ;
    crm:P2_has_type aat:300386154 ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "this could be 1) a weapon of war, a kind of broadsword; 2) an obsolete military weapon used chiefly by infantry; 3) an implement used for pruning, cutting wood, lopping trees etc. having a long blade with a sharp hook at the end and a wooden handle in line with the blade (OED s.v. bill n.1), but none seems likely, since only one piece was imported" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/bill> ;
    hector:attestationCount 4 .

