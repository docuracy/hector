  <rdf:Description rdf:nodeID="commodity_aventaile_cba0dbacae4cfd66678960f1e6666a691301331dd04f1881a846c937d1abc4251e">
    <crm:P190_has_symbolic_content>Tippets of mail attached around the lower edge and face opening of helmets, commonly basnets, to protect the shoulders, neck, and part of the face; used in the 14th and 15th centuries. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
