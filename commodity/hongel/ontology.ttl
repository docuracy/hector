                hector:AttestedVariant ;
            hector:phoneticKey "hondʒel" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "probably a hanging for a hall or chamber (MED s.v. hongel n.)" ;
            crm:P2_has_type aat:300435416 ] ;
