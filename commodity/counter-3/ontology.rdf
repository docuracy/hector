  <rdf:Description rdf:nodeID="commodity_counter_3_cbaa8d3543ca6abc767ef97e3c4c27332e1a6e4af1aabed01d67283c5a859ba759">
    <crm:P190_has_symbolic_content>Tables on which monetary calculations were made using tokens or counters on a checkered background, similar in usage to an abacus. Often having a compartment beneath for money, tokens, and goods. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
