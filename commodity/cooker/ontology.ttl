@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/cooker> a crm:E55_Type ;
    rdfs:label "cooker" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cooker" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "koːker" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "coker" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "koker" ;
            hector:validFrom "1442"^^xsd:gYear ;
            hector:validThrough "1445"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "cokeres" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "kokerəs" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a vessel in which food is cooked (OED s.v. cooker)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/cooker> ;
    la:equivalent aat:300200422 ;
    hector:attestationCount 2 .

aat:300200422 a crm:E55_Type ;
    rdfs:label "<culinary devices for cooking and heating>" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/cooker> a crm:E55_Type ;
    rdfs:label "cooker (London Customs Accounts glossary)" .

hector:AttestedVariant a crm:E55_Type ;
    rdfs:label "attested variant" .

