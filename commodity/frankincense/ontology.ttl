    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Aromatic gum resin containing a volatile oil that was valued since ancient times in worship, as a medicine, and as an incense resin. It is obtained from the Boswellia sacra trees and others. It contains resins (mostly triterpenoids), gums, volatiles oils (pinene, dipentene), and bassorin. It is usually found in the form of hard yellow grains. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
