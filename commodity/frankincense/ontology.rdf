  <rdf:Description rdf:nodeID="commodity_frankincense_cb11df2d1cdf59f1e524161fc3c77ab12b4ada665b9eb558a431203be1ac5f8584e">
    <crm:P190_has_symbolic_content>Aromatic gum resin containing a volatile oil that was valued since ancient times in worship, as a medicine, and as an incense resin. It is obtained from the Boswellia sacra trees and others. It contains resins (mostly triterpenoids), gums, volatiles oils (pinene, dipentene), and bassorin. It is usually found in the form of hard yellow grains. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
