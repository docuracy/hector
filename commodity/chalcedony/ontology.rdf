  <rdf:Description rdf:nodeID="commodity_chalcedony_cb642f783927613fc51531da2671ed581215ed6ef1a9b400a9abcdd7069889ffdc">
    <crm:P190_has_symbolic_content>A translucent, quartz usually  with a waxy luster, having tiny microscopic crystals that are sometimes arranged in slender fibrous bands; occurring in various colors, usually red, blue, or green. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
