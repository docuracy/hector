  <rdf:Description rdf:nodeID="commodity_pecten_2_cb4b77053a8bbc50d2fd3a16708dcd70f614b6282d1d0b601324ea0dbee149aff5">
    <crm:P190_has_symbolic_content>Family of marine bivalves having a radially ribbed shell with undulating edges, and many tiny eyes and feelers on the edge of the mouth; they inhabit sandy sea beds, and can swim by rapidly clapping the shell halve together by means of a single large adductor muscle. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
