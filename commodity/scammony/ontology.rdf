  <rdf:Description rdf:nodeID="commodity_scammony_cb417748c51f7541c0a201700cb687ff5ae7795243900a4e242072ba8a7aa0687a">
    <crm:P190_has_symbolic_content>scammony, a gum-resin obtained from the tuberous roots of Convolvulus Scammonia, used in medicine as a strong purgative; also the dried tuberous root from which the drug is prepared (OED s.v. scammony; Heyd 648-9; Stieda, Venice 105-6)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
