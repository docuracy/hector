  <rdf:Description rdf:nodeID="commodity_pike_cb1509e87eac09278510dc74f4f7da92dba63aa3b2501488baab5b37fe553c8c3e5">
    <crm:P190_has_symbolic_content>pik</crm:P190_has_symbolic_content>
