            hector:validThrough "1421"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Sheets or panels of material, designed to catch the wind and convert its energy, as to propel a sailing vessel or drive a windmill. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/sail> ;
    skos:related <https://w3id.org/hector/commodity/bonnet-de-seille>,
