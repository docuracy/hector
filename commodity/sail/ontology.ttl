<https://w3id.org/hector/commodity/sail> a crm:E55_Type ;
    rdfs:label "sail" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "sail" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "sail" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "velum" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "velum" ;
            hector:validFrom "1428"^^xsd:gYear ;
            hector:validThrough "1430"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "sailles" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sailəs" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
