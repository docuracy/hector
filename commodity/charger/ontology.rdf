  <rdf:Description rdf:nodeID="commodity_charger_cbd63e3695a35ad5780d33b3281bbe70978693024ee17b106008f32fe7e474ff9e">
    <crm:P190_has_symbolic_content>Large dinner plates, typically decorative and measuring 10-13 inches in diameter, that are placed on a formal dining table prior to dinner participants being seated and before food is served. The service plate remains at the place setting, with the bowls and plates of the dinner service placed on top of it, until the main entré is served, or until dessert is served; service plate use and etiquette varies by location and time period. For ceramic or metal platters for serving the meat course, use "chargers (platters)." [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
