  <rdf:Description rdf:nodeID="commodity_latch_cbf8b851a71d93b63f41977a07004e23161430b4e16146aca811da5562ce1aa0c0">
    <crm:P190_has_symbolic_content>Holding devices that rely on some form of horizontal bar, such as a bolt, rod, or hook as the means of closure. Distinguished from "catches" which rely on a roller, magnet, or friction. [Source: Getty AAT]</crm:P190_has_symbolic_content>
