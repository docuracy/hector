  <rdf:Description rdf:nodeID="commodity_worsted_cb82c478152f524508912d44318bcf59f57ddbf912238d6c866b8068f2b2a7a59a">
    <crm:P190_has_symbolic_content>a woollen fabric 30 yards in length, originally made in a parish in Norfolk, north of Norwich (OEngl Wurdestede, later Wurthstede, Worthsted), made from well-twisted yarn spun of long-staple wool combed to lay the fibers parallel; single, half-double and double refer to the thickness of the cloth (OED s.v. worsted); also manufactured in St Omer (imported)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
</rdf:RDF>
