    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Club-shaped instruments of a hard material with a round end used for crushing, pounding, or grinding herbs, spices, drugs, pigments, or other materials in a mortar, which is a cup-shaped receptacle. [Source: Getty AAT]" ;
