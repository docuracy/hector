            hector:validThrough "1430"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Liespfund, a Baltic-Hanseatic unit of weight (6.846 kg or 15 lb.), equivalent to 1/20 of a schippond (Wolf 43), here as a measure of wax | . Liespfund, a Baltic-Hanseatic unit of weight, approximately 6.8 kg, one twentieth of a shipplb." ;
