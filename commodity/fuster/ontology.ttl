<https://w3id.org/hector/commodity/fuster> a crm:E55_Type ;
    rdfs:label "fuster" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "fuster" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "fuster" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "foystes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "foistəs" ;
            hector:validFrom "1490"^^xsd:gYear ;
            hector:validThrough "1492"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "foyst" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "foist" ;
            hector:validFrom "1490"^^xsd:gYear ;
            hector:validThrough "1492"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "saddle-tree (OED s.v. fuster)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/fuster> ;
