@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/troy> a crm:E55_Type ;
    rdfs:label "troy" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "troyes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "troies" ;
            hector:validFrom "1490"^^xsd:gYear ;
            hector:validThrough "1492"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "troy" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "troi" ;
            hector:validFrom "1490"^^xsd:gYear ;
            hector:validThrough "1492"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "meaning unknown (measured in dozens) | a set of weights calibrated to the pound troy, not the pound avoirdupois (OED s.v. weight n.1 22a)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/troy> ;
    la:equivalent aat:300197555 ;
    hector:attestationCount 9 .

aat:300197555 a crm:E55_Type ;
    rdfs:label "weights (scale components)" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/troy> a crm:E55_Type ;
    rdfs:label "troy (London Customs Accounts glossary)" .

hector:AttestedVariant a crm:E55_Type ;
    rdfs:label "attested variant" .

