<https://w3id.org/hector/commodity/itching-powder> a crm:E55_Type ;
    rdfs:label "itching powder" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "itching powder" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "itʃiŋ puːder" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ychyng powder" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "itʃiŋ puːder" ;
            hector:validFrom "1545"^^xsd:gYear ;
            hector:validThrough "1547"^^xsd:gYear ] ;
    skos:broader aat:300404880 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/itching%20powder> ;
    hector:attestationCount 1 .

