    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Candleholders with a single candle socket mounted on a support with a widened base or foot for balance; often the support is columnar in form. For candleholders with a single candle socket set on a flat saucer or traylike base, use \"chambersticks.\" [Source: Getty AAT] | Candleholders with two or more arms. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
