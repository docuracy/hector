  <rdf:Description rdf:nodeID="commodity_pot_cb8e39cf61cd16f7e2c724ee9f4434491361ce7e218cc9a33003998c7a975a6ed">
    <crm:P190_has_symbolic_content>pot, a vessel for holding liquids or food (OED s.v. pot n.1); made of earthenware, stoneware (incl. Málaga ware), tin, brass, bronze, latten/pewter, glass, crystal, leather, wickerwork, wood, silver or iron, covered or uncovered. Includes drinking pots and pots for apothecaries, goldsmiths, treacle, ink, etc. For the capacity-measure sense see pot (measure); for the pot-hanger see pot hanger.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
