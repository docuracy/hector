    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "pot, a vessel for holding liquids or food (OED s.v. pot n.1); made of earthenware, stoneware (incl. Málaga ware), tin, brass, bronze, latten/pewter, glass, crystal, leather, wickerwork, wood, silver or iron, covered or uncovered. Includes drinking pots and pots for apothecaries, goldsmiths, treacle, ink, etc. For the capacity-measure sense see pot (measure); for the pot-hanger see pot hanger." ;
            crm:P2_has_type aat:300435416 ] ;
