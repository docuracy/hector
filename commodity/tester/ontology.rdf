  </rdf:Description>
  <rdf:Description rdf:nodeID="commodity_tester_cb450d4b8b0baab3cae75a83dde3d1d40728fd1dc8bdfe0ea33ffaf2fdd9fbe1ef">
    <crm:P190_has_symbolic_content>Rooflike components supported above the bed by posts and covering the whole area of the bed. Use "flying testers" for rooflike components generally cantilevered from the headboard and extending over the whole area of the bed. Use "half-testers" for similar forms which only extend over the head half of the bed. Use "canopies (structural elements)" for rooflike components suspended over the head of the bed by means of a cord or chain attached to the ceiling. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
