    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "sack (Latin saccus): a sack used as a packing unit and measure. The standard sack of English wool weighed 364 lb.; also used as a measure of flax and other dry goods. See also sackette (a small sack), poke, pack, bale." ;
