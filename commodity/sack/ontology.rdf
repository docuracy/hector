  <rdf:Description rdf:nodeID="commodity_sack_cbd77f4d38057d0ebc5e840056541813313fa17d692a871befbc0cc41f2e6b5599">
    <crm:P190_has_symbolic_content>sack (Latin saccus): a sack used as a packing unit and measure. The standard sack of English wool weighed 364 lb.; also used as a measure of flax and other dry goods. See also sackette (a small sack), poke, pack, bale.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
