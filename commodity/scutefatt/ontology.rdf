  <rdf:Description rdf:nodeID="commodity_scutefatt_cb0">
    <crm:P190_has_symbolic_content>some kind of vat or bucket, perhaps used as a scoop (MED s.v. sket-fat n.); occurring both as a liquid measure of vinegar and as an article of commerce</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
