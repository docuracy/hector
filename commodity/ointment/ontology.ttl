<https://w3id.org/hector/commodity/ointment> a crm:E55_Type ;
    rdfs:label "ointment" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ointment" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "ointment" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "oyntement" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "ointement" ;
            hector:validFrom "1536"^^xsd:gYear ;
            hector:validThrough "1540"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "oyntementes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "ointementəs" ;
            hector:validFrom "1536"^^xsd:gYear ;
            hector:validThrough "1540"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "an unctuous preparation, of a soft consistence like that of butter, often mixed with some medicament, used chiefly for application to the skin, for medicinal purposes, or as a cosmetic (OED s.v. ointment 1)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/ointment> ;
    la:equivalent aat:300391379 ;
    hector:attestationCount 1 .

aat:300391379 a crm:E55_Type ;
    rdfs:label "ointment" .

aat:300404670 a crm:E55_Type ;
