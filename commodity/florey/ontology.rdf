  <rdf:Description rdf:nodeID="commodity_florey_cb1362a17867e2a327621677f935b5083c1c42462c2efaac280eea513e0df94cf89">
    <crm:P190_has_symbolic_content>A blue pigment consisting of the scum collected from the vat in dyeing with woad or indigo. [Source: OED s.v. florey; Jenks, Index of Subjects IV-9]</crm:P190_has_symbolic_content>
