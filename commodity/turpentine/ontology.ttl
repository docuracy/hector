    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A sticky, viscous yellow sap obtained from conifers. The crude turpentine contains about 65 percent rosin (solid residue) and 18 percent oil of turpentine (volatile portion). It is distilled to create the volatile oil of turpentine, usually shortened to \"turpentine (oil).\"  [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
