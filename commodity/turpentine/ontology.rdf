  <rdf:Description rdf:nodeID="commodity_turpentine_cb1e06b07cb45c989518d907fc0d8640431ba5d5e5086d1710496a066a1e388a6e0">
    <crm:P190_has_symbolic_content>A sticky, viscous yellow sap obtained from conifers. The crude turpentine contains about 65 percent rosin (solid residue) and 18 percent oil of turpentine (volatile portion). It is distilled to create the volatile oil of turpentine, usually shortened to "turpentine (oil)."  [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
