  <rdf:Description rdf:nodeID="commodity_woolfell_cbe8922d0929e35c7c836793088dd1d5aa5e2d772315e7bc53bc56c92c656ed010">
    <crm:P190_has_symbolic_content>a sheepskin with the wool still on it, exported with wool and taxed beside it (OED s.v. wool-fell). Distinct from basan, which is sheepskin tanned in bark.</crm:P190_has_symbolic_content>
