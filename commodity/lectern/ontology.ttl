<https://w3id.org/hector/commodity/lectern> a crm:E55_Type ;
    rdfs:label "lectern" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lectern" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "lektern" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "letterne" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "leternə" ;
            hector:validFrom "1493"^^xsd:gYear ;
            hector:validThrough "1495"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lettron" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "letron" ;
            hector:validFrom "1434"^^xsd:gYear ;
            hector:validThrough "1438"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Elevated stands with a sloping top and usually a ledge at the bottom of the slope designed to support a book or script in a convenient position for a reader standing before it. A lectern may be placed on a table or mounted on a pedestal. A lectern In a church is usually situated in the chancel, sometimes inside a rood screen or tribune. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/lectern> ;
    la:equivalent aat:300170801 ;
    hector:attestationCount 2 .

aat:300170801 a crm:E55_Type ;
    rdfs:label "lecterns" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/lectern> a crm:E55_Type ;
