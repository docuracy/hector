    <hector:phoneticKey>lektern</hector:phoneticKey>
  </rdf:Description>
  <rdf:Description rdf:nodeID="commodity_lectern_cb487fde0c5478ed4c6d8af126d5b4eed76f687fe759756d30d5cfbd8b1b799c5d">
    <crm:P190_has_symbolic_content>Elevated stands with a sloping top and usually a ledge at the bottom of the slope designed to support a book or script in a convenient position for a reader standing before it. A lectern may be placed on a table or mounted on a pedestal. A lectern In a church is usually situated in the chancel, sometimes inside a rood screen or tribune. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
