  <rdf:Description rdf:nodeID="commodity_crossbow_tiller_cb5dc2584282b32f52e3710ffee0712499ca8f26e4fb622b27132536c85b25e6f0">
    <crm:P190_has_symbolic_content>in a cross-bow: the wooden beam which is groved for the reception of the arrow, or drilled for the bolt (OED s.v. tiller n.2) | stock or shaft fixed to a long-bow to admit of its being used as a cross-bow, for greater convenience or precision of aim (OED s.v. tiller n.2 1 b)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
