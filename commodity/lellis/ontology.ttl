<https://w3id.org/hector/commodity/lellis> a crm:E55_Type ;
    rdfs:label "lellis" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "lellis" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "lelis" ;
            hector:validFrom "1553"^^xsd:gYear ;
            hector:validThrough "1555"^^xsd:gYear ] ;
    crm:P2_has_type aat:300386154 ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "clearly some kind of fur (since measured in timber), but exact meaning unknown" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300395532 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/lellis> ;
    hector:attestationCount 1 .

