  <rdf:Description rdf:nodeID="commodity_furthindell_cb0">
    <crm:P190_has_symbolic_content>measure of fish, salt eels (E356/22 m 44d: also part of a dolium of wine) | a quarter tun, here as a packing unit for dry goods of no particular size | a quarter tun, here as a measure of eels, sturgeon | a quarter tun, here as a packing unit for fish, eels | one fourth of a barrel, here as a measure of eels, fish</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
