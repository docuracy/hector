<https://w3id.org/hector/commodity/unguentum> a crm:E55_Type ;
    rdfs:label "unguentum" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "unguentum" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "uŋguentum" ;
            hector:validFrom "1438"^^xsd:gYear ;
            hector:validThrough "1439"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "unguenti" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "uŋguenti" ;
            hector:validFrom "1438"^^xsd:gYear ;
            hector:validThrough "1439"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "an ointment or salve (OED s.v. unguent n.) | a horse salve (Latham, Word-List s.v. unguentum)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/unguentum> ;
    la:equivalent aat:300391379 ;
    hector:attestationCount 3 .

