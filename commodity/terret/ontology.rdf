  <rdf:Description rdf:nodeID="commodity_terret_cb65c360b06cd62017d7a2176a3e06540e404fc69d7ab772c7415e5d041a633d94">
    <crm:P190_has_symbolic_content>Metal loops attached to a horse's bit, which guide the reins and prevent them from becoming tangled or snagged on the harness. [Source: Getty AAT] | terret, especially each of the two rings by which the leash is attached to the jesses of a hawk (OED s.v. terret b), i.e. to the strap of leather etc. fastened around each of the legs of a hawk (OED s.v. jess n.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
