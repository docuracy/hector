  <rdf:Description rdf:nodeID="commodity_grill_cb0">
    <crm:P190_has_symbolic_content>the name given to a young salmon on its first return to the river from the sea and retained during the same year (MED s.v. grills n.pl., OED s.v. grilse) | young salmon (MED s.v. grills n.pl.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
