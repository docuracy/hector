<https://w3id.org/hector/commodity/browne-earth> a crm:E55_Type ;
    rdfs:label "browne earth" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "browne earth" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "bruːnə ɛːrθ" ;
            hector:validFrom "1556"^^xsd:gYear ;
            hector:validThrough "1559"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "browne yerth" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "bruːnə jerθ" ;
            hector:validFrom "1545"^^xsd:gYear ;
            hector:validThrough "1547"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "‘Reddes are made .. of the red earth called Maiolica, otherwise browne of spaine’ (OED s.v. earth n. IV.17, quote of 1598); majolica is a red earth used as a pigment (OED s.v. majolica n. & adj. 1) | Pigment that is brown in color, does not contain carbon, and is ultimately not derived from vegetable or animal sources. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/browne%20earth> ;
    la:equivalent aat:300013333 ;
    hector:attestationCount 4 .

