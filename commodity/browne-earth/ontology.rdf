  <rdf:Description rdf:nodeID="commodity_browne_earth_cb0">
    <crm:P190_has_symbolic_content>‘Reddes are made .. of the red earth called Maiolica, otherwise browne of spaine’ (OED s.v. earth n. IV.17, quote of 1598); majolica is a red earth used as a pigment (OED s.v. majolica n. &amp; adj. 1) | Pigment that is brown in color, does not contain carbon, and is ultimately not derived from vegetable or animal sources. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
