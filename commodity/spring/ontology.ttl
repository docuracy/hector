            crm:P190_has_symbolic_content "spryng" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "spriŋ" ;
            hector:validFrom "1487"^^xsd:gYear ;
            hector:validThrough "1490"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "sprynges" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "sprindʒəs" ;
            hector:validFrom "1487"^^xsd:gYear ;
            hector:validThrough "1490"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "spring" ;
            crm:P2_has_type aat:300404670,
