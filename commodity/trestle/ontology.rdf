  <rdf:Description rdf:nodeID="commodity_trestle_cb12886a24fe52fafdce5b923f77628b07080dbb4576a9b35dd4d4cb067d98ef2e">
    <crm:P190_has_symbolic_content>trestle, a support for something, consisting of a beam with two legs, esp. a pair used to support a board to make a table; also: a three-legged stool (OED s.v. trestle n. 1); here sometimes for the use of children</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
