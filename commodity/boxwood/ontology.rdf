  <rdf:Description rdf:nodeID="commodity_boxwood_cb9cab3b31afc35c235be503eef93991e4b245f1d7f77ceee5e887bebf949eb86">
    <crm:P190_has_symbolic_content>Dense, pale yellow wood from trees of the genus Buxus. Although difficult to carve, the wood has excellent dimensional stability and is very wear resistant. The hard, fine-grain wood is often used for printing blocks, rulers, mallets, architects scales, slide rules, modeling tools, musical instruments, engravings, inlays, small decorative items, and game pieces. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
