  <rdf:Description rdf:nodeID="commodity_packthread_bottom_cb90f8556c3be4255090408437878b59aa86c2f45cbba066afd0a677b5ccecbddf">
    <crm:P190_has_symbolic_content>Any of various small, round, or cylindrical devices usually of bone, wood, or metal on which threads are wound for use in textile fabrication. [Source: Getty AAT] | stout thread or twine such as is used for sewing or tying up packs or bundles (OED s.v. packthread); bottom: a core on which to wind thread; (also) a skein or ball of thread or yarn (OED s.v. bottom n. and adj. 24)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
