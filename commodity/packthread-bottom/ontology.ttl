            hector:phoneticKey "paktred botom" ;
            hector:validFrom "1550"^^xsd:gYear ;
            hector:validThrough "1553"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Any of various small, round, or cylindrical devices usually of bone, wood, or metal on which threads are wound for use in textile fabrication. [Source: Getty AAT] | stout thread or twine such as is used for sewing or tying up packs or bundles (OED s.v. packthread); bottom: a core on which to wind thread; (also) a skein or ball of thread or yarn (OED s.v. bottom n. and adj. 24)" ;
            crm:P2_has_type aat:300435416 ] ;
