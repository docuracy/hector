<https://w3id.org/hector/commodity/massicot> a crm:E55_Type ;
    rdfs:label "massicot" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "massicot" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "masikot" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "mastycote" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "mastikotə" ;
            hector:validFrom "1461"^^xsd:gYear ;
            hector:validThrough "1465"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Heavy yellow powder composed of lead monoxide, both the native mineral as well as lead monoxide produced by heating lead carbonate to 300 C. It is used as a drier in oil, as a low-fire flux in making ceramics and glass, as a yellow pigment in paints and glazes, in thin layers to produce iridescent colors on brass and bronze, as a filler for rubber, and to produce artificial tortoiseshell and horn. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/massicot> ;
    la:equivalent aat:300266236 ;
    hector:attestationCount 1 .

