  <rdf:Description rdf:nodeID="commodity_massicot_cb5b52f2884aaf1f52e663a89b3001c5c15f8e3cd2a4ab28120e9d27ee5edb2a60">
    <crm:P190_has_symbolic_content>Heavy yellow powder composed of lead monoxide, both the native mineral as well as lead monoxide produced by heating lead carbonate to 300 C. It is used as a drier in oil, as a low-fire flux in making ceramics and glass, as a yellow pigment in paints and glazes, in thin layers to produce iridescent colors on brass and bronze, as a filler for rubber, and to produce artificial tortoiseshell and horn. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
