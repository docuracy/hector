  <rdf:Description rdf:nodeID="commodity_altare_cb16310662f0c260d360976bda8db0c3254bfbf981098fa8e24d300ce48e65c631d">
    <crm:P190_has_symbolic_content>altareis</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="https://w3id.org/hector/ontology#AttestedVariant"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_E41_Linguistic_Appellation"/>
