  <rdf:Description rdf:nodeID="commodity_sulphur_cb1de4bc382d6bf8a128d15faa488c9baf60963c95db0878024410f23c16b06b4c5">
    <crm:P190_has_symbolic_content>Orthorhombic mineral of the native element sulfur, having symbol S and atomic number 16.  It is found abundantly in volcanic regions, occurring as a brittle crystalline solid, widely distributed in combination with metals and other substances. It has been used as molten to create small objects and as a gap-filler, for bleaching wood pulp, straw, wool, silk, felt, and linen, for vulcanizing rubber, for making gunpowder, and in the manufacture of sulfa drugs, insecticides, plastic, enamels, and dyes. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
