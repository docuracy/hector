            hector:validThrough "1385"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Long shirts of mail protecting the arms, torso, and legs to mid-thigh, sometimes also covering the head. They were common in Europe from the 11th to the 14th century. [Source: Getty AAT]" ;
