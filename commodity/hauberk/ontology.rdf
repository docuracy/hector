  <rdf:Description rdf:nodeID="commodity_hauberk_cb17743bab8dee1c38d22e4e56c6aa214dc3453daea5c525a2bcf2f6a6345bd43b">
    <crm:P190_has_symbolic_content>Long shirts of mail protecting the arms, torso, and legs to mid-thigh, sometimes also covering the head. They were common in Europe from the 11th to the 14th century. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
