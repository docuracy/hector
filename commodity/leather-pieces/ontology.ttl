            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pesiarum sisarum" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "pieces or offcuts of (tanned) leather, especially small pieces cut from the bellies, necks or horns of cattle, used for clouting and repairs (OED s.v. clout v.); Latin pecia corii." ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/leather%20pieces> ;
