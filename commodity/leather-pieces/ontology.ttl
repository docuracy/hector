<https://w3id.org/hector/commodity/leather-pieces> a crm:E55_Type ;
    rdfs:label "leather pieces" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pecia" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pesia" ;
            hector:validFrom "1380"^^xsd:gYear ;
            hector:validThrough "1385"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "peciae" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "pesie" ;
            hector:validFrom "1380"^^xsd:gYear ;
            hector:validThrough "1385"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "pecia corii" ;
