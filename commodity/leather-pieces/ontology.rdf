  <rdf:Description rdf:nodeID="commodity_leather_pieces_cb0">
    <crm:P190_has_symbolic_content>pieces or offcuts of (tanned) leather, especially small pieces cut from the bellies, necks or horns of cattle, used for clouting and repairs (OED s.v. clout v.); Latin pecia corii.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
