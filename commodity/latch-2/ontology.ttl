    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the latch of a crossbow: most likely the mechanism that holds back the drawn bowstring and releases it to propel the bolt. ('Latch' was also one of two kinds of English crossbow, designed to shoot bolts — OED s.v. latch n.1 4, prodd n. — but here the product is clearly a part of a crossbow, not a type, so best understood as the iron release mechanism.)" ;
            crm:P2_has_type aat:300435416 ] ;
