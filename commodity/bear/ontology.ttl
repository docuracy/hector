<https://w3id.org/hector/commodity/bear> a crm:E55_Type ;
    rdfs:label "bear" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ber" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "ber" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ursus" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "ursus" ;
            hector:validFrom "1506"^^xsd:gYear ;
            hector:validThrough "1507"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ursi" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "ursi" ;
            hector:validFrom "1506"^^xsd:gYear ;
            hector:validThrough "1507"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "bear" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "bɛːr" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Family containing nine species in six genera, characterized as being large, short-tailed, having stocky legs, a long snout, shaggy hair, and plantigrade paws with five non-retractile claws. Bears are generally omnivorous, but some bears are entirely carnivorous (like the polar bear ) or vegetarian (like the panda). [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/bear> ;
    la:equivalent aat:300266516 ;
    hector:attestationCount 9 .

