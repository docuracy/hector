<https://w3id.org/hector/commodity/falx> a crm:E55_Type ;
    rdfs:label "falx" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "falsis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "falsis" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "falx" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "falks" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "falcis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "falsis" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "an agricultural tool with a curved blade, scythe, sicle, billhook etc. (Latham, Dictionary s.v. falx)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/falx> ;
    la:equivalent aat:300024371 ;
    hector:attestationCount 2 .

