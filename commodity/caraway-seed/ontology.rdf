  <rdf:Description rdf:nodeID="commodity_caraway_seed_cb0">
    <crm:P190_has_symbolic_content>the small fruits of the umbelliferous plant Carum Carui, commonly called ‘caraway-seeds’. Being aromatic and carminative, they are used in cakes, sweetmeats, etc., and yield a volatile oil (OED s.v. caraway)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
