    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "bed-hangings: curtains and other cloth hangings on or around a bed, used for decoration, privacy, and control of light and draughts (Getty AAT). Recorded in many materials (worsted, serge, tapestry, verdure, arras, buckram), single or double / lined, embroidered, with celures, testers and curtains, and by place of manufacture (Winchester, Norfolk, York, Ghent, Flanders, Oudenarde). Latin lectus (a 'bed', i.e. a bed with its hangings)." ;
            crm:P2_has_type aat:300435416 ] ;
