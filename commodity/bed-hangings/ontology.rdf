  <rdf:Description rdf:nodeID="commodity_bed_hangings_cb5873083c251f885b06fef340a415f8859d7b374ec0b729aa0fc95668fe6f8e60">
    <crm:P190_has_symbolic_content>bed-hangings: curtains and other cloth hangings on or around a bed, used for decoration, privacy, and control of light and draughts (Getty AAT). Recorded in many materials (worsted, serge, tapestry, verdure, arras, buckram), single or double / lined, embroidered, with celures, testers and curtains, and by place of manufacture (Winchester, Norfolk, York, Ghent, Flanders, Oudenarde). Latin lectus (a 'bed', i.e. a bed with its hangings).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
