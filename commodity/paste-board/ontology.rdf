  <rdf:Description rdf:nodeID="commodity_paste_board_cba3fbecd8e38f0d4ddb44c03dde6c77141ac5b89a66254ad303d02e08b1eb7cd0">
    <crm:P190_has_symbolic_content>a substitute for a thin wooden board made by pasting sheets of paper together; especially a board of a book so made (OED s.v. pasteboard n.) | a stiff but pliable material made by pasting three or more sheets of paper together and compressing and rolling them (OED s.v. pasteboard n. &amp; adj); a piece of board made by pasting together sheets of paper, especially for the covering of a book (ibid. II.3)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
