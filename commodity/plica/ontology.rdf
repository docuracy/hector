  <rdf:Description rdf:nodeID="commodity_plica_cb792d38d76a9c57ecd74860bfe7120b377de454b6de84ead4cf6225306c0696e">
    <crm:P190_has_symbolic_content>a fold, pleat in drapery; a recognized length or 'piece' of lawn or umple (perhaps originally the length into which it was folded) (OED s.v. plight n.2, 1, 3), here as a measure of silk cloth, umple, crimile, crimule serici, and crimille</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
