  <rdf:Description rdf:nodeID="commodity_spangle_cb0">
    <crm:P190_has_symbolic_content>spangle, a small round thin piece of glittering metal (usually latten/brass) with a central hole for threading, used to decorate textiles and other materials</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
