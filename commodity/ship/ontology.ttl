@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/hector/commodity/ship> a crm:E55_Type ;
    rdfs:label "ship" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ship" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "ʃip" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "navis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "navis" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "navisis" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "navisis" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Watercraft generally larger and more seaworthy than boats, usually propelled by sails or engines. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/ship> ;
    la:equivalent aat:300082981 ;
    hector:attestationCount 20 .

aat:300082981 a crm:E55_Type ;
    rdfs:label "ships" .

aat:300404670 a crm:E55_Type ;
    rdfs:label "preferred terms" .

aat:300435416 a crm:E55_Type ;
    rdfs:label "descriptive note" .

<https://w3id.org/mlca/glossary/ship> a crm:E55_Type ;
    rdfs:label "ship (London Customs Accounts glossary)" .

hector:AttestedVariant a crm:E55_Type ;
    rdfs:label "attested variant" .

