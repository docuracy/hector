  <rdf:Description rdf:nodeID="commodity_liere_cbf3189f90d8562d88177df85b47459b9483a09d762e535f65cac8b88c81ef7e5">
    <crm:P190_has_symbolic_content>liere (lioure): tape, or narrow strips of cloth, used for binding the edges of a fabric — for veils, sails, bed-hangings etc. (OED s.v. lear2, lyre2; MED s.v. lioure). The name is associated with Lire/Liere in Brabant.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
