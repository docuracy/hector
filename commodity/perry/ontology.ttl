<https://w3id.org/hector/commodity/perry> a crm:E55_Type ;
    rdfs:label "perry" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "perry" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "peri" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "perye" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "perie" ;
            hector:validFrom "1556"^^xsd:gYear ;
            hector:validThrough "1559"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "a drink resembling cider, made from the juice of pears (OED s.v. perye, variant of perry n.3)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300419451 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/perry> ;
    skos:related <https://w3id.org/hector/commodity/cider>,
        <https://w3id.org/hector/commodity/pear> ;
    hector:attestationCount 1 .

