  <rdf:Description rdf:nodeID="commodity_galosh_cb3106ded1e5fbe245ddeecd53f65691df1c5e85a80491cc84c4ae06a94eb22cd9">
    <crm:P190_has_symbolic_content>Overshoes of rubber or other waterproof fabric, especially those that extend above the ankle and that often have buckles or other fasteners. Use "rubbers" for overshoes without buckles or fasteners that are cut below the ankle. [Source: Getty AAT]</crm:P190_has_symbolic_content>
