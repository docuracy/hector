    <hector:validThrough rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1533</hector:validThrough>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.getty.edu/aat/300037010">
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
    <rdfs:label>halberds</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="commodity_halberd_cbb2afc901d94a14f27aac7d72d749f1dcb7a71e1e8c9e345899bd4ba914c160cf">
    <crm:P190_has_symbolic_content>Staff weapons widely used in warfare in the 15th and 16th centuries, having an axlike blade with a short fluke on the back and a spike at the top of the staff. After the late 16th century they increasingly came to be used solely as ceremonial weapons, in which capacity they survived well into the 19th century. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
</rdf:RDF>
