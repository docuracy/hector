<https://w3id.org/hector/commodity/aune> a crm:E55_Type ;
    rdfs:label "aune" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "aunes" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "aunəs" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "aune" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "aunə" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "probably rings, links, fetters for chain-mail (cf. AS aneus; ME anlett) (OED s.v. anlet)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:broader aat:300197059 ;
    skos:exactMatch <https://w3id.org/mlca/glossary/aune> ;
    hector:attestationCount 4 .

